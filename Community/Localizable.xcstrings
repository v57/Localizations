{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "shouldTranslate" : false
    },
    "%@ has no address for a new post: start one on its page, then Fill." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat keine Adresse für einen neuen Beitrag: Lege einen auf dessen Seite an und drücke dann Ausfüllen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ no tiene dirección para una publicación nueva: empieza una en su página y luego Rellenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ n’a pas d’adresse pour un nouveau post : commencez-en un sur sa page, puis Remplir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ non ha un indirizzo per un nuovo post: creane uno sulla sua pagina, poi Compila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ に新しい投稿先がありません：ページで作成してから「入力」してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에 새 글 주소가 없음: 페이지에서 새로 시작한 뒤 채우기를 누르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ não tem endereço para um novo post: comece um na página dele e depois toque em Preencher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "У %@ нет адреса для нового поста: начните его на его странице, затем нажмите «Заполнить»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 还没有新帖子的地址：先在它的页面上新建一篇，然后点填充。"
          }
        }
      }
    },
