    "Takes %@ out of the story and deletes the app’s copy. The file you added stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt %@ aus der Story und löscht die Kopie der App. Die hinzugefügte Datei bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saca %@ de la historia y elimina la copia de la app. El archivo que añadiste se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Retire %@ de la story et supprime la copie de l’app. Le fichier que vous avez ajouté est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rimuove %@ dalla storia ed elimina la copia dell'app. Il file aggiunto resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@をストーリーから取り除き、アプリのコピーを削除します。追加したファイルは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@을(를) 스토리에서 제거하고 앱의 복사본을 삭제합니다. 추가한 파일은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remove %@ da história e exclui a cópia do app. O arquivo que você adicionou permanece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Убирает %@ из истории и удаляет копию приложения. Добавленный вами файл остаётся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "将 %@ 从故事中移除并删除应用内的副本。你添加的文件会保留。"
          }
        }
      }
    },
