	<key> (and %lld more)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>(і яшчэ %lld)</string>
			<key>many</key>
			<string>(і яшчэ %lld)</string>
			<key>one</key>
			<string>(і яшчэ %lld)</string>
			<key>other</key>
