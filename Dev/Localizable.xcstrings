    "How App Store Connect and Google Play know the app; empty asks the Xcode scheme" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كيف يعرف App Store Connect وGoogle Play التطبيق؛ الفراغ يسأل مخطط Xcode"
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كيف يعرف App Store Connect وGoogle Play التطبيق؛ إذا فاضي يسأل مخطط Xcode"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "App Store Connect আৰু Google Play-এ এপটো কেনেকৈ চিনে; খালীয়ে Xcode স্কীমক সুধে"
          }
