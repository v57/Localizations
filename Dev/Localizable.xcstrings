        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই ক্যাটালগে এখনো নেই এমন ভাষা বাছাই করুন — তাদের কলাম এখানে দেখা যাবে এবং একটি রান সেগুলো পূরণ করবে। সংরক্ষণের জন্য যেখানে অনুবাদ আছে শুধু সেখানেই ক্যাটালগ ফাইল একটি ভাষা পায়"
