            "value" : "چاٻيون جيڪي توهان ٻين اوزارن لاءِ اڳ ئي استعمال ڪريو ٿا اهي ماحول يا Hermes مان امپورٽ ڪري سگهجن ٿيون."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ඔබ දැනටමත් අනෙකුත් මෙවලම් සඳහා භාවිතා කරන යතුරු පරිසරයෙන් හෝ Hermes වෙතින් ආනයනය කළ හැක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kľúče, ktoré už používate pre iné nástroje, možno importovať z prostredia alebo z Hermes."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ključe, ki jih že uporabljate za druga orodja, lahko uvozite iz okolja ali iz Hermesa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Çelësat që përdor tashmë për vegla të tjera mund të importohen nga mjedisi ose nga Hermes."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ključevi koje već koristite za druge alate mogu se uvesti iz okruženja ili iz Hermesa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nycklar du redan använder för andra verktyg kan importeras från miljön eller från Hermes."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funguo unazotumia tayari kwa zana zingine zinaweza kuingizwa kutoka mazingira au kutoka Hermes."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "பிற கருவிகளுக்கு நீங்கள் ஏற்கனவே பயன்படுத்தும் விசைகளை சூழலிலிருந்தோ Hermes இலிருந்தோ இறக்குமதி செய்யலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "మీరు ఇతర సాధనాల కోసం ఇప్పటికే ఉపయోగిస్తున్న కీలను ఎన్విరాన్‌మెంట్ నుండి లేదా Hermes నుండి దిగుమతి చేయవచ్చు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Калидҳое, ки шумо аллакай барои абзорҳои дигар истифода мебаред, метавонанд аз муҳит ё аз Hermes ворид карда шаванд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คีย์ที่คุณใช้กับเครื่องมืออื่นอยู่แล้วสามารถนำเข้าจาก environment หรือจาก Hermes"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beýleki gurallar üçin ulanýan açarlaryňyz daşky gurşawdan ýa-da Hermes-den import edilip bilner."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ko e ngaahi kī 'oku ke 'osi faka'aonga'i ki he ngaahi me'angaue kehe 'e lava ke 'omi mei he environment pe mei he Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diğer araçlar için zaten kullandığınız anahtarlar ortamdan veya Hermes'ten içe aktarılabilir."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "باشقا قوراللار ئۈچۈن ئىشلىتىۋاتقان ئاچقۇچلىرىڭىزنى مۇھىتتىن ياكى Hermes تىن ئەكىرگىلى بولىدۇ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ключі, які ви вже використовуєте для інших інструментів, можна імпортувати з оточення або з Hermes."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وہ کلیدیں جو آپ پہلے سے دیگر ٹولز کے لیے استعمال کرتے ہیں، ماحول یا Hermes سے درآمد کی جا سکتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các khóa bạn đã dùng cho công cụ khác có thể nhập từ môi trường hoặc từ Hermes."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你喺其他工具用緊嘅 keys 可以由環境或者由 Hermes 匯入。"
