        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verżjonijiet tal-magna ta’ slots li diġà ddeċidejt. Qatt ma jissostitwixxu l-valur tiegħek — learn jaqra d-differenza."
