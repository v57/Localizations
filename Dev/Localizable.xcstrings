        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "மொழிபெயர்ப்பாளர் பின்பற்றும் திட்ட சூழல் விதிகளைத் திருத்தவும் — ஒரு வரிக்கு ஒரு விதி, ஒரு வரியை நீக்குவது அதைத் திரும்பப் பெறும்"
