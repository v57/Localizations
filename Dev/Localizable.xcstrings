    "Not recreated on its own — review before removing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يُعاد إنشاؤه تلقائيًا — راجع قبل الإزالة."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ما يتعاد إنشاؤه من نفسه — راجع قبل الإزالة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "নিজে পুনৰ সৃষ্টি নহয় — আঁতৰোৱাৰ আগতে পৰ্যালোচনা কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öz-özünə yenidən yaradılmır — silməzdən əvvəl nəzərdən keçirin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не ствараецца аўтаматычна — праверце перад выдаленнем."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не се пресъздава само — прегледайте преди премахване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "নিজে থেকে পুনরায় তৈরি হয় না — সরানোর আগে পর্যালোচনা করুন।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "རང་བཞིན་བསྐྱར་བཟོ་མི་བྱེད། — བསུབ་སྔོན་ཞིབ་བཤེར་བྱོས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "गावनो रिक्रिएट जायानाय नङा — खोसारनाय सिगां रिभ्यु खालाम।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No es torna a crear tot sol: revisa-ho abans de suprimir-ho."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎥᏝ ᎤᏩᏒ ᎠᏤ ᎢᏳᎵᏍᏙᎢ — ᏓᏃᎸᎭ ᎢᎬᏱ ᎠᎩᏍᏙᏗ."
