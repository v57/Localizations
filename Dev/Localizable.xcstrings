        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dua perangkat mengubah teks yang sama. Kedua versi ada di dalamnya, di antara penanda konflik: pilih satu dan hapus penandanya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tvö tæki breyttu sama texta. Báðar útgáfur eru í honum, milli átakamerkja: veldu aðra og fjarlægðu merkin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Due dispositivi hanno modificato lo stesso testo. Entrambe le versioni sono al suo interno, tra marcatori di conflitto: scegline una e rimuovi i marcatori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "2台のデバイスが同じテキストを変更しました。両方のバージョンが競合マーカー間にあります: いずれかを選択してマーカーを削除してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ორმა მოწყობილობამ შეცვალა იგივე ტექსტი. ორივე ვერსია მასშია, კონფლიქტის მარკერებს შორის: აირჩიეთ ერთი და წაშალეთ მარკერები."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Екі құрылғы бір мәтінді өзгертті. Екі нұсқа да ішінде, қақтығыс маркерлері арасында: біреуін таңдап, маркерлерді алып тастаңыз."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ឧបករណ៍ពីរបានផ្លាស់ប្តូរអត្ថបទដូចគ្នា។ កំណែទាំងពីរនៅក្នុងវា រវាងសញ្ញា conflict៖ ជ្រើសរើសមួយ ហើយលុបសញ្ញាចេញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
