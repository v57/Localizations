    "Files in private/ that git tracks: the ignore rule can't hide them. Remove them with git rm --cached before pushing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الملفات في private/ التي يتعقبها git: لا يمكن لقاعدة التجاهل إخفاؤها. أزلها باستخدام git rm --cached قبل الدفع."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الملفات في private/ اللي git يتتبعها: قاعدة التجاهل ما تخفيها. احذفها بـ git rm --cached قبل الدفع."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "private/-ত থকা ফাইল যিবোৰ git-এ ট্ৰেক কৰে: উপেক্ষা নিয়মে সেইবোৰ লুকুৱাব নোৱাৰে। পুছ কৰাৰ আগতে git rm --cached দি আঁতৰাওক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "git-in izlədiyi private/ faylları: ignore qaydası onları gizlədə bilməz. Push-dan əvvəl git rm --cached ilə silin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Файлы ў private/, якія адсочвае git: правіла ігнаравання не можа іх схаваць. Выдаліце іх з дапамогай git rm --cached перад пушам."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Файлове в private/, които git следи: правилото за игнориране не може да ги скрие. Премахнете ги с git rm --cached преди изпращане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "private/-এ git ট্র্যাক করে এমন ফাইল: ignore নিয়ম সেগুলো লুকাতে পারে না। পুশ করার আগে git rm --cached দিয়ে সরান।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "private/ ནང git གིས་རྗེས་འཛིན་བྱེད་པའི་ཡིག་ཆ། ཁྱབ་མི་སྣང་སྒྲིག་གཞིས་སྦ་མི་ཐུབ། སྐྱེལ་བའི་སྔོན་དུ git rm --cached གིས་བསུབ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "private/ आव git आ ट्रेक खालामग्रा फाइलफोर: इग्नर नियमआ बेफोरखौ दोनख'नो हाया। पुश खालामनाय सिगां git rm --cached जों बेफोरखौ बोहगार।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fitxers de private/ que el git segueix: la regla d’omissió no els pot amagar. Suprimeix-los amb git rm --cached abans de pujar-los."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "private/ ᎪᏪᎵ git ᎠᎦᏔᎲ: ignore ᎥᏝ ᏱᏚᎪᏙᏗ. git rm --cached ᎠᏲᏍᏗ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ئەو فایلانەی private/ کە git تراکیان دەکات: یاسای ignore ناتوانێت بیانشارێتەوە. پێش push بە git rm --cached لایانببە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Soubory v private/, které git sleduje: pravidlo ignore je neskryje. Před push je odeberte pomocí git rm --cached."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ffeiliau yn private/ mae git yn eu tracio: ni all y rheol anwybyddu eu cuddio. Tynnwch nhw gyda git rm --cached cyn gwthio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Filer i private/, som git sporer: ignoreringsreglen kan ikke skjule dem. Fjern dem med git rm --cached før push."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dateien in private/, die Git trackt: Die Ignore-Regel kann sie nicht ausblenden. Entfernen Sie sie vor dem Pushen mit git rm --cached."
          }
        },
        "doi" : {
