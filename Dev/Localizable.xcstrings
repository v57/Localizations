        "sat" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᱛᱚᱨᱡᱚᱢᱟᱭᱤᱡᱽ ᱯᱟᱸᱡᱟᱭᱟᱜ ᱯᱨᱚᱡᱮᱠᱴ ᱥᱟᱱᱟᱢ ᱱᱤᱭᱚᱢ ᱠᱚ ᱥᱟᱯᱲᱟᱣ ᱢᱮ — ᱢᱤᱫ ᱞᱟᱭᱤᱱ ᱨᱮ ᱢᱤᱫ ᱱᱤᱭᱚᱢ, ᱟᱨ ᱢᱤᱫ ᱞᱟᱭᱤᱱ ᱢᱮᱴᱟᱣ ᱫᱚ ᱚᱱᱟᱭ ᱨᱩᱣᱟᱹᱲᱤᱡᱟ"
