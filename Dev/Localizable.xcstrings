        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae %@ yn y Sbwriel — gwagiwch ef i ryddhau'r lle. Mae'ch offer yn ailadeiladu'r hyn sydd ei angen arnynt ar eu rhediad nesaf."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ligger i papirkurven — tøm den for at frigive pladsen. Dine værktøjer gendanner det, de skal bruge, ved næste kørsel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ befindet sich im Papierkorb — leere ihn, um den Speicher freizugeben. Deine Tools erstellen beim nächsten Lauf neu, was sie brauchen."
