        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ કચરાપેટીમાં છે — જગ્યા મુક્ત કરવા તેને ખાલી કરો. તમારા ટૂલ્સ આગામી રનમાં જરૂરી તે ફરી બનાવશે."
