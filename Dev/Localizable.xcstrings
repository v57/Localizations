        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ रद्दी च ऐ — जगह खाली करने लेई उसी खाली करो। तोहाडे टूल अगले रन पर लोड़चदी चीज़ें दुबारा बना लैङन।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ އޮތީ ޓްރޭޝްގައި — ޖާގަ ހުސްކުރަން އެ ހުސްކުރޭ. ތިޔަ ޓޫލްތައް ޖެހޭ ރަނުގައި ބޭނުންވާ އެއްޗެހި އަލުން ހަދާނެ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το %@ είναι στον Κάδο — αδειάστε τον για να ελευθερώσετε χώρο. Τα εργαλεία σας θα ξαναδημιουργήσουν ό,τι χρειάζονται στην επόμενη εκτέλεση."
