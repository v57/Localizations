    },
    "Dev can keep which strings were reviewed, the notes, the width limits and the edit history, and bring them back when the folder is added again. The translations stay in the catalogs and the translation memory either way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمكن لـ Dev الاحتفاظ بالسلاسل التي تمت مراجعتها والملاحظات وحدود العرض وسجل التحرير، واستعادتها عند إضافة المجلد مجددًا. تبقى الترجمات في الفهارس وذاكرة الترجمة على أي حال."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dev يقدر يحتفظ بالسلاسل اللي راجعتها، والملاحظات، وحدود العرض، وسجل التعديلات، ويرجعها إذا أضفت المجلد مرة ثانية. الترجمات تبقى في الكتالوجات وذاكرة الترجمة في كل الأحوال."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dev-এ কোনবোৰ স্ট্ৰিং পৰ্যালোচনা কৰা হ’ল, টোকা, প্ৰস্থ সীমা আৰু সম্পাদনা ইতিহাস ৰাখিব পাৰে, আৰু ফোল্ডাৰটো পুনৰ যোগ কৰিলে ঘূৰাই আনিব পাৰে। অনুবাদবোৰ কেটালগ আৰু অনুবাদ মেমৰিত যিকোনো প্ৰকাৰে থাকে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dev hansı sətirlərin nəzərdən keçirildiyini, qeydləri, en limitlərini və redaktə tarixçəsini saxlaya və qovluq yenidən əlavə olunduqda geri qaytara bilər. Tərcümələr hər halda kataloqlarda və tərcümə yaddaşında qalır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dev можа захоўваць, якія радкі былі правераны, нататкі, абмежаванні шырыні і гісторыю правак, і вяртаць іх, калі папка будзе дададзена зноў. Пераклады ў любым выпадку застаюцца ў каталогах і памяці перакладаў."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dev може да запази кои низове са прегледани, бележките, ограниченията за ширина и историята на редакциите, и да ги върне, когато папката се добави отново. Преводите остават в каталозите и в паметта за преводи и в двата случая."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কোন স্ট্রিংগুলো পর্যালোচিত হয়েছে, নোট, প্রস্থের সীমা এবং সম্পাদনার ইতিহাস Dev রেখে দিতে পারে, এবং ফোল্ডারটি আবার যোগ করলে ফিরিয়ে আনতে পারে। অনুবাদগুলো যেভাবেই হোক ক্যাটালগ ও অনুবাদ মেমরিতে থাকে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dev གིས་ཞིབ་བཤེར་བྱས་པ་གང་དག། ཟིན་བྲིས། ཞེང་ཚད་དང་རྩོམ་སྒྲིག་ལོ་རྒྱུས་ཉར་ཐུབ། ཡིག་ཆ་སྒྲོམ་སླར་སྣོན་སྐབས་སླར་འབྱོར། སྒྱུར་རྣམས་དཀར་ཆག་དང་སྒྱུར་དྲན་ཐོར་གནས་ངེས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dev आ सायख'नाय रिभ्यु थासारि, नोटफोर, गुवारथि सिमाफोर आरो एडिट जारिमिनखौ दोनथ'नो हायो आरो फोल्डरखौ फिन थाफानायाव फिन लाबोनो हायो। भासान्थाइफोरा केटालग आरो ट्रान्सलेसन मेमरियावनो थायो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dev pot conservar quines cadenes s’han revisat, les notes, els límits d’amplada i l’historial d’edicions, i recuperar-los quan es torni a afegir la carpeta. Les traduccions es queden als catàlegs i a la memòria de traducció en qualsevol cas."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dev ᎠᏓᏃᎮᏍᏗ ᎾᏍᎩ ᏥᎪᏩᏛ ᎠᎴ ᎠᏓᏅᏖᏗ ᎾᏍᎩ ᎠᎴ ᏗᏣᏓᏟᎶᏍᏔᏅ ᎾᏍᎩ ᏕᎦᏔᎿᎭ, ᎠᎴ ᏓᏓᏓᏁᏟᏴᏍᏗ. ᏗᎦᎾᏟ ᏗᎪᏪᎵ ᎠᎴ ᎠᏓᏅᏖᏗ ᎤᎵᏍᏆᎸ ᎤᏩᏒ ᎢᎨᎢ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
