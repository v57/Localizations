        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La clau API puja captures i compila sense el compte iniciat a l’Xcode. Una clau per a cada projecte d’aquest Mac: Dev la copia a ~/.appstoreconnect/private_keys i en desa els ID a ~/.appstoreconnect/v57.env, mai a release.env."
          }
