        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Két eszköz módosította ugyanazt a szöveget. Mindkét verzió benne van, konfliktusjelölők között: válassz egyet, és távolítsd el a jelölőket."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Երկու սարքեր փոխել են նույն տեքստը։ Երկու տարբերակներն էլ դրա մեջ են՝ կոնֆլիկտի նշիչների միջև. ընտրեք մեկը և հեռացրեք նշիչները։"
