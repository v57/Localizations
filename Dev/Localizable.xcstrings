    "Copies of the same files. They become clones that share one copy's space and stay where they are, so nothing is removed and Smart Scan picks them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نسخ من نفس الملفات. تصبح نسخًا تشارك مساحة نسخة واحدة وتبقى في مكانها، فلا يُزال شيء ويلتقطها الفحص الذكي."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نسخ من نفس الملفات. تصير نسخًا تشارك مساحة نسخة واحدة وتبقى مكانها، فلا يُحذف شي ويلتقطها الفحص الذكي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "একেই ফাইলৰ প্ৰতিলিপি। সেইবোৰ ক্ল’ন হয় যিয়ে এটা প্ৰতিলিপিৰ ঠাই ভাগ কৰে আৰু য’ত আছে ত’তে থাকে, সেয়ে একো আঁতৰোৱা নহয় আৰু Smart Scan এ সেইবোৰ বাছে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eyni faylların nüsxələri. Onlar bir nüsxənin yerini paylaşan klonlara çevrilir və yerində qalır, ona görə heç nə silinmir və Smart Scan onları seçir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Копіі тых жа файлаў. Яны становяцца клонамі, якія падзяляюць месца адной копіі і застаюцца на месцы, таму нічога не выдаляецца, а Smart Scan іх выбірае."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Копия на същите файлове. Те стават клонинги, които споделят мястото на едно копие и остават където са, така че нищо не се премахва и Smart Scan ги избира."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "একই ফাইলের অনুলিপি। এগুলো ক্লোন হয় যা একটি অনুলিপির জায়গা ভাগ করে এবং যেখানে আছে সেখানে থাকে, তাই কিছু সরানো হয় না এবং Smart Scan এগুলো বাছাই করে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཡིག་ཆ་མཚུངས་པའི་འདྲ་བཤུས། དེ་དག་ས་ཆ་གཅིག་མཉམ་སྤྱོད་པའི clone རེ་ཆགས་ནས་གནས་སར་གནས། དེས་ཅི་ཡང་མི་བསུབ། Smart Scan གིས་བདམས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एखे फाइलफोरनि कʼपिफोर। बेफोरा मोनसे कʼपिनि जायगाखौ राननाय क्लोन जायो आरो थानाय जायगायावनो थायो, बेखायनो जेबो रिमʼभ जायै आरो Smart Scan आ बेफोरखौ सायखो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Còpies dels mateixos fitxers. Es converteixen en clons que comparteixen l’espai d’una còpia i es queden on són, de manera que no se suprimeix res i l’anàlisi intel·ligent els tria."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎾᏍᎩ ᏗᎪᏪᎶᏗ ᎪᏪᏔ. clones ᎢᎨᏎ ᏌᏉ ᎦᏚ ᏕᏫᎷᏤ ᎠᎴ ᎯᎠ ᎠᏁᎲ, ᎥᏝ ᎪᎱᏍᏗ ᎠᏍᏆᏂᎪᏔᏅ ᎠᎴ Smart Scan ᏚᏂᏔᏅ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کۆپییەکانی هەمان فایلەکان. دەبنە کلۆن کە شوێنی یەک کۆپی هاوبەش دەکەن و لە شوێنی خۆیان دەمێننەوە، بۆیە هیچ شتێک لانابرێت و Smart Scan هەڵیان دەبژێرێت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopie stejných souborů. Stanou se z nich klony, které sdílejí místo jedné kopie a zůstanou tam, kde jsou, takže se nic neodstraní a Smart Scan je vybere."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copïau o'r un ffeiliau. Maen nhw'n dod yn glonau sy'n rhannu lle un copi ac yn aros lle maen nhw, felly ni chaiff dim ei dynnu ac mae Smart Scan yn eu dewis."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopier af de samme filer. De bliver til kloner, der deler én kopis plads og bliver, hvor de er, så intet fjernes, og Smart Scan vælger dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopien derselben Dateien. Sie werden zu Klonen, die sich den Speicher einer Kopie teilen und bleiben, wo sie sind, sodass nichts entfernt wird und Smart Scan sie erkennt."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "उनें गै फाइलां दियां प्रतियां। ओह क्लोन बनी जंदे न जेड़े इक प्रति दी जगह सांझी करदे न ते जित्थे न उत्थें गै रौंहदे न, इसलेई किश नेईं हटदा ते Smart Scan उन्हें चुनदा ऐ।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "އެއް ފައިލްތަކުގެ ކޮޕީތައް. އެއީ އެއް ކޮޕީއެއްގެ ޖާގަ ހިއްސާކުރާ ކްލޯންތަކަށް ވެ އޮތް ތަނުގައި ތިބޭ، އެހެންވެ އެއްޗެއް އުނިނުވެ Smart Scan އެ ހޮވާ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αντίγραφα των ίδιων αρχείων. Γίνονται κλώνοι που μοιράζονται τον χώρο ενός αντιγράφου και μένουν εκεί που είναι, οπότε τίποτα δεν αφαιρείται και τα επιλέγει το Smart Scan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copias de los mismos archivos. Se convierten en clones que comparten el espacio de una copia y permanecen donde están, por lo que no se elimina nada y Smart Scan los selecciona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Samade failide koopiad. Neist saavad kloonid, mis jagavad ühe koopia ruumi ja jäävad paigale, seega midagi ei eemaldata ja Smart Scan valib need."
          }
        },
