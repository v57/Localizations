    "Replaces the screenshots of the app's version in Prepare for Submission, one display type per size, for %lld languages." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستبدل لقطات شاشة إصدار التطبيق في «التحضير للإرسال»، نوع عرض واحد لكل مقاس، لـ %lld من اللغات."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستبدل لقطات نسخة التطبيق في التجهيز للتقديم، نوع عرض واحد لكل مقاس، لـ %lld لغة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld টা ভাষাৰ বাবে, প্ৰতি আকাৰত এটা প্ৰদৰ্শন ধৰণ, জমাৰ বাবে প্ৰস্তুতিত এপ সংস্কৰণৰ স্ক্ৰীণশ্বট সলনি কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Təqdimata Hazırlıqda tətbiq versiyasının ekran görüntülərini əvəz edir, hər ölçü üçün bir ekran tipi, %lld dil üçün."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Заменяе здымкі экрана версіі дадатка ў «Падрыхтоўцы да адпраўкі», па адным тыпе дысплея на памер, для %lld моў."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Заменя екранните снимки на версията на приложението в Prepare for Submission, по един тип дисплей на размер, за %lld езика."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lldটি ভাষার জন্য, প্রতি আকারে এক ডিসপ্লে টাইপ করে, Prepare for Submission-এ অ্যাপের সংস্করণের স্ক্রিনশট প্রতিস্থাপন করে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prepare for Submission ནང App ཐོན་རིམ་གྱི་པར་ཚབ། ཆེ་ཆུང་རེར་བསྟན་རིགས་གཅིག སྐད་རིགས %lld ཆེད།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prepare for Submission आव एप भर्सननि स्क्रिनसटफोरखौ सोलायो, साइजफ्रोमबो मोनसे डिस्प्ले रोखोम, %lld रावफोरनि थाखाय।"
          }
        },
        "ca" : {
          "stringUnit" : {
