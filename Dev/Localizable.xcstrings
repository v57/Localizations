        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "तपाईंले पहिले नै टुंग्याउनुभएका स्लटहरूका मेसिन संस्करणहरू। तिनीहरूले तपाईंको मान कहिल्यै प्रतिस्थापन गर्दैनन् — learn ले भिन्नता पढ्छ।"
