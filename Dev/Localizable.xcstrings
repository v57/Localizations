    "Keys you already use for other tools can be imported from the environment or from Hermes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المفاتيح التي تستخدمها مسبقًا لأدوات أخرى يمكن استيرادها من البيئة أو من Hermes."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المفاتيح اللي تستخدمها لأدوات ثانية تقدر تستوردها من البيئة أو من Hermes."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অন্য সঁজুলিৰ বাবে ইতিমধ্যে ব্যৱহাৰ কৰা কীবোৰ পৰিৱেশ বা Hermes-ৰ পৰা আমদানি কৰিব পাৰি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Digər alətlər üçün artıq istifadə etdiyiniz açarlar mühitdən və ya Hermes-dən idxal oluna bilər."
          }
        },
        "be" : {
