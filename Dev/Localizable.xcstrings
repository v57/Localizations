        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld इस कैटलॉग च · %lld जोड़ने लेई। हर भाषा जेड़ी Apple कीबोर्ड या UI भाषा दे रूप च दिंदा ऐ। चुनेआं गेआं गी हुनें इक कॉलम मिलदा ऐ ते रन लेई तैयार न; कैटलॉग फाइल च भाषा तदें गै जुड़दी ऐ जदूं बचाने लेई कोई अनुवाद होए।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld މި ކެޓަލޮގުގައި · %lld އިތުރުކުރަން. Apple ކީބޯޑް ނުވަތަ UI ބަހެއްގޮތުގައި ފޮނުވާ ކޮންމެ ބަހެއް. ހޮވާފައިވާ ބަސްތަކަށް މިހާރު ކޮލަމެއް ލިބި ރަނަކަށް ތައްޔާރު; ކެޓަލޮގް ފައިލަށް ބަހެއް އިތުރުވަނީ ސޭވްކުރަން ޓްރާންސްލޭޝަނެއް އޮތިއްޔާ."
