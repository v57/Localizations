    "Two devices changed the same text. Both versions are in it, between conflict markers: pick one and remove the markers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "غيّر جهازان النص نفسه. كلا النسختين موجودتان فيه، بين علامات التعارض: اختر واحدة وأزل العلامات."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جهازين غيّروا نفس النص. النسختين فيه، بين علامات التعارض: اختر وحدة وامسح العلامات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "দুটা ডিভাইচে একে পাঠ সলনি কৰিলে। দুয়োটা সংস্কৰণ ইয়াত সংঘাত চিহ্নৰ মাজত আছে: এটা বাছক আৰু চিহ্নবোৰ আঁতৰাওক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İki cihaz eyni mətni dəyişib. Hər iki versiya konflikt markerləri arasında ondadır: birini seçin və markerləri silin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дзве прылады змянілі адзін тэкст. Абедзве версіі ў ім, паміж маркерамі канфлікту: выберыце адну і выдаліце маркеры."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Две устройства са променили един и същи текст. И двете версии са в него, между маркери за конфликт: изберете една и премахнете маркерите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "দুটি ডিভাইস একই টেক্সট বদলেছে। উভয় সংস্করণ এতে আছে, কনফ্লিক্ট মার্কারের মধ্যে: একটি বেছে নিন এবং মার্কারগুলো সরান।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "སྒྲིག་ཆས་གཉིས་ཀྱིས་ཡི་གེ་གཅིག་པ་བསྒྱུར་བཅོས་བྱས་སོང་། ཐོན་རིམ་གཉིས་ཀ་འགལ་བའི་རྟགས་བར་དུ་དེའི་ནང་ཡོད། གཅིག་འདེམས་རོགས་དང་རྟགས་རྣམས་བསུབ་རོགས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मोननै डिभाइसआ एखे लिरथाइखौनो सोलायदों। मोननै भार्सनआनो बेयाव दं, conflict मार्कारफोरनि गेजेराव: मोनसेखौ सायख आरो मार्कारफोरखौ बोखार।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dos dispositius han canviat el mateix text. Totes dues versions hi són, entre marques de conflicte: tria'n una i elimina les marques."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᏔᎵ ᏗᏓᎴᎲᏍᎩ ᎾᏤᎵ ᎾᏍᎩ ᎪᏪᎵ. ᏔᎵ ᏧᏓᎴᎿ ᎾᎿᎭ conflict ᏗᎦᏔᏔᏅ: ᏌᏊ ᏣᏟᏍᏙᎦ ᎠᎴ ᏗᎦᏔᏔᏅ ᏣᎢᏍᏔ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دوو ئامێر هەمان دەقیان گۆڕی. هەردوو وەشانەکە تێیدان، لە نێوان نیشانەکانی ناکۆکی: یەکێکیان هەڵبژێرە و نیشانەکان لاببە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dvě zařízení změnila stejný text. Obě verze jsou v něm, mezi značkami konfliktu: vyberte jednu a značky odeberte."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Newidiodd dau ddyfais yr un testun. Mae'r ddwy fersiwn ynddo, rhwng marcwyr gwrthdaro: dewiswch un a thynnwch y marcwyr."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To enheder ændrede samme tekst. Begge versioner står i den, mellem konfliktmarkører: vælg én og fjern markørerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zwei Geräte haben denselben Text geändert. Beide Versionen stehen darin, zwischen Konfliktmarkern: eine auswählen und die Marker entfernen."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दो डिवाइसें ने ओही पाठ बदलेAa। दोनें संस्करण इस च न, विवाद-चिह्नें दे बश्कार: इक चुनो अते चिह्न हटाओ।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ދެ ޑިވައިސް އެއް ޓެކްސްޓް ބަދަލުކޮށްފި. ދެ ވަރޝަންވެސް އޭގައި އެބައޮތް، ކޮންފްލިކްޓް މާކަރުތަކުގެ މެދުގައި: އެއް ޚިޔާރުކޮށް މާކަރުތައް ނައްތާލޭ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δύο συσκευές άλλαξαν το ίδιο κείμενο. Και οι δύο εκδόσεις είναι μέσα, ανάμεσα σε δείκτες σύγκρουσης: διαλέξτε μία και αφαιρέστε τους δείκτες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dos dispositivos cambiaron el mismo texto. Ambas versiones están dentro, entre marcas de conflicto: elige una y elimina las marcas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaks seadet muutsid sama teksti. Mõlemad versioonid on selles konflikti markerite vahel: vali üks ja eemalda markerid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دو دستگاه متن یکسانی را تغییر دادند. هر دو نسخه بین نشانگرهای تعارض در آن است: یکی را انتخاب و نشانگرها را حذف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaksi laitetta muutti samaa tekstiä. Molemmat versiot ovat siinä konfliktimerkkien välissä: valitse toinen ja poista merkit."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Binago ng dalawang device ang parehong text. Nasa loob ang parehong bersyon, sa pagitan ng mga conflict marker: pumili ng isa at alisin ang mga marker."
