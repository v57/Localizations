            "value" : "ان جو فولڊر ۽ ان ۾ هر فائل (%@) ٽرَيش ۾ وڃي ٿي، ۽ رن تاريخ مان نڪري وڃي ٿو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "එහි ෆෝල්ඩරය සහ එහි ඇති සෑම ගොනුවක්ම (%@) කුණු කූඩයට යන අතර, ධාවනය ඉතිහාසයෙන් ඉවත් වේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeho priečinok a každý súbor v ňom (%@) idú do Koša a beh opustí históriu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Njegova mapa in vsaka datoteka v njej (%@) gre v Koš, zagon pa zapusti zgodovino."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dosja e tij dhe çdo skedar në të (%@) shkojnë në Kosh, dhe ekzekutimi del nga historia."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Njegova fascikla i svaki fajl u njoj (%@) idu u korpu, a pokretanje napušta istoriju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dess mapp och varje fil i den (%@) flyttas till papperskorgen, och körningen lämnar historiken."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folda yake na kila faili ndani yake (%@) huenda Kijalalani, na uendeshaji huondoka kwenye historia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "அதன் கோப்புறை மற்றும் அதிலுள்ள ஒவ்வொரு கோப்பும் (%@) குப்பைக்குச் செல்லும், மேலும் இயக்கம் வரலாற்றிலிருந்து விலகும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "దాని ఫోల్డర్ మరియు అందులోని ప్రతి ఫైల్ (%@) ట్రాష్‌కు వెళ్తాయి, రన్ చరిత్ర నుండి వెళ్లిపోతుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ҷузвдони он ва ҳар файл дар он (%@) ба Сабад меравад ва иҷро аз таърих мебарояд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
