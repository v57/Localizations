        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "First-Party-DeepSeek in voller Präzision. Preise verdoppeln sich zu Spitzenzeiten; der Dienst läuft in China."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "फर्स्ट-पार्टी, फुल-प्रिसीजन DeepSeek। पीक घंटें च कीमतें दुगनियां; सेवा चीन च चलदी ऐ।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ފަސްޓް-ޕާޓީ، ފުލް-ޕްރެސިޝަން DeepSeek. ޕީކް ގަޑީގައި އަގު ދެގުނަވޭ; ސާވިސް ހިނގަނީ ޗައިނާގައި."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "DeepSeek πρώτου κατασκευαστή, πλήρους ακρίβειας. Οι τιμές διπλασιάζονται τις ώρες αιχμής· η υπηρεσία εκτελείται στην Κίνα."
