        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अनुवादकले पालना गर्ने प्रोजेक्ट सन्दर्भ नियमहरू सम्पादन गर्नुहोस् — प्रति लाइन एउटा नियम, र लाइन मेटाउँदा त्यो फिर्ता हुन्छ"
