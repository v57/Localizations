            "value" : "%lld อักขระ หนึ่งกฎต่อหนึ่งบรรทัด ส่งพร้อมทุกคำขอแปลของโปรเจกต์นี้ และใช้เหนือค่าตั้งต้นของโมเดล (กฎพรอมต์ 4)"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld simwol. Her setirde bir düzgün. Bu taslama üçin her terjime soragy bilen iberilýär we modeliň öz öňdebelgilerinden ileri tutulýar (sorag düzgüni 4)."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld mata'itohi. Tulafono 'e taha ki he laine. 'Oku 'ave mo e kole liliu kotoa ki he poloseki ko 'eni, pea muimui ki ai 'o lahi ange 'i he ngaahi default 'a e model (tulafono prompt 4)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld karakter. Satır başına bir kural. Bu proje için her çeviri isteğiyle gönderilir ve modelin kendi varsayılanlarına göre önceliklidir (istem kuralı 4)."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld ھەرپ. ھەر قۇردا بىر قائىدە. بۇ تۈرنىڭ ھەر قېتىملىق تەرجىمە سورىمى بىلەن ئەۋەتىلىدۇ ھەم مودېلنىڭ ئۆز سۈكۈت قىممەتلىرىدىن ئۈستۈن تۇرىدۇ (prompt قائىدە 4)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld символів. Одне правило на рядок. Надсилається з кожним запитом на переклад для цього проєкту та має перевагу над власними налаштуваннями моделі (правило промпту 4)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld حروف۔ ایک سطر میں ایک اصول۔ اس پروجیکٹ کی ہر ترجمہ درخواست کے ساتھ بھیجا جاتا ہے، اور ماڈل کے اپنے ڈیفالٹس پر فوقیت رکھتا ہے (پرامپٹ اصول 4)۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld ký tự. Mỗi dòng một quy tắc. Được gửi kèm mọi yêu cầu dịch cho dự án này, và được ưu tiên hơn mặc định của mô hình (quy tắc prompt 4)."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld 個字。每行一條規則。會同呢個專案嘅每次翻譯請求一齊傳送，並優先過模型本身嘅預設（提示規則 4）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld 个字符。每行一条规则。随本项目的每次翻译请求发送，并优先于模型默认设置（提示词规则 4）。"
          }
        }
      }
