    "%lld in this catalog · %lld to add. Every language Apple ships as a keyboard or UI language. Picked ones get a column now and are ready for a run; the catalog file only gains a language where a translation exists to save." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld في هذا الفهرس · %lld للإضافة. كل لغة تتيحها Apple كلغة لوحة مفاتيح أو واجهة. المحددة تحصل على عمود الآن وتكون جاهزة للتشغيل؛ ملف الفهرس يكتسب لغة فقط حيث توجد ترجمة لحفظها."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld في هذا الكتالوج · %lld للإضافة. كل لغة توفرها Apple كلغة لوحة مفاتيح أو واجهة. المحددة تحصل على عمود الحين وتكون جاهزة للتشغيل؛ ملف الكتالوج يضيف لغة فقط حيث توجد ترجمة للحفظ."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই কেটালগত %lld · যোগ কৰিবলৈ %lld টা। Apple এ কিব’ৰ্ড বা UI ভাষা হিচাপে দিয়া প্ৰতিটো ভাষা। বাছনি কৰাবোৰে এতিয়াই এটা কলাম পায় আৰু ৰানৰ বাবে সাজু; সংৰক্ষণ কৰিবলৈ অনুবাদ থকা ঠাইতহে কেটালগ ফাইলে এটা ভাষা লাভ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu kataloqda %lld · əlavə ediləcək %lld. Apple-ın klaviatura və ya UI dili kimi təqdim etdiyi hər dil. Seçilənlər indi sütun alır və icraya hazırdır; kataloq faylı yalnız saxlanacaq tərcümə olduqda dil qazanır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld у гэтым каталогу · %lld дадаць. Усе мовы, якія Apple пастаўляе як мовы клавіятуры або інтэрфейсу. Выбраныя адразу атрымліваюць слупок і гатовыя да запуску; файл каталога атрымлівае мову толькі там, дзе ёсць пераклад для захавання."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld в този каталог · %lld за добавяне. Всеки език, който Apple предлага като език за клавиатура или интерфейс. Избраните получават колона веднага и са готови за изпълнение; файлът на каталога получава език само там, където има превод за запазване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই ক্যাটালগে %lld · যোগ করতে %lld। Apple কিবোর্ড বা UI ভাষা হিসেবে যেসব ভাষা দেয় তার সব। বাছাইকৃতগুলো এখনই একটি কলাম পায় এবং রানের জন্য প্রস্তুত; ক্যাটালগ ফাইলে কেবল সেখানেই ভাষা যোগ হয় যেখানে সংরক্ষণের মতো অনুবাদ আছে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld དཀར་ཆག་ནང · %lld ཁ་སྣོན་དགོས། Apple གིས་མཐུད་མཚམས་སྐད་ཡིག་ཏུ་སྤེལ་བའི་སྐད་ཡོད་ཚད། བདམས་པ་ད་ལྟ་སྦྱོར་ཐོ་ཐོན་ནས་རྒྱུགས་ལ་གྲ་སྒྲིག། དཀར་ཆག་ཡིག་ཆར་འགྱུར་ཡིག་ཉར་དགོས་པའི་སྐད་ལ་གཞི་ཁ་སྣོན།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld बे क्याटलगआव · %lld दाजाबनांगौ। Apple आ किबʼर्ड एबा UI भाषा महरै होयो मोनफ्रोम भाषा। सायख'नायफोरा आथिखालावनो कलाम मोनो आरो रननि थाखाय थियारि; क्याटलग फाइला भाषा सोलʼयो जेब्ला दोनथ'नो अनुवाद दं।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld en aquest catàleg · %lld per afegir. Tots els idiomes que Apple ofereix com a idioma de teclat o d’interfície. Els seleccionats tenen columna ara i estan llestos per a una execució; el fitxer del catàleg només afegeix un idioma on hi ha una traducció per desar."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld ᎪᏪᎵ ᎦᏙᎬ · %lld ᎢᏗᎦᏔᎲ. Apple ᎤᏂᏅᏔᏅ ᎦᏬᏂ ᏗᏎᏍᏗ ᎠᎴ UI ᎦᏬᏂ. ᏕᏥᏔᏅ ᎤᎭ ᎦᏌᏆᎸ ᎯᎠ ᎠᎴ ᎯᎠᏅᏔᏅ ᎠᏓᏅᏖᏗ; ᎪᏪᎵ ᎤᎭ ᎦᏬᏂ ᏥᎦᏬᏂᎯᏍᏗ ᎤᎭ ᎢᏧᎳ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld لەم کەتەلۆگەدا · %lld بۆ زیادکردن. هەموو ئەو زمانانەی ئەپڵ وەک زمانی کیبۆرد یان UI دابینیان دەکات. هەڵبژێردراوەکان ئێستا ستونێکیان هەیە و ئامادەن بۆ ڕان؛ فایلی کەتەلۆگ تەنها زمانێک وەردەگرێت کە وەرگێڕانێک هەبێت بۆ پاشەکەوتکردن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld v tomto katalogu · %lld k přidání. Každý jazyk, který Apple dodává jako jazyk klávesnice nebo uživatelského rozhraní. Vybrané jazyky dostanou sloupec ihned a jsou připraveny na běh; soubor katalogu získá jazyk pouze tam, kde existuje překlad k uložení."
          }
