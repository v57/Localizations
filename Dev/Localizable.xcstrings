        },
        "my" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "သင် အပြီးသတ်ပြီးသော slot များ၏ စက်ဗားရှင်းများ။ ၎င်းတို့က သင့်တန်ဖိုးကို ဘယ်တော့မှ အစားမထိုးပါ — learn က ကွာခြားမှုကို ဖတ်သည်။"
