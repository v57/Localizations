        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите языки, которых ещё нет в каталоге, — их столбцы появятся здесь и будут заполнены запуском. Файл каталога получит язык только там, где есть перевод для сохранения"
          }
        },
        "sa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "भाषाः चिनुतु याः इयं सूची अद्यापि न वहति — तासां स्तम्भाः अत्र दृश्यन्ते धावनं च ताः पूरयति। सूचीसञ्चिका तामेव भाषां लभते यत्र रक्षणाय अनुवादः अस्ति"
          }
        },
        "sat" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᱱᱚᱣᱟ ᱠᱮᱴᱟᱞᱚᱜᱽ ᱨᱮ ᱫᱟᱹᱭᱟᱹ ᱵᱮᱜᱚᱨ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱵᱟᱪᱷᱟᱣ ᱢᱮ — ᱟᱠᱚᱣᱟᱜ ᱠᱚᱞᱚᱢ ᱠᱚ ᱱᱚᱸᱰᱮ ᱧᱮᱞᱚᱜᱼᱟ ᱟᱨ ᱢᱤᱫ run ᱛᱮ ᱯᱮᱨᱮᱡᱚᱜᱼᱟ᱾ ᱛᱚᱨᱡᱚᱢᱟ ᱢᱮᱱᱟᱜ ᱡᱟᱭᱜᱟ ᱨᱮᱜᱮ ᱠᱮᱴᱟᱞᱚᱜᱽ ᱯᱷᱟᱭᱤᱞ ᱨᱮ ᱯᱟᱹᱨᱥᱤ ᱥᱮᱞᱮᱫᱚᱜᱼᱟ"
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اهي ٻوليون چونڊيو جيڪي هن ڪيٽلاگ ۾ اڃا ناهن — انهن جا ڪالم هتي ظاهر ٿين ٿا ۽ هڪ رن انهن کي ڀري ٿو. ڪيٽلاگ فائل ۾ ٻولي تڏهن ئي شامل ٿئي ٿي جڏهن محفوظ ڪرڻ لاءِ ترجمو موجود هجي"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "මෙම නාමාවලිය තවම නොදරන භාෂා තෝරන්න — ඒවායේ තීරු මෙහි දිස්වන අතර ධාවනයක් ඒවා පුරවයි. සුරැකීමට පරිවර්තනයක් ඇති තැනක පමණක් නාමාවලි ගොනුව භාෂාවක් ලබයි"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte jazyky, ktoré katalóg ešte neobsahuje — ich stĺpce sa zobrazia tu a beh ich vyplní. Súbor katalógu získa jazyk len tam, kde existuje preklad na uloženie"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izberite jezike, ki jih ta katalog še nima — njihovi stolpci se prikažejo tukaj in zagon jih zapolni. Datoteka kataloga dobi jezik samo tam, kjer obstaja prevod za shranjevanje"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zgjidh gjuhët që ky katalog nuk i ka ende — kolonat e tyre shfaqen këtu dhe një ekzekutim i plotëson. Skedari i katalogut merr një gjuhë vetëm ku ka një përkthim për të ruajtur"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izaberite jezike koje ovaj katalog još nema — njihove kolone se pojavljuju ovde i pokretanje ih popunjava. Datoteka kataloga dobija jezik samo tamo gde postoji prevod za čuvanje"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Välj språk som den här katalogen ännu inte innehåller – deras kolumner visas här och en körning fyller dem. Katalogfilen får endast ett språk där det finns en översättning att spara"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chagua lugha ambazo katalogi hii haina bado — safu wima zao zinaonekana hapa na mwendo huzijaza. Faili la katalogi huongeza lugha tu pale tafsiri ilipo kuhifadhi"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "இந்தப் பட்டியல் இன்னும் கொண்டிராத மொழிகளைத் தேர்வு செய்க — அவற்றின் நெடுவரிசைகள் இங்கே தோன்றும், ஒரு இயக்கம் அவற்றை நிரப்பும். மொழிபெயர்ப்பு இருக்கும் இடத்தில் மட்டுமே பட்டியல் கோப்பு மொழியைப் பெறும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ఈ కేటలాగ్‌లో ఇంకా లేని భాషలను ఎంచుకోండి — వాటి నిలువు వరుసలు ఇక్కడ కనిపిస్తాయి మరియు ఒక రన్ వాటిని నింపుతుంది. సేవ్ చేయడానికి అనువాదం ఉన్నచోట మాత్రమే కేటలాగ్ ఫైల్‌కు భాష చేరుతుంది"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Забонҳоеро интихоб кунед, ки ин каталог ҳанӯз надорад — сутунҳои онҳо дар ин ҷо пайдо мешаванд ва иҷро онҳоро пур мекунад. Файли каталог танҳо забонеро мегирад, ки тарҷума барои захира вуҷуд дорад"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เลือกภาษาที่แค็ตตาล็อกนี้ยังไม่มี — คอลัมน์จะปรากฏที่นี่และ run จะเติมให้ ไฟล์แค็ตตาล็อกจะเพิ่มภาษาเฉพาะเมื่อมีคำแปลที่จะบันทึก"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu katalogyň heniz götermeýän dillerini saýlaň — olaryň sütünleri şu ýerde peýda bolýar we işleýiş olary doldurýar. Katalog faýly diňe saklamaga terjime bar ýerde dil gazanýar"
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fili e ngaahi lea 'oku te'eki 'i he catalog — 'oku hā mai honau ngaahi pou heni pea fakafonu kinautolu 'e ha lele. 'Oku ma'u pē 'e he faile catalog ha lea 'i he feitu'u 'oku 'i ai ha liliu ke sepi"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu kataloğun henüz içermediği dilleri seçin — sütunları burada görünür ve bir çalıştırma onları doldurur. Katalog dosyası, yalnızca kaydedilecek bir çevirinin olduğu dilde büyür"
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بۇ مۇندەرىجە تېخى ئۆز ئىچىگە ئالمىغان تىللارنى تاللاڭ — ئۇلارنىڭ ستونلىرى بۇ يەردە كۆرۈنىدۇ ۋە بىر ئىجرا ئۇلارنى تولدۇرىدۇ. مۇندەرىجە ھۆججىتى پەقەت ساقلايدىغان تەرجىمە بار يەردە تىل قوشىدۇ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Виберіть мови, яких цей каталог ще не має, — їхні стовпці з’являться тут, і запуск заповнить їх. Файл каталогу отримає мову лише там, де є переклад для збереження"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وہ زبانیں چنیں جو اس کیٹلاگ میں ابھی نہیں ہیں — ان کے کالم یہاں ظاہر ہوں گے اور ایک رن انہیں بھرے گا۔ کیٹلاگ فائل میں زبان صرف وہیں شامل ہوتی ہے جہاں محفوظ کرنے کے لیے ترجمہ موجود ہو"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chọn ngôn ngữ mà catalog này chưa có — cột của chúng sẽ hiện ở đây và một lượt chạy sẽ điền vào. Tệp catalog chỉ thêm ngôn ngữ khi có bản dịch để lưu"
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "揀呢個目錄未有嘅語言——佢哋嘅欄會出現喺呢度，執行一次就會填滿。目錄檔只會喺有翻譯可儲存時先加入語言"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "选择此目录尚未包含的语言——其列将显示在此处并由运行填充。仅当存在可保存的翻译时，目录文件才会新增语言"
          }
        }
      }
    },
