    "%@ is in the Trash — empty it to free the space. Your tools rebuild what they need on their next run." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ في سلة المهملات — أفرغها لتحرير المساحة. ستعيد أدواتك بناء ما تحتاجه في تشغيلها التالي."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ في سلة المهملات — أفرغها لتحرير المساحة. أدواتك تعيد بناء اللي تحتاجه في تشغيلها الجاي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ট্ৰেছত আছে — ঠাই মুকলি কৰিবলৈ খালী কৰক। আপোনাৰ সঁজুলিবোৰে পৰৱৰ্তী ৰানত প্ৰয়োজনীয়খিনি পুনৰ সাজিব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Zibil qutusundadır — yer açmaq üçün boşaldın. Alətləriniz lazım olanı növbəti icrada yenidən quracaq."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ў Сметніцы — ачысціце яе, каб вызваліць месца. Вашы інструменты адновяць патрэбнае пры наступным запуску."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ е в Кошчето — изпразнете го, за да освободите мястото. Вашите инструменти ще възстановят нужното при следващото си стартиране."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ট্র্যাশে আছে — জায়গা খালি করতে খালি করুন। আপনার টুলগুলো পরের রানে যা দরকার পুনরায় তৈরি করবে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ གད་སྙིགས་སྣོད་ནང་ཡོད། སྟོང་ཆ་ཐོབ་ཆེད་སྟོངས། ཁྱེད་ཀྱི་ཆས་རྣམས་རྒྱུགས་རྗེས་མར་དགོས་པ་བསྐྱར་བཟོ་བྱེད།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ आ Trash आव दं — जायगाखौ उदां खालामनो बेखौ खालि खालाम। नोंनि टुलफोरा गावनि नांगौखौ उन रनआव फिन बानायो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ és a la Paperera — buida-la per alliberar l’espai. Les teves eines reconstrueixen el que necessiten en la pròxima execució."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ᎤᏍᏛᏗ ᎦᏙᎬ ᎠᎭ — ᎦᏓᏘ ᎢᏧᏔᏅ ᎢᏧᎳᏏ. ᏗᏣᏓᏅᏖᏗ ᏗᎦᎸᏫᏍᏓᏁᏗ ᎢᏤ ᏗᎦᎵᏍᏗ ᏥᏂᎦᎵᏍᏗ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ لە سەبەتەدایە — بەتاڵی بکە بۆ ئازادکردنی شوێن. ئامرازەکانت لە جێبەجێکردنی داهاتوودا پێویستییەکانیان دووبارە بنیاد دەنێنەوە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ je v koši — vysypáním koše uvolníte místo. Vaše nástroje si při příštím spuštění obnoví, co potřebují."
