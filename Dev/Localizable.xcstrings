    "Reads the next page and looks again — the service has no search route to ask in one call" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقرأ الصفحة التالية ويبحث مجددًا — لا تملك الخدمة مسار بحث لسؤاله في استدعاء واحد"
          }
        },
        "ars" : {
          "stringUnit" : {
