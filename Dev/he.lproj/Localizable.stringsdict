<dict>
	<key> (and %lld more)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>(ועוד %lld)</string>
			<key>other</key>
			<string>(ועוד %lld)</string>
			<key>two</key>
			<string>(ועוד שניים)</string>
		</dict>
	</dict>
	<key> · %lld failed</key>
