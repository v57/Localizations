		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>(et %lld autres)</string>
			<key>one</key>
			<string>(et %lld autre)</string>
			<key>other</key>
			<string>(et %lld autres)</string>
		</dict>
	</dict>
