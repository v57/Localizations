          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ धरिक हर कनेक्शन समाप्त करैत अछि। डिवाइससभ जेकरा एखनो अनुमति अछि नव पहुँच सँ फेर जुड़ैत अछि।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ka whakamutu i ngā hononga katoa ki %@. Ka hono anō ngā pūrere e whakaaetia tonutia ana me te uru hou."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ја завршува секоја врска со %@. Уредите што сè уште се дозволени повторно се поврзуваат со нов пристап."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-ലേക്കുള്ള എല്ലാ കണക്ഷനുകളും അവസാനിപ്പിക്കുന്നു. ഇപ്പോഴും അനുവദിക്കപ്പെട്ട ഉപകരണങ്ങൾ പുതിയ ആക്‌സസോടെ വീണ്ടും ബന്ധിപ്പിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-д холбогдсон бүх холболтыг дуусгана. Зөвшөөрөлтэй хэвээр байгаа төхөөрөмжүүд шинэ хандалтаар дахин холбогдоно."
