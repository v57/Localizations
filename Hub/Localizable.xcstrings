        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac-ը, որը աշխատեցնում է %@-ը, կարող է քնած լինել կամ անցանց։ Փորձեք կրկին, երբ այն միացված լինի։"
