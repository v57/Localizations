    "hub-launcher on %@ runs it and restarts it when it crashes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يشغّله hub-launcher على %@ ويعيد تشغيله عند تعطّله"
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "hub-launcher على %@ يشغّله ويعيد تشغيله إذا طاح"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-ত hub-launcher-এ ইয়াক চলায় আৰু ক্ৰেছ হ’লে পুনৰ আৰম্ভ কৰে"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-də hub-launcher onu işlədir və qəza zamanı yenidən başladır"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "hub-launcher на %@ запускае яго і перазапускае пры збоі"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "hub-launcher на %@ го изпълнява и го рестартира при срив"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-এ hub-launcher এটি চালায় এবং ক্র্যাশ হলে পুনরায় চালু করে"
          }
        },
        "bo" : {
