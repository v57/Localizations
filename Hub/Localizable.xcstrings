        },
        "mni" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "মতম অসিমুক কিবোর্ড নৎত্রগা মাউস লৈতে। লক তৌরবা নৎত্রগা তুম্লবা খুদক্তা চংই।"
