        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yalnızca katılmayı isteyen aygıttaki güvenlik kodu %@ ise onaylayın. Başka bir kod gösteriyorsa veya hiç göstermiyorsa reddedin."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قوشۇلۇشنى سوراۋاتقان ئۈسكۈنىدىكى بىخەتەرلىك كودى %@ بولسىلا تەستىقلاڭ. باشقا كود كۆرسەتسە ياكى ھېچقانداق كود بولمىسا رەت قىلىڭ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Схвалюйте, лише якщо код безпеки на пристрої, що просить приєднатися, — %@. Якщо там інший код або його немає, відхиліть запит."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "صرف تب منظور کریں جب شامل ہونے کی درخواست کرنے والی ڈیوائس پر حفاظتی کوڈ %@ ہو۔ اگر وہ دوسرا کوڈ دکھائے یا کوئی نہ دکھائے تو مسترد کر دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chỉ phê duyệt nếu mã an toàn trên thiết bị yêu cầu tham gia là %@. Nếu thiết bị hiển thị mã khác hoặc không hiển thị, hãy từ chối."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "只有當要求加入嘅裝置上顯示嘅安全碼係 %@，先好批准。如果顯示其他代碼或冇顯示，請拒絕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅当请求加入的设备上显示的安全码为 %@ 时，才可批准。如果显示其他安全码或未显示，请拒绝。"
          }
        }
      }
