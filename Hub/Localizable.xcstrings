    "A group gives its connections the permissions you tick. Owners always have every permission." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تمنح المجموعة اتصالاتها الأذونات التي تحددها. يمتلك المالكون دائمًا كل الأذونات."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المجموعة تعطي اتصالاتها الأذونات اللي تحدّدها. الملاك دايم عندهم كل الأذونات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এটা গোটে আপুনি টিক কৰা অনুমতিবোৰ ইয়াৰ সংযোগবোৰক দিয়ে। মালিকসকলৰ সদায় সকলো অনুমতি থাকে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qrup öz bağlantılarına seçdiyiniz icazələri verir. Sahiblər hər zaman bütün icazələrə malikdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Група дае сваім злучэнням адзначаныя вамі дазволы. Уладальнікі заўсёды маюць усе дазволы."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Група дава на връзките си отметнатите от вас разрешения. Собствениците винаги имат всички разрешения."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "একটি গ্রুপ তার সংযোগগুলোকে আপনি যে অনুমতিগুলোতে টিক দেন সেগুলো দেয়। মালিকদের সবসময় সব অনুমতি থাকে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "སྡེས་ཁྱེད་ཀྱིས་བདམས་པའི་ཆོག་མཆན་འབྲེལ་མཐུད་ལ་སྤྲོད། བདག་པོར་ནམ་རྒྱུན་ཆོག་མཆན་ཡོངས་ཡོད།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मोनसे ग्रुपआ बेनि कनेक्सनफोरनो नोंआ टिक खालामनाय परमिशनफोरखौ होयो। गोरायगिरिफोरा जेब्लाबो गासै परमिशनफोरखौ दं।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un grup dona a les seves connexions els permisos que marquis. Els propietaris sempre tenen tots els permisos."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎠᎦᎳᏫᎢ ᏧᏓᏅᏙ ᏗᎦᏁᏟᏴᏍᏗ ᏴᏁᎢ ᎢᏥᏯᏔᏅ. ᏧᏤᎵ ᏂᎦᏛ ᎤᎾᎭ."
          }
        },
        "ckb" : {
