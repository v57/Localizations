        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "رُکُن چھِ نیٹ ورکَس پٮ۪ٹھ پورٹ 1997 پَر hub تام رَسِتھ۔ اَکھ میزبٲنی کرنہٕ باپتھ پورٹ 1997 اِستعمال کٔرِو۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Endam bi porta 1997 bi ser torê digihîjin hub-ê. Porta 1997 bikar bîne da ku yekê mêvandar bikî."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Мүчөлөр тармак аркылуу хабга 1997-порттон жетишет. Бирөөнү жайгаштыруу үчүн 1997-портту колдонуңуз."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ສະມາຊິກເຂົ້າເຖິງ hub ເທິງພອດ 1997 ຜ່ານເຄືອຂ່າຍ. ໃຊ້ພອດ 1997 ເພື່ອເປັນໂຮສ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nariai pasiekia hub per tinklą per 1997 prievadą. Norėdami priglobti, naudokite 1997 prievadą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dalībnieki sasniedz hubu 1997. portā tīklā. Lai mitinātu, izmantojiet 1997. portu."
          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सदस्य नेटवर्क पर पोर्ट 1997 पर हब धरि पहुँचैत छथि। एकटा होस्ट करबाक लेल पोर्ट 1997 प्रयोग करू।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ka toro ngā mema ki te hub i runga tauranga 1997 mā te whatunga. Whakamahia te tauranga 1997 hei manaaki i tētahi."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Членовите стигнуваат до хабот на порта 1997 преку мрежата. Користете ја портата 1997 за да хостирате."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "അംഗങ്ങൾ നെറ്റ്‌വർക്കിലൂടെ പോർട്ട് 1997-ൽ ഹബ്ബിലേക്ക് എത്തുന്നു. ഒരെണ്ണം ഹോസ്റ്റ് ചെയ്യാൻ പോർട്ട് 1997 ഉപയോഗിക്കുക."
          }
        }
      }
    },
