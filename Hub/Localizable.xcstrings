    "Reach %@ and %@ from this %@, wherever you are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمكنك الوصول إلى %@ و %@ من هذا %@، أينما كنت."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اوصل لـ %@ و %@ من %@ هذا، وين ما كنت."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ আৰু %@-ক এই %@-ৰ পৰা, আপুনি য’তেই নাথাকক যোগাযোগ কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Harada olmağınızdan asılı olmayaraq bu %@-dən %@ və %@-yə çatın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дасягайце %@ і %@ з гэтага %@, дзе б вы ні былі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Достигнете %@ и %@ от това %@, където и да сте."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনি যেখানেই থাকুন, এই %@ থেকে %@ এবং %@-তে পৌঁছান।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ འདི་ནས་གང་དུ་ཡོད་ཀྱང་ %@ དང་ %@ ར་སླེབས།"
          }
        },
        "brx" : {
