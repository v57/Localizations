        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Übersetzungsfunktion wurde in %@ und %@ für Geräte mit %@ eingeführt, daher kann sie auf anderen Geräten oder niedrigeren Versionen nicht ausgeführt werden"
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अनुवाद सुविधा %@ ते %@ च %@ आह्‌ले डिवाइसें लेई पेश कीती गेई ही तां इसगी दुए डिवाइसें या घट्ट संस्करणें पर चलाना संभव नेईं है"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ތަރުޖަމާ ފީޗަރ ތަޢާރަފްކުރެވުނީ %@ އަދި %@ ގައި %@ އޮންނަ ޑިވައިސްތަކަށް، އެހެންވެ އެހެން ޑިވައިސްތަކުގައި ނުވަތަ ދަށް ވަރޝަންތަކުގައި ހިންގޭގޮތް ނެތް"
          }
        },
