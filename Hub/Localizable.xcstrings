    "Stabilization on where the camera has it; focus, exposure and colour adjust all the time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التثبيت مفعّل حيث تدعمه الكاميرا؛ يتم ضبط التركيز والتعريض والألوان طوال الوقت."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التثبيت شغال حيث الكاميرا تدعمه؛ الفوكس والتعريض والألوان تتعدل طول الوقت."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কেমেৰাত য’ত আছে তাত স্থিৰীকৰণ অন; ফ’কাছ, এক্সপ’জাৰ আৰু ৰং সদায় সমন্বয় হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilləşdirmə kameranın dəstəklədiyi yerdə açıqdır; fokus, ekspozisiya və rəng daim tənzimlənir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стабілізацыя там, дзе яе мае камера; фокус, экспазіцыя і колер наладжваюцца пастаянна."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стабилизация там, където камерата я поддържа; фокусът, експозицията и цветовете се настройват постоянно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ক্যামেরা যেখানে সমর্থন করে সেখানে স্থিতিশীলকরণ চালু; ফোকাস, এক্সপোজার এবং রঙ সবসময় সমন্বয় হয়।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "པར་ལེན་ལ་ཡོད་སར་བརྟན་ལྷིང་ཁ་སྦྱར། དམིགས་, འོད་དང་ཚོན་མདོག་དུས་རྟག་འགྱུར།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्यामेरानि थानाय ठिकानाव स्थिरथाइ बानायनाय; फोकास, एक्सपोजार आरो गाबआ जेब्लाबो सहोयो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estabilització activada on la càmera la té; l'enfocament, l'exposició i el color s'ajusten contínuament."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᏂᏓᏓᏁᎸ ᎢᎨᏒ ᎾᎿ ᎠᏓᏰᎸ ᎡᎢ; focus, exposure ᎠᎴ ᎣᏓᎴᎢ ᎠᏏ ᎠᏓᏅᏖᏍᏗ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جێگیرکردن لەوێ چالاکە کە کامێراکە هەیەتی؛ فۆکەس، ڕووناکی و ڕەنگ هەمیشە ڕێکدەخرێن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilizace tam, kde ji kamera má; zaostření, expozice a barvy se upravují neustále."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sefydlogi ymlaen lle mae gan y camera ef; mae ffocws, amlygiad a lliw yn addasu drwy'r amser."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilisering til, hvor kameraet har den; fokus, eksponering og farve justeres hele tiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilisierung an, wo die Kamera sie hat; Fokus, Belichtung und Farbe passen sich ständig an."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्थिरीकरण उ’त्थे चालू जि’त्थे कैमरे च है; फोकस, एक्सपोज़र ते रंग हर बेल्ले समायोजत होंदे न।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ކެމެރާގައި އޮންނަތަނުގައި ސްޓެބިލައިޒޭޝަން އޮން؛ ފޯކަސް، އެކްސްޕޯޝަރ އަދި ކުލަ ހުރިހާ ވަގުތެއްގައި އެޖަސްޓްވޭ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Σταθεροποίηση όπου την υποστηρίζει η κάμερα· η εστίαση, η έκθεση και το χρώμα προσαρμόζονται συνεχώς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estabilización donde la cámara la tenga; el enfoque, la exposición y el color se ajustan todo el tiempo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabiliseerimine seal, kus kaameral see on; fookus, säritus ja värv kohanduvad kogu aeg."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تثبیت روشن در جایی که دوربین دارد؛ فوکوس، نوردهی و رنگ همیشه تنظیم می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vakautus siellä, missä kamera tukee sitä; tarkennus, valotus ja värit säätyvät jatkuvasti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naka-on ang stabilization kung saan ito sinusuportahan ng camera; patuloy na nag-aadjust ang focus, exposure at kulay."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilisering har kamerað hevur tað; fokus, lýsing og litur stillast alla tíðina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilisation là où la caméra la prend en charge ; mise au point, exposition et couleurs s’ajustent en permanence."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cobhsú ar siúl mar a bhfuil ag an gceamara é; coigeartaíonn fócas, nochtadh agus dath an t-am ar fad."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "જ્યાં કેમેરામાં હોય ત્યાં સ્થિરીકરણ ચાલુ; ફોકસ, એક્સપોઝર અને રંગ સતત ગોઠવાય છે."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoʻopaʻa ma kahi o ke kāmela; hoʻololi mau ka focus, exposure a me ka waihoʻoluʻu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ייצוב היכן שהמצלמה תומכת בו; מיקוד, חשיפה וצבע מותאמים כל הזמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जहाँ कैमरे में है वहाँ स्थिरीकरण चालू; फ़ोकस, एक्सपोज़र और रंग हर समय समायोजित होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilizacija uključena gdje je kamera ima; fokus, ekspozicija i boja prilagođavaju se stalno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilizálás, ahol a kamera támogatja; a fókusz, az expozíció és a színek folyamatosan igazodnak."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Կայունացումը միացված է, որտեղ տեսախցիկն այն ունի. ֆոկուսը, էքսպոզիցիան և գույնը կարգավորվում են անընդմեջ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilisasi aktif bila kamera mendukungnya; fokus, eksposur, dan warna menyesuaikan terus-menerus."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stöðugun þar sem myndavélin hefur hana; fókus, lýsing og litur aðlagast alltaf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilizzazione dove la fotocamera la prevede; messa a fuoco, esposizione e colori si regolano continuamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "カメラが対応している場合は手ぶれ補正がオン。フォーカス、露出、色は常に自動調整されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "სტაბილიზაცია ჩართულია იქ, სადაც კამერას აქვს; ფოკუსი, ექსპოზიცია და ფერი მუდმივად რეგულირდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Камерада бар жерде тұрақтандыру қосулы; фокус, экспозиция және түс үнемі бейімделеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ការធ្វើឱ្យស្ថិរភាពបើកនៅកន្លែងដែលកាមេរ៉ាមានវា; ការផ្តោត ការប៉ះពន្លឺ និងពណ៌កែតម្រូវជានិច្ច។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಕ್ಯಾಮೆರಾ ಹೊಂದಿರುವಲ್ಲಿ ಸ್ಥಿರೀಕರಣ ಆನ್; ಫೋಕಸ್, ಎಕ್ಸ್‌ಪೋಶರ್ ಮತ್ತು ಬಣ್ಣ ಎಲ್ಲಾ ಸಮಯದಲ್ಲೂ ಹೊಂದಾಣಿಕೆಯಾಗುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "카메라에서 지원하는 안정화 켜짐; 포커스, 노출 및 색상은 계속 조정됩니다."
          }
        },
        "kok" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कॅमेऱ्याक आसा थंय स्थिरीकरण चालू; फोकस, एक्स्पोजर आनी रंग सगळो वेळ समायोजीत जातात."
          }
        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اِستحکام تَتھ ییٚتہٕ کیمرہ چھُ اتھ تھاوان؛ فوکس، ایکسپوزر تہٕ رَنٛگ چھِ ہمیشہٕ بدلاوان۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabîlkirin li ku kamerayê hebe; fokus, ronahî û reng her dem têne sererastkirin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Камера колдогон жерде турукташтыруу күйүк; фокус, экспозиция жана түс дайыма жөндөлөт."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ກັນສັ່ນຕາມທີ່ກ້ອງມີ; ໂຟກັສ, ການເປີດຮັບແສງ ແລະ ສີຈະປັບຕະຫຼອດ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilizavimas ten, kur jį turi kamera; fokusavimas, ekspozicija ir spalvos prisitaiko nuolat."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilizācija tur, kur kamerai tā ir; fokuss, ekspozīcija un krāsa pielāgojas nepārtraukti."
          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्थिरीकरण ओतय चालू जतय कैमरामे अछि; फोकस, एक्सपोजर आ रंग सब समय समायोजित होइत अछि।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Te whakapūmau ina wātea ki te kāmera; ka whakatika te arotahi, te whakatūwheratanga me te tae i ngā wā katoa."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стабилизација таму каде што камерата ја има; фокусот, експозицијата и бојата се прилагодуваат постојано."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ക്യാമറയിൽ ഉള്ളിടത്ത് സ്ഥിരത ഓൺ; ഫോക്കസ്, എക്സ്പോഷർ, നിറം എന്നിവ എപ്പോഴും ക്രമീകരിക്കുന്നു."
          }
        }
      }
    },
