    "Approve only if the safety code on the device asking to join is %@. If it shows another code or none, deny it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وافق فقط إذا كان رمز الأمان على الجهاز الذي يطلب الانضمام هو %@. إذا عرض رمزًا آخر أو لم يعرض شيئًا، فارفضه."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وافق بس إذا رمز الأمان على الجهاز اللي يطلب الانضمام هو %@. إذا يعرض رمز ثاني أو بدون رمز، ارفضه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যোগ দিবলৈ বিচৰা ডিভাইচত সুৰক্ষা ক’ড %@ হ’লেহে অনুমোদন কৰক। ই আন ক’ড দেখুৱালে বা একো নেদেখুৱালে অস্বীকাৰ কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yalnız qoşulmaq istəyən cihazda təhlükəsizlik kodu %@ olduqda təsdiqləyin. Başqa kod göstərirsə və ya heç göstərmirsə, rədd edin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пацвярджайце, толькі калі код бяспекі на прыладзе, якая просіцца далучыцца, — %@. Калі там іншы код або яго няма, адхіліце."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Одобрете само ако кодът за безопасност на устройството, което иска да се присъедини, е %@. Ако показва друг код или никакъв, откажете го."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যোগ দিতে চাওয়া ডিভাইসের নিরাপত্তা কোড %@ হলেই শুধু অনুমোদন করুন। অন্য কোড বা কোনো কোড না দেখালে প্রত্যাখ্যান করুন।"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जयन जायनो सोंनाय डिभाइसआव सेफ्टि कडआ %@ जाब्लाल' एप्रुभ खालाम। बेयो गुबुन कड नङाब्ला जेबो दिन्थियोब्ला, बेखौ नेवशिगार।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprova-ho només si el codi de seguretat del dispositiu que demana unir-s'hi és %@. Si mostra un altre codi o cap, denega-ho."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎤᏓᏅᏖᏛ ᎢᏳᏃ ᎤᏓᏅᏖ ᏗᎪᏪᎵ ᎦᏔᏅᎯ ᎤᏙᎯᏳ %@ ᎨᏒ. ᎢᏳᏃ ᏧᎾᏔᏅ ᎠᎴᏃ ᎥᏝ, ᎠᏁᎸ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تەنها پەسەندبکە ئەگەر کۆدی سەلامەتی لەسەر ئەو ئامێرەی داوای بەشداری دەکات %@ بێت. ئەگەر کۆدێکی تر یان هیچ نیشان بدات، ڕەتی بکەرەوە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schvalte pouze pokud je bezpečnostní kód na zařízení žádajícím o připojení %@. Pokud zobrazuje jiný kód nebo žádný, odmítněte ho."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cymeradwywch dim ond os mai’r cod diogelwch ar y ddyfais sy’n gofyn i ymuno yw %@. Os yw’n dangos cod arall neu ddim, gwrthodwch ef."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Godkend kun, hvis sikkerhedskoden på enheden, der beder om at deltage, er %@. Hvis den viser en anden kode eller ingen, skal du afvise den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Genehmige nur, wenn der Sicherheitscode auf dem Gerät, das beitreten möchte, %@ lautet. Wenn dort ein anderer oder kein Code angezeigt wird, lehne ab."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सिर्फ तदूं मंजूर करो जे शामल होने लेई आखने आह्ले डिवाइस पर सुरक्षा कोड %@ है। जे एह् होर कोड दिखांदा है जां कोई नेईं, तां इन्कार करो।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ޖޮއިންވާން އެދޭ ޑިވައިސްގައި ދައްކާ ސޭފްޓީ ކޯޑަކީ %@ ނަމަ އެކަނި އެޕްރޫވްކުރައްވާ. އެހެން ކޯޑެއް ނުވަތަ އެއްވެސް ކޯޑެއް ނުދައްކާނަމަ ޑިނައިކުރައްވާ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εγκρίνετε μόνο αν ο κωδικός ασφαλείας στη συσκευή που ζητά να συμμετάσχει είναι %@. Αν δείχνει άλλον κωδικό ή κανέναν, απορρίψτε την."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprueba solo si el código de seguridad del dispositivo que pide unirse es %@. Si muestra otro código o ninguno, deniégalo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kinnitage ainult siis, kui liitumist taotleva seadme turvakood on %@. Kui see näitab teist koodi või üldse mitte, keelake see."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فقط اگر کد امنیتی روی دستگاهی که می‌خواهد بپیوندد %@ است تأیید کنید. اگر کد دیگری نشان می‌دهد یا هیچی، رد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hyväksy vain, jos liittymistä pyytävän laitteen turvakoodi on %@. Jos se näyttää toisen koodin tai ei mitään, hylkää se."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprubahan lang kung ang safety code sa device na gustong sumali ay %@. Kung ibang code ang ipinapakita nito o wala, tanggihan ito."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Góðkenn bert, um trygdarkotan á eindini, sum biður um at koma upp í, er %@. Vísir hon eina aðra kodu ella onga, nokta henni."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Approuvez uniquement si le code de sécurité sur l’appareil qui demande à rejoindre est %@. S’il affiche un autre code ou aucun, refusez-le."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ceadaigh amháin más é %@ an cód sábháilteachta ar an ngléas atá ag iarraidh páirt a ghlacadh. Má thaispeánann sé cód eile nó ceann ar bith, diúltaigh é."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "માત્ર ત્યારે જ મંજૂર કરો જો જોડાવા માટે પૂછતા ડિવાઇસ પરનો સેફ્ટી કોડ %@ હોય. જો તે બીજો કોડ બતાવે કે કોઈ ન બતાવે, તો ઇનકાર કરો."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "E ʻae wale inā ʻo %@ ke code malu ma ka mea e noi e komo. Inā hōʻike i code ʻē a i ʻole ʻole, e hōʻole."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אשר רק אם קוד הבטיחות במכשיר שמבקש להצטרף הוא %@. אם הוא מציג קוד אחר או לא מציג קוד, דחה אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "केवल तभी स्वीकृत करें जब जुड़ने के लिए पूछने वाले डिवाइस पर सुरक्षा कोड %@ हो। यदि वह कोई अन्य कोड दिखाता है या कोई नहीं, तो अस्वीकार करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odobrite samo ako je sigurnosni kôd na uređaju koji traži pridruživanje %@. Ako prikazuje drugi kôd ili nijedan, odbijte ga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Csak akkor hagyd jóvá, ha a csatlakozni kívánó eszközön látható biztonsági kód: %@. Ha más kódot mutat, vagy semmit, utasítsd el."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Հաստատեք միայն, եթե միանալ խնդրող սարքի անվտանգության կոդը %@ է։ Եթե այն ցույց է տալիս այլ կոդ կամ ոչինչ, մերժեք այն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setujui hanya jika kode keamanan pada perangkat yang meminta bergabung adalah %@. Jika menampilkan kode lain atau tidak ada, tolak."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Samþykktu aðeins ef öryggiskóðinn á tækinu sem biður um að ganga í er %@. Ef það sýnir annan kóða eða engan, hafnaðu því."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Approva solo se il codice di sicurezza sul dispositivo che chiede di unirsi è %@. Se mostra un altro codice o nessuno, rifiutalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "参加を求めているデバイスに表示されるセーフティコードが %@ の場合のみ承認してください。別のコードやコードなしの場合は拒否してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "დაამტკიცეთ მხოლოდ თუ უსაფრთხოების კოდი მოწყობილობაზე, რომელიც შეერთებას ითხოვს, არის %@. თუ ის აჩვენებს სხვა კოდს ან საერთოდ არაფერს, უარყავით."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Қосылуды сұрап тұрған құрылғыдағы қауіпсіздік коды %@ болса ғана мақұлдаңыз. Егер басқа код көрсетсе немесе ештеңе көрсетпесе, қабылдамаңыз."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "អនុម័តតែប្រសិនបើលេខកូដសុវត្ថិភាពនៅលើឧបករណ៍ដែលស្នើសុំចូលរួមគឺ %@។ ប្រសិនបើវាបង្ហាញកូដផ្សេង ឬគ្មានទេ សូមបដិសេធ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಸೇರಲು ಕೇಳುವ ಸಾಧನದಲ್ಲಿನ ಸುರಕ್ಷತಾ ಕೋಡ್ %@ ಆಗಿದ್ದರೆ ಮಾತ್ರ ಅನುಮೋದಿಸಿ. ಅದು ಬೇರೆ ಕೋಡ್ ತೋರಿಸಿದರೆ ಅಥವಾ ಯಾವುದೂ ಇಲ್ಲದಿದ್ದರೆ, ನಿರಾಕರಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "참여를 요청하는 기기에 표시된 안전 코드가 %@인 경우에만 승인하세요. 다른 코드가 표시되거나 표시되지 않으면 거부하세요."
          }
        },
        "kok" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जॉयन जावंक विचारपी डिव्हायसाचेरचो सुरक्षा कोड %@ जाल्यारच मंजूर करात. तें हेर कोड दाखयता वा कांयच नासल्यार, न्हयकारात."
          }
        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "صِرَف تَیلہِ منظوٗر کَرِو ییٚلہِ شٲمِل گَژھن واجِن ڈیوائس پؠٹھ حفاظتی کوڈ %@ آسِہ۔ اگر یہ بیٚیہِ کوڈ یا کانٛہہ تِہ وُچھاوِہ نَہ، اَتھ نامنظوٗر کَرِو۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tenê heke koda ewlehiyê li ser amûra ku dixwaze tevlî bibe %@ be biperijîne. Heke kodeke din an tu kod nîşan bide, red bike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кошулууну суранган түзмөктөгү коопсуздук коду %@ болсо гана бекитиңиз. Эгер ал башка кодду көрсөтсө же эч нерсе көрсөтпөсө, четке кагыңыз."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ອະນຸມັດສະເພາະຖ້າລະຫັດຄວາມປອດໄພໃນອຸປະກອນທີ່ຂໍເຂົ້າຮ່ວມແມ່ນ %@. ຖ້າມັນສະແດດລະຫັດອື່ນ ຫຼື ບໍ່ສະແດງເລີຍ, ໃຫ້ປະຕິເສດ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Patvirtinkite tik jei saugos kodas įrenginyje, kuris prašo prisijungti, yra %@. Jei rodomas kitas kodas arba jokio, atmeskite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apstipriniet tikai tad, ja drošības kods ierīcē, kas lūdz pievienoties, ir %@. Ja tajā redzams cits kods vai nekāds, noraidiet to."
          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मात्र तखन अनुमोदित करू जखन जुड़ऽ लेल पुछैत डिवाइस पर सुरक्षा कोड %@ अछि। यदि ई दोसर कोड वा किछु नहि देखबैत अछि तँ अस्वीकार करू।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whakaae mēnā ko %@ te waehere haumaru kei te pūrere e tono ana ki te uru. Mēnā he waehere kē, kāore rānei, whakakorea."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Одобрете само ако безбедносниот код на уредот што бара да се приклучи е %@. Ако покажува друг код или ниеден, одбијте го."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ചേരാൻ ആവശ്യപ്പെടുന്ന ഉപകരണത്തിലെ സേഫ്റ്റി കോഡ് %@ ആണെങ്കിൽ മാത്രം അംഗീകരിക്കുക. മറ്റൊരു കോഡ് കാണിക്കുകയോ ഒന്നും കാണിക്കാതിരിക്കുകയോ ചെയ്താൽ നിരസിക്കുക."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нэгдэхийг хүсэж буй төхөөрөмж дээрх аюулгүй байдлын код %@ байвал л зөвшөөр. Хэрэв өөр код харуулсан эсвэл огт харуулахгүй бол татгалз."
          }
        }
      }
    },
