        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हब इसगी अज्जें सौंप नेईं सकदा। इसगी उसदे डिवाइस पर कैमरे दी सेटिंग थमां कॉपी करो।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ހަބަށް އަދި އത് ހަވާލުކުރެވޭގޮތް ނެތް. އޭގެ ޑިވައިސްގައި ކެމެރާގެ ސެޓިންގްސްއިން އത് ކޮޕީކުރޭ."
