        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ir aptuveni %@. Tiešraide patērē datus tikai skatīšanās laikā. Klipi pieņem %@ kustību dienā (pēdējās 7 dienas)."
