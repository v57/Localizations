        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ beträgt etwa %@. Die Live-Ansicht verbraucht nur Daten, während jemand zuschaut. Clips gehen von %@ Bewegung pro Tag aus (letzte 7 Tage)."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ लगभग %@ है। लाइव व्यू सिर्फ जदूं कोई दिखदा है डेटा बरतदा है। क्लिप्स इक दिन च %@ मोशन मनदे न (पिछले 7 दिन)।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ އަކީ %@ އާ ބެހޭގޮތުން. ލައިވްވިއު ޑޭޓާ ބޭނުންކުރަނީ ބަލަމުންދާއިރު އެކަނި. ކްލިޕްތައް ބަލަނީ ދުވާލަކު %@ މޯޝަން (ފަހު 7 ދުވަސް)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
