        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Telefonun buradaymış kimi baxır: saytlar bu Mac-in ünvanını görür. Heç nə başqasının serverlərindən keçmir; v57.dev yalnız ikisinin bir-birini tapmasına kömək edir."
          }
        },
        "be" : {
          "stringUnit" : {
