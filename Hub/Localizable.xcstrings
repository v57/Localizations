        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপুনি আমন্ত্ৰণ কৰা ডিভাইচবোৰ এই হাবে হ’ষ্ট কৰা ব্যক্তিগত নেটৱৰ্কত যোগ দিয়ে। ইয়াৰ ন’ড সেট কৰক আৰু ইয়াতে আমন্ত্ৰণ সৃষ্টি কৰক; এই ডিভাইচৰ নিজৰ নেটৱৰ্ক এক্সটেনশ্বন প্ৰথম সদস্য আৰু আমন্ত্ৰণকাৰী।"
