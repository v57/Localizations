            "state" : "needs_review",
            "value" : "Samþykkir lykilinn sem %@ sýnir nú.%@ Gerðu þetta aðeins ef þú veist af hverju hann breyttist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accetta la chiave che %@ mostra ora.%@ Fallo solo se sai perché è cambiata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ が現在表示しているキーを受け入れます。%@ 変更理由が分かる場合のみ実行してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "იღებს გასაღებს, რომელსაც %@ ახლა აჩვენებს.%@ გააკეთეთ ეს მხოლოდ თუ იცით, რატომ შეიცვალა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ қазір көрсететін кілтті қабылдайды.%@ Мұны тек неге өзгергенін білсеңіз ғана жасаңыз."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ទទួលយកសោដែល %@ បង្ហាញឥឡូវនេះ។%@ សូមធ្វើបែបនេះតែប្រសិនបើអ្នកដឹងពីមូលហេតុដែលវាប្តូរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ಈಗ ತೋರಿಸುವ ಕೀಯನ್ನು ಸ್ವೀಕರಿಸುತ್ತದೆ.%@ ಅದು ಏಕೆ ಬದಲಾಯಿತು ಎಂದು ನಿಮಗೆ ತಿಳಿದಿದ್ದರೆ ಮಾತ್ರ ಇದನ್ನು ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에 현재 표시되는 키를 허용합니다.%@ 키가 변경된 이유를 아는 경우에만 실행하세요."
          }
        },
        "kok" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ आतां दाखयता ती किल्ली स्वीकारता.%@ तें कित्याक बदल्लां हें तुमकां कळटा जाल्यारच हें करात."
          }
        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کی قبول کَرِو یُس %@ وۄنؠ وُچھاوان چھُ۔%@ یہ صِرَف تَیلہِ کَرِو ییٚلہِ تۄہہِ زانِو یہ کِتھ پٲٹھؠ بدلیوو۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mifteya ku %@ niha nîşan dide qebûl bike.%@ Tenê heke tu dizanî çima guherî vê bike."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ азыр көрсөткөн ачкычты кабыл алат.%@ Муну ал эмне үчүн өзгөргөнүн билсеңиз гана жасаңыз."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ຍອມຮັບຄີທີ່ %@ ສະແດງດຽວນີ້.%@ ເຮັດແບບນີ້ສະເພາະເມື່ອທ່ານຮູ້ວ່າເປັນຫຍັງມັນຈຶ່ງປ່ຽນ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Priima raktą, kurį %@ dabar rodo.%@ Darykite tai tik jei žinote, kodėl jis pasikeitė."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pieņem atslēgu, ko %@ tagad rāda.%@ Dariet to tikai tad, ja zināt, kāpēc tā mainījās."
          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ओ कुंजी स्वीकार करू जे %@ एखन देखबैत अछि।%@ ई मात्र तखन करू जखन अहाँ जानैत छी जे ई किए बदलल।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ka whakaae ki te kī e whakaatu ana a %@ ināianei.%@ Mahia tēnei mēnā e mōhio ana koe he aha i huri ai."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Го прифаќа клучот што %@ сега го покажува.%@ Направете го ова само ако знаете зошто е променет."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ഇപ്പോൾ കാണിക്കുന്ന കീ സ്വീകരിക്കുന്നു.%@ എന്തുകൊണ്ട് മാറിയെന്ന് അറിയാമെങ്കിൽ മാത്രം ഇത് ചെയ്യുക."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-ийн одоо харуулж буй түлхүүрийг хүлээн зөвшөөрнө.%@ Яагаад өөрчлөгдсөнийг мэдэж байгаа тохиолдолд л үүнийг хий."
          }
        }
      }
