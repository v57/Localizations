    "Exposure and colour adjust every 10 s, not every frame." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُضبط التعريض والألوان كل 10 ثوانٍ، وليس في كل إطار."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التعريض واللون يتعدلون كل 10 ثواني، مو كل إطار."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এক্সপ’জাৰ আৰু ৰং প্ৰতি 10 ছেকেণ্ডত সলনি হয়, প্ৰতিটো ফ্ৰেমত নহয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ekspozisiya və rəng hər 10 saniyədən bir tənzimlənir, hər kadrda yox."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Экспазіцыя і колер наладжваюцца кожныя 10 с, а не ў кожным кадры."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Експозицията и цветът се настройват на всеки 10 s, а не на всеки кадър."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এক্সপোজার ও রঙ প্রতি ফ্রেমে নয়, প্রতি 10 s-এ সমন্বয় হয়।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "འོད་ཚད་དང་ཁ་དོག་སྐར་ཆ་10 རེར་བསྒྱུར། སྐར་ཆ་རེ་རེར་མིན།"
