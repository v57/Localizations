        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បញ្ចប់ការតភ្ជាប់គ្រប់យ៉ាងទៅ %@។ ឧបករណ៍ដែលនៅតែត្រូវបានអនុញ្ញាតភ្ជាប់ឡើងវិញជាមួយសិទ្ធិចូលប្រើថ្មី។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ಗೆ ಪ್ರತಿ ಸಂಪರ್ಕವನ್ನು ಕೊನೆಗೊಳಿಸುತ್ತದೆ. ಇನ್ನೂ ಅನುಮತಿಸಲಾದ ಸಾಧನಗಳು ಹೊಸ ಪ್ರವೇಶದೊಂದಿಗೆ ಮರುಸಂಪರ್ಕಿಸುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에 대한 모든 연결을 종료합니다. 여전히 허용된 기기는 새 액세스로 다시 연결됩니다."
          }
        },
        "kok" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ची दरेक जोडणी सोंपयता. अजून परवानगी आशिल्लीं डिव्हायसां नव्या प्रवेशान परत जोडटात."
          }
        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ سٟتؠ ہَر کنکشن ختم کَران۔ ڈیوائس یِمَن اَز تِہ اِجازت چھِ نَوِس رَسٲے سٟتؠ بیٚیہِ جُڑَن۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hemû girêdanên bi %@ re diqedîne. Amûrên ku hîn destûrdayî ne bi gihîştina nû dîsa girê dibin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@га болгон ар бир туташууну аяктайт. Азыр да уруксаты бар түзмөктөр жаңы кирүү менен кайра туташат."
