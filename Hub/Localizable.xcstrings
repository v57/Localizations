    "iOS’s own numbers for the cameras together; the full bar is the limit. Past it iOS slows the cameras, then stops them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أرقام iOS الخاصة بالكاميرات مجتمعة؛ الشريط الكامل هو الحد. بعده يُبطئ iOS الكاميرات ثم يوقفها."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أرقام iOS نفسها للكاميرات كلها مع بعض؛ الشريط الممتلئ هو الحد. بعده iOS يبطّئ الكاميرات، وبعدين يوقفها."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কেমেৰাবোৰ একেলগে iOS-ৰ নিজা সংখ্যা; সম্পূৰ্ণ বাৰেই সীমা। ইয়াৰ পিছত iOS-এ কেমেৰাবোৰ লেহেমীয়া কৰে, তাৰ পিছত বন্ধ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS-un kameralar üçün birlikdə öz göstəriciləri; dolu zolaq limitdir. Bundan sonra iOS kameraları yavaşladır, sonra dayandırır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Уласныя сумарныя паказчыкі iOS для камер; поўная паласа — гэта ліміт. Пасля яго iOS запавольвае камеры, а потым спыняе іх."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Собствените стойности на iOS за камерите заедно; пълната лента е ограничението. След него iOS забавя камерите, после ги спира."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ক্যামেরাগুলো একসাথে নিয়ে iOS-এর নিজস্ব সংখ্যা; পূর্ণ বারটাই সীমা। এর পরে iOS ক্যামেরাগুলো ধীর করে দেয়, তারপর বন্ধ করে দেয়।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཕར་ལེན་རྣམས་མཉམ་དུ iOS ཀྱི་རང་གི་གྲངས་ཐང་། རྒྱུན་ཧྲིལ་པོ་ནི་ཚད་གཞི་ཡིན། དེ་ལས་བརྒལ་ཚེ iOS ཀྱིས་ཕར་ལེན་རྣམས་དལ་བར་བྱས་རྗེས་མཚམས་འཇོག་བྱེད།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्यामेराफोरनि थाखाय जयै iOSनि गावनि अनजिमाफोर; आबुङ बारआ सिमानाया। बेनि उनाव iOSआ क्यामेराफोरखौ लोरबन्द खालामो, बेनि उनाव बन्द खालामो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els números propis d'iOS per al conjunt de càmeres; la barra plena és el límit. Més enllà, iOS alenteix les càmeres i després les atura."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS ᎤᏤᎵ ᏗᏎᏍᏗ ᎠᏓᏅᏖᏛ ᏗᎧᎿᏩᏛᏍᏗ ᎢᏧᎳᎭ; ᎠᏔᎴᏒ ᎪᏪᎳ ᎠᏍᏛ ᎢᏳᎦᏔᎭ. ᎾᏍᎩ ᎣᏂ iOS ᏗᎧᎿᏩᏛᏍᏗ ᏫᏂᎦᎵᏍᏗ, ᎠᎴ ᎣᏂ ᎤᏁᏒᎢ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ژمارەکانی خۆی iOS بۆ کامێراکان پێکەوە؛ هێڵی تەواو سنوورەکەیە. لەوە زیاتر iOS کامێراکان خاو دەکاتەوە، پاشان دەیانهێڵێت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "vlastní souhrnná čísla iOS pro kamery dohromady; plný pruh je limit. Za ním iOS kamery zpomalí a pak zastaví."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "rhifau iOS ei hun ar gyfer y camerâu gyda’i gilydd; y bar llawn yw’r terfyn. Tu hwnt iddo mae iOS yn arafu’r camerâu, yna’n eu hatal."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS’ egne tal for kameraerne tilsammen; den fulde bjælke er grænsen. Over den sætter iOS kameraerne ned og stopper dem derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS-eigene Werte für die Kameras zusammen; der volle Balken ist das Limit. Darüber hinaus drosselt iOS die Kameras und stoppt sie dann."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कैमरें लेई iOS दे अपने अंकड़े कठ्ठे; पूरी बार सीमा है। इसदे बाद iOS कैमरें गी हौली करदा है, फिरी बंद करदा है।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ކެމެރާތަކަށް އެއްކޮށް iOS ގެ އަމިއްލަ އަދަދުތައް؛ ފުރިހަމަ ބާރަކީ ލިމިޓް. އެއަށްވުރެ އިތުރުވެއްޖެނަމަ iOS އިން ކެމެރާތައް މަޑުކޮށް، ދެން ހުއްޓުވާ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι αριθμοί του ίδιου του iOS για τις κάμερες μαζί· η γεμάτη μπάρα είναι το όριο. Πέρα από αυτό, το iOS επιβραδύνει τις κάμερες και μετά τις σταματά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "los datos propios de iOS para las cámaras en conjunto; la barra completa es el límite. Pasado ese límite, iOS ralentiza las cámaras y luego las detiene."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS-i enda numbrid kaamerate kohta kokku; täis riba on piir. Sellest üle minnes iOS aeglustab kaameraid, seejärel peatab need."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ارقام خود iOS برای مجموع دوربین‌ها؛ نوار پر همان حد مجاز است. پس از آن iOS ابتدا دوربین‌ها را کند می‌کند، سپس آن‌ها را متوقف می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS:n omat lukemat kameroille yhteensä; täysi palkki on raja. Sen jälkeen iOS hidastaa kameroita ja sitten pysäyttää ne."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mga sariling numero ng iOS para sa mga camera nang sama-sama; ang punong bar ang limitasyon. Kapag lumampas dito, pinapabagal ng iOS ang mga camera, pagkatapos ay hinihinto ang mga ito."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS egnu tøl fyri myndatólini samlað; fulla strikkan er markið. Umanfyri tað ger iOS myndatólini spakuligari og steðgar teimum síðani."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "les chiffres propres d’iOS pour les caméras ensemble ; la barre pleine est la limite. Au-delà, iOS ralentit les caméras, puis les arrête."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "uimhreacha iOS féin do na ceamaraí le chéile; is é an barra iomlán an teorainn. Tar éis di moillíonn iOS na ceamaraí, ansin stopann sé iad."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "કૅમેરા માટે iOS ના પોતાના આંકડા એકસાથે; પૂરો બાર એ મર્યાદા છે. તે પછી iOS કૅમેરા ધીમા કરે છે, પછી બંધ કરે છે."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nā helu ponoʻī o iOS no nā kāmela hui pū; ʻo ka pā piha ka palena. Ma mua aku o ia, hoʻolohi ʻo iOS i nā kāmela, a laila hoʻōki iā lākou."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "המספרים של iOS עצמה עבור המצלמות יחד; הפס המלא הוא המגבלה. מעבר לכך iOS מאט את המצלמות ואז עוצר אותן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कैमरों के लिए iOS के अपने संयुक्त आंकड़े; पूरी बार सीमा है। इसके बाद iOS कैमरों को धीमा कर देता है, फिर रोक देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS-ove vlastite brojke za kamere zajedno; puna traka je ograničenje. Nakon njega iOS usporava kamere, a zatim ih zaustavlja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az iOS saját összesített számai a kamerákról; a teli sáv a korlát. Utána az iOS lassítja a kamerákat, majd leállítja őket."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS-ի սեփական թվերը տեսախցիկների համար միասին; լրիվ սանդղակը սահմանն է։ Դրանից հետո iOS-ը դանդաղեցնում է տեսախցիկները, ապա կանգնեցնում դրանք։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "angka iOS sendiri untuk semua kamera digabung; bilah penuh adalah batasnya. Melewatinya iOS memperlambat kamera, lalu menghentikannya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eigin tölur iOS fyrir myndavélarnar samanlagt; full stika er hámarkið. Eftir það hægir iOS á myndavélunum, stöðvar þær síðan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "i numeri propri di iOS per le telecamere insieme; la barra piena è il limite. Oltre il limite iOS rallenta le telecamere, poi le ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "カメラ合計に対するiOS独自の数値。バー全体が上限です。上限を超えるとiOSはカメラを低速化し、その後停止します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS-ის საკუთარი მაჩვენებლები კამერებისთვის ერთად; სრული ზოლი ლიმიტია. მის შემდეგ iOS ანელებს კამერებს, შემდეგ აჩერებს მათ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Камералар үшін iOS-тың өз жиынтық көрсеткіштері; толық жолақ — шек. Одан асқанда iOS камераларды баяулатады, сосын тоқтатады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "លេខផ្ទាល់របស់ iOS សម្រាប់កាមេរ៉ារួមគ្នា; របារពេញគឺជាដែនកំណត់។ លើសពីនេះ iOS បន្ថយល្បឿនកាមេរ៉ា បន្ទាប់មកបញ្ឈប់ពួកវា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಕ್ಯಾಮರಾಗಳಿಗೆ ಒಟ್ಟಾಗಿ iOS ನ ಸ್ವಂತ ಸಂಖ್ಯೆಗಳು; ಪೂರ್ಣ ಪಟ್ಟಿಯೇ ಮಿತಿ. ಅದನ್ನು ದಾಟಿದರೆ iOS ಕ್ಯಾಮರಾಗಳನ್ನು ನಿಧಾನಗೊಳಿಸುತ್ತದೆ, ನಂತರ ನಿಲ್ಲಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "카메라 전체에 대한 iOS 자체 수치이며, 전체 막대가 한도입니다. 이를 초과하면 iOS가 카메라 속도를 늦추다가 중단합니다."
          }
        },
        "kok" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कॅमेर्‍यां खातीर एकठांय iOS चे स्वताचे आंकडे; पुराय बार ही मर्यादा. ताचे पयस iOS कॅमेरे सावकास करता, मागीर थांबयता."
          }
        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کیمرن ہٕنٛدؠ خٲطرٕ iOS ہٕنٛدؠ پنٛنٮ۪ن نمبر اَٹھؠ؛ پوٗر بار چھُ حد۔ اَمہِ برٛونٛٹھ iOS چھُ کیمرن ہلکان کَران، پَتہٕ بنٛد کَران۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hejmarên iOSê bi xwe ji bo kamerayan bi hev re; bara tijî sînor e. Piştî wê iOS kamerayan hêdî dike, paşê wan radiwestîne."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOSтун камералар үчүн жалпы өз сандары; толгон тилке — чек. Андан ашса iOS камераларды жайлатат, анан токтотот."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ຕົວເລກຂອງ iOS ເອງສຳລັບກ້ອງທັງໝົດລວມກັນ; ແຖບເຕັມແມ່ນຂີດຈຳກັດ. ເກີນກວ່ານັ້ນ iOS ຈະເຮັດໃຫ້ກ້ອງຊ້າລົງ, ແລ້ວຢຸດພວກມັນ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bendri „iOS“ skaičiai visoms kameroms kartu; pilna juosta yra riba. Ją viršijus „iOS“ sulėtina kameras, tada jas sustabdo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS paša skaitļi kamerām kopā; pilna josla ir limits. Pēc tā iOS palēnina kameras un pēc tam tās aptur."
          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कैमरासभक लेल एक संग iOS क अपन आँकड़ा; भरल बार सीमा अछि। ओकरा पार कएलापर iOS कैमरासभ केँ धीमा क' दैत अछि, फेर रोकि दैत अछि।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ko ngā tatauranga ake a iOS mō ngā kāmera katoa; ko te pae kapi te tepenga. I tua atu ka whakapōturi a iOS i ngā kāmera, kātahi ka whakamutu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "сопствените бројки на iOS за камерите заедно; полната лента е ограничувањето. По него iOS ги успорува камерите, а потоа ги запира."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ക്യാമറകൾ ഒരുമിച്ചുള്ള iOS-ന്റെ സ്വന്തം കണക്കുകൾ; നിറഞ്ഞ ബാർ ആണ് പരിധി. അതു കഴിഞ്ഞാൽ iOS ക്യാമറകളെ മന്ദഗതിയിലാക്കും, പിന്നീട് നിർത്തും."
