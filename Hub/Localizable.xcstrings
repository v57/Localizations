        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ هێشتا هیچ ئەپێک هاوبەش ناکات. دەتوانێت بگات بە ئامێرەکانت، و ئەوانیش دەتوانن پێی بگەن."
