        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کینٛہہ وقتہٕ پَتہٕ بیٚیہِ کوٗشِش کرِو۔ ییٚلہِ یہ ناکام روزِہ، نوٚو دَعوت مَنٛگِو۔"
