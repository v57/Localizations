        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ավարտում է բոլոր միացումները %@-ին։ Սարքերը, որոնք դեռ թույլատրված են, նորից են միանում նոր մուտքով։"
