    "Browse as if you were where %@ is. Handy on public Wi-Fi." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تصفح كما لو كنت حيث %@ موجود. مفيد على شبكات Wi-Fi العامة."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تصفّح كأنك مكان ما %@ فيه. مفيد على الواي فاي العام."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ য’ত আছে আপুনি ত’ত থকাৰ দৰে ব্ৰাউজ কৰক। ৰাজহুৱা Wi-Fi-ত সুবিধাজনক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sanki %@-nin olduğu yerdəsiniz kimi baxın. İctimai Wi-Fi-da əlverişlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Праглядайце так, быццам вы там, дзе %@. Зручна ў публічным Wi-Fi."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сърфирайте все едно сте там, където е %@. Удобно при обществен Wi-Fi."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ যেখানে আছে সেখানে থাকার মতো ব্রাউজ করুন। পাবলিক Wi-Fi-তে কাজের।"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नों %@ थानाय जायगायाव थायो जेरै ब्राउज खालाम। पाब्लिक वाइ-फाइआव बाहायथाव।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Navega com si fossis on és %@. Pràctic amb Wi-Fi públic."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᏣᎪᏩᏛ ᎢᏳᏃ %@ ᎾᎿᎭ ᏥᎨᏒ. ᎣᏍᏛ ᎤᎾᏓᏡᎬ Wi-Fi ᏧᏟᎶᏛ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بگەڕێ وەک ئەوەی لەوێ بیت کە %@ لێیە. بەسوودە لە Wi-Fi گشتیدا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Procházejte, jako byste byli tam, kde je %@. Hodí se na veřejné Wi-Fi."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porwch fel petaech lle mae %@. Ddefnyddiol ar Wi-Fi cyhoeddus."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Surf, som om du var, hvor %@ er. Praktisk på offentligt Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Surfe, als wärst du dort, wo %@ ist. Praktisch in öffentlichem WLAN."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जिवें तुस उत्थे ओ जिथे %@ है ब्राउज़ करो। सार्वजनिक वाई-फाई पर सुविधाजनक।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ހުރި ތަނުގައި ތިއްބެވިހެން ބްރައުޒްކުރައްވާ. ޕަބްލިކް ވައި-ފައިގައި ފަސޭހަ."
