          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रेखा के पार मोशन क्लिप रिकॉर्ड करता है: चित्र के बदलने का %@। पूरे चित्र की गिनती होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
