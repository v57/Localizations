        "dv" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "ގެއްލިފައިވާ ނުވަތަ ބަދަލުކުރެވިފައިވާ ޑިވައިސަކަށް. އޭގެ ކަނެކްޝަންތައް ބަންދުވެ، އޭގެ %lld ސާވިސް ކީ ބާތިލްކުރެވިއްޖެ، އޭގެ ގްރާންޓުތަކާއި ހަބް ނެޓްވާރކް ޕިއަރުން ނައްތާލައިފި، އަދި އެއް ދުވަހަކުވެސް ނޫން އަލުން އެޕްރޫވް ނުކުރެވޭނެ. އޭގެ ދަށުގައި އެޓޭޗްކުރެވިފައިވާ ކޮންމެ ޑިވައިސެއްވެސް ބާތިލްކުރެވިއްޖެ."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "ގެއްލިފައިވާ ނުވަތަ ބަދަލުކުރެވިފައިވާ ޑިވައިސަކަށް. އޭގެ ކަނެކްޝަންތައް ބަންދުވެ، އޭގެ %lld ސާވިސް ކީތައް ބާތިލްކުރެވިއްޖެ، އޭގެ ގްރާންޓުތަކާއި ހަބް ނެޓްވާރކް ޕިއަރުން ނައްތާލައިފި، އަދި އެއް ދުވަހަކުވެސް ނޫން އަލުން އެޕްރޫވް ނުކުރެވޭނެ. އޭގެ ދަށުގައި އެޓޭޗްކުރެވިފައިވާ ކޮންމެ ޑިވައިސެއްވެސް ބާތިލްކުރެވިއްޖެ."
                }
              }
            }
          }
        },
