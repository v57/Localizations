          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-ലെ കോർഡിനേറ്റർ ഈ ഉപകരണം സമയത്ത് സ്ഥിരീകരിച്ചില്ല. അത് പ്രവർത്തിക്കുന്നുണ്ടെന്നും എത്തിപ്പെടാനാകുമെന്നും പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
