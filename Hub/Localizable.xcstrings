        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هەر ئامێرێک کە کلیلێکی هەبێت دەتوانێت پەیوەست بێت و داوای API بکات. کاتێک چالاکە، تەنها ئامێرە متمانەپێکراوەکان پەیوەست دەبن؛ ئەوانی تر ڕەتدەکرێنەوە هەتا متمانەیان پێ دەکەیت."
