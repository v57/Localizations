        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ iznosi oko %@. Prijenos uživo troši podatke samo dok netko gleda. Isječci pretpostavljaju %@ kretanja dnevno (zadnjih 7 dana)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ körülbelül %@. Az élő nézet csak akkor használ adatot, amíg valaki nézi. A klipek napi %@ mozgást feltételeznek (az elmúlt 7 nap alapján)."
