    "Service is using newer interface. Some elements will not be displayed properly" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الخدمة تستخدم واجهة أحدث. قد لا يتم عرض بعض العناصر بشكل صحيح"
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الخدمة تستخدم واجهة أجدد. بعض العناصر ما بتنعرض زين."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সেৱাই নতুন ইণ্টাৰফে’চ ব্যৱহাৰ কৰি আছে। কিছুমান উপাদান সঠিকভাৱে দেখা নাযাব"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xidmət daha yeni interfeysdən istifadə edir. Bəzi elementlər düzgün göstərilməyəcək"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сэрвіс выкарыстоўвае навейшы інтэрфейс. Некаторыя элементы будуць адлюстроўвацца няправільна"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Услугата използва по-нов интерфейс. Някои елементи няма да се покажат правилно"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পরিষেবাটি নতুন ইন্টারফেস ব্যবহার করছে। কিছু উপাদান সঠিকভাবে প্রদর্শিত হবে না"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཞབས་ཞུས་འདྲ་མིན་གསར་པ་བེད་སྤྱོད་བྱེད་བཞིན། ཆ་ཤས་ཁ་ཤས་ཡག་པོ་མི་སྟོན།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सार्भिसआ गोदान इन्टारफेस बाहायगासिनो। माखासे बेसादफोरा मोजाङै दिन्थिनाय नङा"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El servei utilitza una interfície més nova. Alguns elements no es mostraran correctament"
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎠᎵᏍᏙᏗ ᎢᏤ ᎠᏓᏅᏙ ᎠᏫᏒᎢ. ᎢᎦᏛ ᏧᏓᎴᏅᏓ ᎥᏝ ᎣᏏ ᎠᎦᏔᎲᎢ"
          }
        },
        "ckb" : {
