        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই হাব এর কী-এর বিপরীতে যাচাই করে এমন কোনো নিরাপত্তা কোড দেয় না, তাই এই অনুরোধ আপনার ডিভাইস থেকে এসেছে তা কিছুই দেখায় না। হাবে পৌঁছাতে পারে এমন যে কেউ যেকোনো নামে যোগ দিতে চাইতে পারে, এবং অনুমোদিত ডিভাইস হাব যা শেয়ার করে তা ব্যবহার করতে পারে। কেবল তখনই অনুমোদন করুন যদি আপনি এইমাত্র নিজের ডিভাইস থেকে চেয়ে থাকেন এবং অন্য কেউ হতে না পারে।"
