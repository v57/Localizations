    "Valid until %@, once. In the Hub app on the other device, open **Connect to a Hub** and enter %@ and this code, or scan the code below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "صالح حتى %@، لمرة واحدة. في تطبيق Hub على الجهاز الآخر، افتح **الاتصال بـ Hub** وأدخل %@ وهذا الرمز، أو امسح الرمز أدناه."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "صالح لين %@، مرة وحدة. في تطبيق Hub على الجهاز الثاني، افتح **Connect to a Hub** وأدخل %@ وهالكود، أو امسح الكود اللي تحت."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ লৈকে বৈধ, এবাৰ। আন ডিভাইচত Hub এপত **Connect to a Hub** খোলক আৰু %@ আৰু এই ক’ডটো দিয়ক, বা তলৰ ক’ডটো স্কেন কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-dək bir dəfə keçərlidir. Digər cihazda Hub proqramında **Hub-a Qoşul**-u aç və %@ ilə bu kodu daxil et və ya aşağıdakı kodu skan et."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дзейнічае да %@, адзін раз. У праграме Hub на іншай прыладзе адкрыйце **Connect to a Hub** і ўвядзіце %@ і гэты код або адскануйце код ніжэй."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Валидно до %@, веднъж. В приложението Hub на другото устройство отворете **Свързване с хъб** и въведете %@ и този код или сканирайте кода по-долу."
          }
        },
        "bn" : {
          "stringUnit" : {
