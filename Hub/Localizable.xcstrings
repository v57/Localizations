        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اتھ چالوٗ کرِو تاکہِ تۄہہِ پنٕنِن بیٚیِن ڈیوائسَن تام یِتھہٕ کانٛہہ رَسِو، تہٕ تِم یِمِس تام رَسَن۔"
