            "value" : "%@ آن لائن آهي، پر جن نيٽورڪن تي توهان ٻئي آهيو اهي هب کي ٻنهي ڊوائيسز کي ڳنڍڻ نه ٿيون ڏين. عام طور تي جڏهن ڪا ڊوائيس وائي فائي تبديل ڪري ٿي ته ٻيهر ڪم ڪري ٿو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ සබැඳියි, නමුත් ඔබ දෙදෙනාම සිටින ජාල Hub හට උපාංග දෙක සම්බන්ධ කිරීමට ඉඩ නොදේ. සාමාන්‍යයෙන් එක් උපාංගයක් Wi-Fi වෙනස් කළ පසු එය නැවත ක්‍රියා කරයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ je online, ale siete, v ktorých ste obaja, nedovolia Hubu prepojiť tieto dve zariadenia. Zvyčajne to znova funguje, keď jedno zo zariadení zmení Wi-Fi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ je na spletu, vendar omrežji, v katerih sta obe napravi, Hubu ne dovolita povezati naprav. Običajno spet deluje, ko ena od naprav zamenja Wi-Fi."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ është në linjë, por rrjetet ku jeni të dy nuk lejojnë që Hub të lidhë dy pajisjet. Zakonisht funksionon sërish sapo njëra nga pajisjet ndryshon Wi-Fi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ je na mreži, ali mreže na kojima ste ne dozvoljavaju Hub-u da poveže ta dva uređaja. Obično ponovo proradi kada bilo koji uređaj promeni Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ är online, men nätverken ni båda är på tillåter inte Hub att ansluta de två enheterna. Det fungerar vanligtvis igen när någon av enheterna byter Wi-Fi."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ iko mtandaoni, lakini mitandao mliopo nyote hairuhusu Hub kuunganisha vifaa hivyo viwili. Kawaida inafanya kazi tena kifaa kimoja kinapobadilisha Wi-Fi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ஆன்லைனில் உள்ளது, ஆனால் நீங்கள் இருவரும் இருக்கும் நெட்வொர்க்குகள் Hub இரு சாதனங்களையும் இணைக்க அனுமதிக்கவில்லை. ஏதேனும் ஒரு சாதனம் Wi-Fi மாற்றியவுடன் வழக்கமாக மீண்டும் செயல்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ఆన్‌లైన్‌లో ఉంది, కానీ మీరిద్దరూ ఉన్న నెట్‌వర్క్‌లు Hub రెండు పరికరాలను కనెక్ట్ చేయనివ్వవు. ఏదైనా పరికరం Wi-Fi మార్చిన తర్వాత సాధారణంగా మళ్లీ పనిచేస్తుంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ онлайн аст, аммо шабакаҳое, ки ҳардуи шумо дар он ҳастед, ба Hub иҷозат намедиҳанд, ки ин ду дастгоҳро пайваст кунад. Одатан пас аз иваз шудани Wi-Fi дар яке аз дастгоҳҳо дубора кор мекунад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ออนไลน์อยู่ แต่เครือข่ายที่คุณทั้งสองใช้อยู่ไม่อนุญาตให้ Hub เชื่อมต่ออุปกรณ์ทั้งสอง โดยปกติจะกลับมาใช้งานได้เมื่ออุปกรณ์ใดอุปกรณ์หนึ่งเปลี่ยน Wi-Fi"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ onlaýn, ýöne ikisiňiziň toryňyz Hub-a iki enjamy biriktirmäge rugsat bermeýär. Enjamlaryň biri Wi-Fi-ny üýtgedeninden soň köplenç ýene işleýär."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "’Oku online ’a %@, ka ’oku ’ikai tuku ’e he netiueka ’oku mou ’i ai ke fekhokotaki ’e Hub e me’angāue ’e ua. ’Oku toe ngāue ’i he taimi ’oku liliu ai e Wi-Fi ’a ha taha."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ çevrimiçi, ancak bağlı olduğunuz ağlar Hub’ın iki aygıtı bağlamasına izin vermiyor. Aygıtlardan biri Wi-Fi değiştirince genellikle yeniden çalışır."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ توردا، لېكىن سىلەر ئىككەيلەن تور Hub نىڭ ئىككى ئۈسكۈنىنى باغلىشىغا يول قويمايدۇ. ئىككى ئۈسكۈنىنىڭ بىرى Wi-Fi ئالماشتۇرغاندا ئادەتتە ئەسلىگە كېلىدۇ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ онлайн, але мережі, у яких ви обоє перебуваєте, не дають Хабу з’єднати ці два пристрої. Зазвичай усе знову працює, щойно будь-який із пристроїв змінює мережу Wi-Fi."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ آن لائن ہے، لیکن جن نیٹ ورکس پر آپ دونوں ہیں وہ Hub کو دونوں ڈیوائسز کو کنیکٹ نہیں کرنے دیتے۔ عام طور پر کسی بھی ڈیوائس کا Wi-Fi بدلنے پر دوبارہ کام کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ đang trực tuyến, nhưng các mạng mà cả hai thiết bị đang dùng không cho phép Hub kết nối hai thiết bị. Thường sẽ hoạt động trở lại khi một trong hai thiết bị đổi Wi-Fi."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 在線，但你哋雙方所在嘅網絡唔容許 Hub 連接呢兩部裝置。當其中一部裝置轉換 Wi-Fi，通常就會恢復正常。"
          }
        },
