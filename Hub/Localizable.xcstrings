    "%@ is online, but the networks you’re both on won’t let Hub connect the two devices. It usually works again once either device changes Wi-Fi." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ متصل، لكن الشبكتين اللتين تتصلان بهما لا تسمحان لـ Hub بتوصيل الجهازين. يعمل عادةً مجددًا بمجرد أن يغيّر أي من الجهازين شبكة Wi-Fi."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ متصل، بس الشبكتين اللي أنتم عليها ما تسمح لـ Hub يوصل الجهازين. غالبًا يرجع يشتغل إذا غيّر أي جهاز الواي فاي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ অনলাইন আছে, কিন্তু আপোনালোক দুয়ো থকা নেটৱৰ্কবোৰে Hub-ক ডিভাইচ দুটা সংযোগ কৰিবলৈ নিদিয়ে। যিকোনো এটা ডিভাইচে Wi-Fi সলনি কৰিলে সাধাৰণতে পুনৰ কাম কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ onlayndır, lakin hər ikinizin qoşulduğunuz şəbəkələr Hub-a bu iki cihazı birləşdirməyə imkan vermir. Adətən cihazlardan biri Wi-Fi-ı dəyişdikdə yenidən işləyir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ у сетцы, але сеткі, у якіх вы абодва знаходзіцеся, не дазваляюць Hub злучыць дзве прылады. Звычайна гэта зноў працуе, калі любая з прылад зменіць Wi-Fi."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ е на линия, но мрежите, в които сте и двамата, не позволяват на Hub да свърже двете устройства. Обикновено отново заработва, след като някое устройство смени Wi-Fi."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ অনলাইন আছে, কিন্তু আপনারা দুজন যে নেটওয়ার্কে আছেন তা Hub-কে ডিভাইস দুটি সংযুক্ত করতে দিচ্ছে না। যেকোনো একটি ডিভাইস Wi-Fi বদলালে সাধারণত আবার কাজ করে।"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@आ अनलाइन दं, नाथाय नोंसोर सानैनि नेटवार्कआ हबखौ मोन्नै डिभाइसखौ कनेक्ट खालामनो होआ। जेब्ला जाहाते मोनसेबो डिभाइसआ वाइ-फाइ सोलायो अब्ला बेयो गोबाङै फिन मावफुंफिनो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ està en línia, però les xarxes on sou tots dos no permeten que Hub connecti els dos dispositius. Normalment torna a funcionar quan algun dels dispositius canvia de Wi-Fi."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ᎠᎭ, ᎠᏎ ᏄᏓᎴᏅᏓ ᎢᏍᏗ ᎠᎴ ᎾᏍᎩ ᎥᏝ Hub ᏧᏓᎴᏅᏓ ᏗᏔᎴᏍᏗ. Wi-Fi ᎤᏛᏅ ᎢᏳᏃ ᎢᏤ ᎣᏍᏛ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ئۆنلاینە، بەڵام ئەو تۆڕانەی کە هەردووکتان لەسەریتان ڕێگە نادەن Hub هەردوو ئامێرەکە پێکەوە ببەستێت. بەزۆری جارێکی تر کاردەکات کاتێک هەر ئامێرێک Wi-Fi بگۆڕێت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ je online, ale sítě, ve kterých jste oba, nedovolí Hubu propojit obě zařízení. Obvykle to zase funguje, jakmile některé zařízení změní Wi-Fi."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae %@ ar-lein, ond ni fydd y rhwydweithiau rydych chi’ch dau arnynt yn gadael i Hub gysylltu’r ddwy ddyfais. Mae fel arfer yn gweithio eto unwaith y bydd unrhyw ddyfais yn newid Wi-Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ er online, men de netværk, I begge er på, tillader ikke Hub at forbinde de to enheder. Det virker som regel igen, når en af enhederne skifter Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist online, aber die Netzwerke, in denen ihr beide seid, lassen nicht zu, dass Hub die beiden Geräte verbindet. Meist funktioniert es wieder, sobald eines der Geräte das WLAN wechselt."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ऑनलाइन है, पर जिनें नेटवर्कें पर तुस दोनें ओ ओह् Hub गी दोनें डिवाइसें गी जोड़ने नेईं देंदे। आमतौर पर जदूं कोई इक डिवाइस वाई-फाई बदलदा है तां फिरी कम्म करदा है।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ އޮންލައިންވެއްޖެ، ނަމަވެސް ތިޔަބޭފުޅާ ތިއްބަވާ ނެޓްވޯކްތަކުން ހަބްއަށް ދެ ޑިވައިސް ކަނެކްޓްކުރަން ނުދޭ. އާންމުކޮށް ދެ ޑިވައިސްކުރެ ކޮންމެ ޑިވައިސެއް ވައި-ފައި ބަދަލުކުރުމުން އަލުން މަސައްކަތްކުރޭ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το %@ είναι σε σύνδεση, αλλά τα δίκτυα στα οποία είστε και οι δύο δεν επιτρέπουν στο Hub να συνδέσει τις δύο συσκευές. Συνήθως λειτουργεί ξανά μόλις κάποια συσκευή αλλάξει Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está en línea, pero las redes a las que están conectados no permiten que Hub conecte ambos dispositivos. Normalmente vuelve a funcionar cuando alguno cambia de Wi-Fi."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ on võrgus, kuid võrgud, milles te mõlemad olete, ei luba Hubil neid kahte seadet ühendada. Tavaliselt hakkab see uuesti tööle, kui kumbki seade vahetab Wi-Fi-t."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ آنلاین است، اما شبکه‌هایی که هر دوی شما در آن هستید اجازه نمی‌دهند هاب دو دستگاه را متصل کند. معمولاً وقتی هر یک از دستگاه‌ها Wi-Fi را عوض کند دوباره کار می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ on verkossa, mutta verkot, joissa molemmat olette, eivät anna Hubin yhdistää laitteita. Yleensä se toimii taas, kun jompikumpi laite vaihtaa Wi-Fiä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Online ang %@, pero hindi pinapayagan ng mga network ninyong pareho na ikonekta ng Hub ang dalawang device. Karaniwang gumagana ulit kapag nagpalit ng Wi-Fi ang alinmang device."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ er á netinum, men netini, tit bæði eru á, lata ikki Hub tengja báðar eindirnar. Tað virkar vanliga aftur, tá onnur eindin skiftir Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ est en ligne, mais les réseaux sur lesquels vous êtes tous les deux ne laissent pas Hub connecter les deux appareils. Cela refonctionne généralement dès que l’un des appareils change de Wi-Fi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tá %@ ar líne, ach ní ligfidh na líonraí ina bhfuil sibh araon do Hub an dá ghléas a nascadh. Oibríonn sé arís de ghnáth a luaithe a athraíonn ceachtar gléas Wi-Fi."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ઑનલાઇન છે, પરંતુ તમે બંને જે નેટવર્ક પર છો તે Hub ને બંને ડિવાઇસને જોડવા દેશે નહીં. સામાન્ય રીતે કોઈપણ ડિવાઇસ Wi-Fi બદલે એટલે ફરી કામ કરે છે."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aia %@ ma ka pūnaewele, akā ʻaʻole ʻae nā pūnaewele e hoʻopili ʻo Hub i nā mea ʻelua. Hana hou ia ke hoʻololi kekahi mea i ka Wi-Fi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ מקוון, אבל הרשתות ששניכם נמצאים בהן לא מאפשרות ל‑Hub לחבר בין שני המכשירים. זה בדרך כלל עובד שוב ברגע שאחד המכשירים מחליף Wi-Fi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ऑनलाइन है, लेकिन जिन नेटवर्कों पर आप दोनों हैं वे Hub को दोनों डिवाइस कनेक्ट नहीं करने देंगे। आमतौर पर किसी भी डिवाइस का Wi-Fi बदलते ही यह फिर से काम करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ je na mreži, ali mreže na kojima ste oboje ne dopuštaju Hubu da poveže ta dva uređaja. Obično ponovno proradi kada bilo koji uređaj promijeni Wi-Fi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ online van, de a hálózatok, amelyeken mindketten vagytok, nem engedik, hogy a Hub összekapcsolja a két eszközt. Általában újra működik, ha valamelyik eszköz Wi-Fi-t vált."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ առցանց է, բայց ցանցերը, որոնց երկուսդ միացած եք, թույլ չեն տալիս Hub-ին միացնել երկու սարքերը։ Սովորաբար նորից աշխատում է, երբ սարքերից որևէ մեկը փոխում է Wi-Fi-ը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sedang online, tetapi jaringan yang Anda berdua gunakan tidak mengizinkan Hub menghubungkan kedua perangkat. Biasanya berfungsi lagi setelah salah satu perangkat berganti Wi-Fi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ er á netinu, en netin sem þið eruð bæði á leyfa Hub ekki að tengja tækin tvö. Það lagast yfirleitt þegar annað tækið skiptir um Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ è online, ma le reti a cui siete entrambi connessi non permettono a Hub di collegare i due dispositivi. Di solito funziona di nuovo quando uno dei due dispositivi cambia Wi-Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ はオンラインですが、お互いのネットワークが Hub による2台のデバイス間の接続を許可していません。いずれかのデバイスが Wi-Fi を切り替えると通常は再び動作します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ონლაინ არის, მაგრამ ქსელები, რომლებზეც ორივე ხართ, არ აძლევს Hub-ს ორი მოწყობილობის დაკავშირების საშუალებას. ჩვეულებრივ ისევ მუშაობს, როგორც კი რომელიმე მოწყობილობა Wi-Fi-ს შეცვლის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ желіде, бірақ екеуіңіз қосылған желілер Hub-қа екі құрылғыны қосуға мүмкіндік бермейді. Әдетте құрылғылардың бірі Wi-Fi ауыстырғаннан кейін қайта жұмыс істейді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ កំពុងអនឡាញ ប៉ុន្តែបណ្តាញដែលអ្នកទាំងពីរប្រើមិនអនុញ្ញាតឱ្យ Hub ភ្ជាប់ឧបករណ៍ទាំងពីរ។ ជាធម្មតាវាដំណើរការម្តងទៀតនៅពេលឧបករណ៍ណាមួយប្តូរ Wi-Fi។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ಆನ್‌ಲೈನ್ ಆಗಿದೆ, ಆದರೆ ನೀವಿಬ್ಬರೂ ಇರುವ ನೆಟ್‌ವರ್ಕ್‌ಗಳು Hub ಎರಡು ಸಾಧನಗಳನ್ನು ಸಂಪರ್ಕಿಸಲು ಬಿಡುವುದಿಲ್ಲ. ಯಾವುದೇ ಒಂದು ಸಾಧನ Wi-Fi ಬದಲಾಯಿಸಿದ ನಂತರ ಸಾಮಾನ್ಯವಾಗಿ ಮತ್ತೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@은(는) 온라인이지만, 양쪽 네트워크에서 Hub가 두 기기를 연결하도록 허용하지 않습니다. 어느 한 기기가 Wi-Fi를 변경하면 보통 다시 작동합니다."
          }
        },
        "kok" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ऑनलाइन आसा, पूण तुमी दोगूय आसात तीं नेटवर्कां दोनूय डिव्हायसां जोडूंक Hub क दिवनात. एकादें डिव्हायस Wi-Fi बदलतकचें तें परतून काम करता."
          }
        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ آن لائن چھُ، مگر یِم نیٹ ورک یِمَن پؠٹھ تۄہہِ دۄشوے چھِوو چھِنَہ Hub دۄن ڈیوائسن جُڑنہٕ دِوان۔ عام طور پٲٹھؠ چھُ یہ بیٚیہِ کٲم کَران ییٚلہِ کانٛہہ ڈیوائس وائی فائی بدلاوان۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ serhêl e, lê torên ku hûn her du lê ne nahêlin Hub her du amûran girê bide. Bi gelemperî dema yek ji amûran Wi-Fi-yê biguherîne dîsa dixebite."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ онлайн, бирок экөөңөр турган тармактар Hub'га эки түзмөкти туташтырууга уруксат бербей жатат. Адатта түзмөктөрдүн бири Wi-Fi'ды алмаштырганда кайра иштейт."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ອອນລາຍຢູ່, ແຕ່ເຄືອຂ່າຍທີ່ທ່ານທັງສອງໃຊ້ບໍ່ອະນຸຍາດໃຫ້ Hub ເຊື່ອມຕໍ່ອຸປະກອນທັງສອງ. ໂດຍປົກກະຕິຈະກັບມາໃຊ້ໄດ້ເມື່ອອຸປະກອນໃດໜຶ່ງປ່ຽນ Wi-Fi."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ prisijungęs, bet tinklai, kuriuose esate abu, neleidžia „Hub“ sujungti abiejų įrenginių. Paprastai vėl veikia, kai vienas iš įrenginių pakeičia „Wi-Fi“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ir tiešsaistē, bet tīkli, kuros esat abi, neļauj Hub savienot abas ierīces. Parasti tas atkal darbojas, kad kāda no ierīcēm maina Wi-Fi."
          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ऑनलाइन अछि, मुदा अहाँ दूनू जाहि नेटवर्क पर छी से हब केँ दूनू डिवाइस जोड़ऽ नहि देत। प्रायः कोनो एक डिवाइस वाइ-फाइ बदले पर फेर काम करैत अछि।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kei te tuihono a %@, engari kāore ngā whatunga e noho ana kōrua e tuku i a Hub ki te hono i ngā pūrere e rua. Ka mahi anō ina huri Wi-Fi tētahi pūrere."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ е онлајн, но мрежите на кои сте обајцата не дозволуваат Hub да ги поврзе двата уреди. Обично повторно проработува кога едниот уред ќе ја смени Wi-Fi мрежата."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ഓൺലൈനാണ്, പക്ഷേ നിങ്ങൾ രണ്ടുപേരും ഉള്ള നെറ്റ്‌വർക്കുകൾ Hub-ന് രണ്ട് ഉപകരണങ്ങളും ബന്ധിപ്പിക്കാൻ അനുവദിക്കില്ല. ഏതെങ്കിലും ഉപകരണം വൈ-ഫൈ മാറ്റിയാൽ സാധാരണ വീണ്ടും പ്രവർത്തിക്കും."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ онлайн байна, гэхдээ та хоёрын байгаа сүлжээнүүд Hub-г хоёр төхөөрөмжийг холбохыг зөвшөөрөхгүй байна. Аль нэг төхөөрөмж Wi-Fi-гээ солиход ихэвчлэн дахин ажилладаг."
          }
        }
      }
    },
