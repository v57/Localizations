        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اِتھے کالَس باپتھ کُنہٕ کی بورڈ یا ماؤس نہٕ۔ لاک یا سُتٕ گِنزان سٟتؠ۔"
