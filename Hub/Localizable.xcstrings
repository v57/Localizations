        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ако %@ спре да отговаря"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যদি %@ উত্তর দেওয়া বন্ধ করে"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ལན་མི་འདེབས་ཚེ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जुदि %@आ फिन खोनासं होयाब्ला"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si %@ deixa de respondre"
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎢᏳᏃ %@ ᎥᏝ ᏴᏛᏛᎢ"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ئەگەر %@ وەڵام نەداتەوە"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokud %@ přestane odpovídat"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os bydd %@ yn stopio ateb"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvis %@ holder op med at svare"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn %@ nicht mehr antwortet"
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जे %@ जवाब देना बंद करी देए"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ޖަވާބުދިނުން ހުއްޓާލައިފިނަމަ"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αν το %@ σταματήσει να απαντά"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si %@ deja de responder"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kui %@ ei vasta enam"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اگر %@ پاسخ ندهد"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jos %@ lakkaa vastaamasta"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kung huminto sa pagsagot ang %@"
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um %@ steðgar at svara"
