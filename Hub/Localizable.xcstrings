    "The hub can’t hand it over yet. Copy it from the camera’s settings on its device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن لـ Hub تسليمه بعد. انسخه من إعدادات الكاميرا على جهازها."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الـ Hub ما يقدر يسلّمه الحين. انسخه من إعدادات الكاميرا على جهازها."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hubটোৱে এতিয়াও ইয়াক হস্তান্তৰ কৰিব নোৱাৰে। ইয়াৰ ডিভাইচত কেমেৰাৰ ছেটিংছৰ পৰা কপি কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub onu hələ ötürə bilmir. Onu öz cihazındakı kamera parametrlərindən kopyala."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хаб пакуль не можа яго перадаць. Скапіюйце яго з налад камеры на яе прыладзе."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хъбът все още не може да го предаде. Копирайте го от настройките на камерата на нейното устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হাব এখনও এটি হস্তান্তর করতে পারছে না। এর ডিভাইসে ক্যামেরার সেটিংস থেকে এটি কপি করুন।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "hub ས་ད་དུང་སྤྲོད་མི་ཐུབ། དེའི་སྒྲིག་ཆས་སྟེང་པར་ལེན་སྒྲིག་འགོད་ནས་འདྲ་བཤུས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "hubआ दानो बेखौ गथायनो हायाखै। बेनि डिभाइसआवनि क्यामेरा सेटिंनिफ्राय बेखौ कपी खालाम।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El hub encara no el pot transferir. Copia'l des dels ajustos de la càmera al seu dispositiu."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎦᏚᎲ ᎥᏝ ᏴᎦᏔᎲ ᎢᏴᏛ ᎤᏪᏴᏔᏅ. ᎠᏓᏰᎸ ᎤᏤᎵ ᏗᎦᏔᏅ ᎢᏧᎳᎭ ᎠᏴ ᎠᎪᏩᏛ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هەبەکە هێشتا ناتوانێت بیگەیەنێت. لە ڕێکخستنەکانی کامێراکە لەسەر ئامێرەکەی کۆپی بکە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub ho zatím nemůže předat. Zkopírujte ho z nastavení kamery na jejím zařízení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ni all yr hyb ei drosglwyddo eto. Copïwch ef o osodiadau'r camera ar ei ddyfais."
