        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ما يشارك أي تطبيقات للحين. يقدر يوصل لأجهزتك وهي تقدر توصله."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-এ এতিয়াও কোনো এপ শ্বেয়াৰ কৰা নাই। ই আপোনাৰ ডিভাইচবোৰক যোগাযোগ কৰিব পাৰে, আৰু সিহঁতে ইয়াক যোগাযোগ কৰিব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hələ heç bir tətbiq paylaşmır. O, cihazlarınıza çata bilir və onlar da ona çata bilir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ пакуль не абагульвае дадаткаў. Яно можа звязацца з вашымі прыладамі, і яны могуць звязацца з ім."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ все още не споделя приложения. То може да достига устройствата ви и те могат да го достигат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ এখনও কোনো অ্যাপ শেয়ার করে না। এটি আপনার ডিভাইসগুলোতে পৌঁছাতে পারে, এবং সেগুলো এতে পৌঁছাতে পারে।"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@आ दासिमबो एपफोरखौ शेयार खालामाखै। बेयो नोंनि डिभाइसफोराव सौहैनो हायो, आरो बिसोरबो बेयाव सौहैनो हायो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ encara no comparteix cap app. Pot arribar als teus dispositius, i ells s'hi poden connectar."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ᎥᏝ ᎠᏆᏛᏗ ᏭᏥᏔᏅ. ᏂᎯ ᏗᏧᎦᏔᏅᎯ ᎠᎪᏩᏛ, ᎠᎴ ᎾᏍᎩ ᏂᎯ ᎠᎪᏩᏛ."
