        "doi" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "गुआचे जां कंप्रोमाइज़ कीते डिवाइस लेई। इसदे कनेक्शन बंद होई जंदे न, इसदी %lld सर्विस की रद्द कीती जंदी है, इसदीआं ग्रांटां ते हब नेटवर्क साथी हटाए जंदे न, ते इसगी कदे दुबारा मंजूर नेईं कीता जा सकदा। इसदे थल्ले जुड़या हर डिवाइस बी रद्द कीता जंदा है।"
                }
