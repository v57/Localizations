    "Hub checks only whether the %@ is in use; nothing about it leaves this %@. Viewers see that clips are paused." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتحقق Hub فقط مما إذا كان %@ قيد الاستخدام؛ ولا يغادر أي شيء عنه هذا %@. يرى المشاهدون أن المقاطع متوقفة مؤقتًا."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub يتأكد بس إذا %@ قيد الاستخدام؛ ولا شي عنه يطلع من %@ هذا. المشاهدين يشوفون إن المقاطع موقفة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub-এ কেৱল %@ ব্যৱহাৰত আছে নে নাই সেয়া পৰীক্ষা কৰে; ইয়াৰ বিষয়ে একো এই %@-ৰ পৰা বাহিৰলৈ নাযায়। দৰ্শকে ক্লিপবোৰ বিৰতি হৈ থকা দেখে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub yalnız %@-nin istifadədə olub-olmadığını yoxlayır; bu barədə heç nə bu %@-dən kənara çıxmır. İzləyicilər kliplərin dayandırıldığını görür."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хаб правярае толькі, ці выкарыстоўваецца %@; нічога пра гэта не пакідае гэты %@. Гледачы бачаць, што кліпы прыпыненыя."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub проверява само дали %@ се използва; нищо за него не напуска това %@. Зрителите виждат, че клиповете са на пауза."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হাব শুধু %@টি ব্যবহার হচ্ছে কি না তা পরীক্ষা করে; এ সম্পর্কে কিছুই এই %@ ছেড়ে যায় না। দর্শকরা দেখে যে ক্লিপগুলো বিরত আছে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub ཡིས་ %@ བེད་སྤྱོད་བྱེད་མིན་ཁོ་ན་བརྟག དེའི་སྐོར་ %@ འདི་ལས་ཕྱིར་མི་འགྲོ། ལྟ་མཁན་གྱིས་གཟུགས་ཐུང་མཚམས་བཞག་མཐོང་།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hubआ %@ बाहायगासिनो दं ना बेखौल' नायो; बेनि बागै जेबो बे %@निफ्राय ओंखारो। नायग्राफोरा क्लिपफोरा पज जानायखौ नुगोन।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub només comprova si el %@ està en ús; res no surt d'aquest %@. Els espectadors veuen que els clips estan en pausa."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub ᎠᎦᏔᎲ %@ ᎢᏳᏃ ᎠᏛᏒ; ᎥᏝ ᎪᏪᎸ ᎤᎶᏐᏅ ᎯᎠ %@. ᏗᎦᏃᎸ ᎠᏂᎪᏩ ᎩᎵᏈ ᎠᎶᎯᏍᏗ ᎨᏒ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub تەنها پشکنین دەکات ئایا %@ ـەکە لە بەکارهێناندایە؛ هیچ زانیارییەک لەم %@ ـە ناچێتە دەرەوە. بینەران دەبینن کە کلیپەکان وەستاون."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub pouze kontroluje, zda se %@ používá; nic o něm neopouští toto %@. Diváci vidí, že klipy jsou pozastavené."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae Hub yn gwirio’n unig a yw’r %@ yn cael ei ddefnyddio; does dim amdano’n gadael y %@ hwn. Mae gwylwyr yn gweld bod clipiau wedi’u hoedi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub kontrollerer kun, om %@ er i brug; intet om den forlader denne %@. Seere kan se, at klip er sat på pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub prüft nur, ob das %@ verwendet wird; nichts darüber verlässt dieses %@. Zuschauer sehen, dass Clips pausiert sind."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हब सिर्फ एह् जांचदा है जे %@ बर्तों च है या नेईं; इस बारे च किश बी इस %@ थमां बाहर नेईं जंदा। दिखने आले दिखदे न जे क्लिप रोके गए न।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub ޗެކްކުރާނީ %@ ބޭނުންކުރެވެމުންދޭތޯ އެކަނި; އެއާބެހޭ އެއްވެސް އެއްޗެއް މި %@ އިން ބޭރަށް ނުދޭ. ބަލާ މީހުންނަށް ފެންނާނީ ކްލިޕްތައް ޕޯޒްކުރެވިފައިވާކަން."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Hub ελέγχει μόνο αν το %@ χρησιμοποιείται· τίποτα σχετικά δεν φεύγει από αυτό το %@. Οι θεατές βλέπουν ότι τα κλιπ είναι σε παύση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub solo comprueba si el %@ está en uso; nada de eso sale de este %@. Los espectadores ven que los clips están en pausa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub kontrollib ainult, kas %@ on kasutusel; midagi selle kohta ei lahku sellest %@-st. Vaatajad näevad, et klipid on peatatud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هاب فقط بررسی می‌کند که آیا %@ در حال استفاده است؛ چیزی درباره آن از این %@ خارج نمی‌شود. بینندگان می‌بینند که کلیپ‌ها متوقف شده‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub tarkistaa vain, onko %@ käytössä; siitä ei lähde mitään tältä %@. Katselijat näkevät, että klipit ovat tauotettuina."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sinusuri lang ng Hub kung ginagamit ang %@; walang lumalabas mula sa %@ na ito tungkol dito. Nakikita ng mga viewer na naka-pause ang mga clip."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub kannar bert um %@ er í nýtslu; einki um tað fer úr hesum %@. Hyggjarar síggja at klipp eru á steðgi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub vérifie seulement si le %@ est utilisé ; rien à son sujet ne quitte ce %@. Les spectateurs voient que les clips sont en pause."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ní sheiceálann Hub ach an bhfuil an %@ in úsáid; ní fhágann aon rud faoi an %@ seo. Feiceann lucht féachana go bhfuil na gearrthóga ar sos."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub ફક્ત %@ ઉપયોગમાં છે કે નહીં તે તપાસે છે; તેના વિશે કંઈ આ %@ છોડતું નથી. જોનારાઓ જુએ છે કે ક્લિપ થોભાવેલી છે."
