        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ އަށް ވެލިޑް، އެއްފަހަރު. އަނެއް ޑިވައިސްގައި Hub އެޕްގައި **Connect to a Hub** ހުޅުވައި %@ އަދި މި ކޯޑް ޖަހޭ، ނުވަތަ ތިރީގައިވާ ކޯޑް ސްކޭންކުރޭ."
