    "check its safety code %@ on the device" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تحقق من رمز الأمان %@ على الجهاز"
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تأكد من كود الأمان %@ على الجهاز"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ডিভাইচটোত ইয়াৰ সুৰক্ষা ক’ড %@ পৰীক্ষা কৰক"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cihazda onun təhlükəsizlik kodu %@-nu yoxla"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "праверце яго код бяспекі %@ на прыладзе"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "проверете кода му за сигурност %@ на устройството"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ডিভাইসে এর নিরাপত্তা কোড %@ পরীক্ষা করুন"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "སྒྲིག་ཆས་སྟེང་དེའི་བདེ་འཇགས་ཨང་རྟགས་ %@ བལྟ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "डिभाइसआव बेनि रैखाथि कोड %@खौ नाय"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "comprova el seu codi de seguretat %@ al dispositiu"
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎤᏤᎵ ᎠᎵᏍᏕᎸᏗ ᏗᎧᏃᎲᏍᏗ %@ ᎠᏓᏰᎸ ᎬᏩᎶᏒ ᏥᏭᎦᏔᏅ"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کۆدی سەلامەتی %@ بپشکنە لەسەر ئامێرەکە"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "zkontrolujte jeho bezpečnostní kód %@ na zařízení"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "gwiriwch ei god diogelwch %@ ar y ddyfais"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tjek dens sikkerhedskode %@ på enheden"
