            "value" : "ޑިވައިސްގައި އޭގެ ސޭފްޓީ ކޯޑް %@ ޗެކްކުރޭ"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ελέγξτε τον κωδικό ασφαλείας του %@ στη συσκευή"
