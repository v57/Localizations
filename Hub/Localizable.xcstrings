        "sa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "भवतः यन्त्राणां कृते व्यक्तिगतं जालम्: तानि परस्परं प्रत्यक्षं सुरक्षितं च प्राप्नुवन्ति, गृहे वा दूरे। प्रथमवारं Hub VPN विन्यासं योजयितुं पृच्छति।"
