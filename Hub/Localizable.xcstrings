        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ушунча убакыт клавиатура же чычкан жок. Кулпуланган же уктап жаткан дароо эсептелет."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ບໍ່ມີການໃຊ້ຄີບອດ ຫຼື ເມົ້າເປັນເວລາດົນເທົ່ານີ້. ການລັອກ ຫຼື ພັກນັບທັນທີ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Šiek tiek laiko be klaviatūros ar pelės. Užrakinta arba mieganti skaičiuojama iš karto."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tik ilgi nav tastatūras vai peles. Bloķēšana vai miegs tiek ieskaitīti uzreiz."
          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एतेक काल धरि कोनो कीबोर्ड वा माउस नहि। लॉक्ड वा सुतल तुरंत गिनल जाइत अछि।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kāore he papapātuhi, kiore rānei mō tēnei roa. Ka tatauhia te maukati, moe rānei i te wā kotahi."
