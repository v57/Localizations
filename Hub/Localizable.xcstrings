        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ ئەم %@ وەک ئامێرێکی نوێ دەبینێتەوە، و خاوەنێک دووبارە پەسەندی دەکات."
