        },
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ හි උපාංගවලට පමණක් සම්බන්ධ විය හැකිය. වෙන කිසිවෙකු හරහා කිසිවක් නොයයි."
