        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le Mac qui exécute %@ est peut-être en veille ou hors ligne. Réessayez quand il sera allumé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
