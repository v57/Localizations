        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Գծից անցնող շարժումը ձայնագրում է հոլովակ. պատկերի %@-ի փոփոխություն։ Հաշվվում է ամբողջ պատկերը։"
