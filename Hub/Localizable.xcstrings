        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ચલાવતો Mac સ્લીપમાં કે ઑફલાઇન હોઈ શકે છે. તે ચાલુ થાય પછી ફરી પ્રયાસ કરો."
