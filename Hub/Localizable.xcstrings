    "Motion past the line records a clip: %@ of the picture changing. All of the picture counts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الحركة بعد الخط تسجّل مقطعًا: %@ من الصورة يتغير. تُحتسب الصورة كلها."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الحركة بعد الخط تسجل مقطع: %@ من الصورة يتغير. الصورة كاملة محسوبة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ৰেখা পাৰ হোৱা গতিয়ে এটা ক্লিপ ৰেকৰ্ড কৰে: ছবিৰ %@ সলনি হোৱা। গোটেই ছবিখন গণনা কৰা হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xətti keçən hərəkət klip yazır: şəklin %@-i dəyişir. Şəklin hamısı sayılır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Рух за лініяй запісвае кліп: %@ змены выявы. Улічваецца ўся выява."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Движение след линията записва клип: %@ от картината се променя. Цялата картина се брои."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "লাইন পেরিয়ে মোশন ক্লিপ রেকর্ড করে: ছবির %@ পরিবর্তন। পুরো ছবি গণ্য হয়।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཐིག་ལས་བརྒལ་གཡོ་འགུལ་གཟུགས་ཐུང་བླངས། གཟུགས་ %@ འགྱུར། གཟུགས་ཡོངས་བརྩི།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लाइन बारलांनाय मोशना क्लिप रेकर्ड खालामो: सावगारि सोलायनायनि %@। गासै सावगारिया हिसाबआव लायो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El moviment més enllà de la línia enregistra un clip: %@ de la imatge canviant. Tota la imatge compta."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎠᏓᏅᏖᏛ ᎤᏍᏆᏂᎪᏔᏅ ᎩᎵᏈ ᎠᏓᏅᏙ: %@ ᎦᏬᏂᏍᎬ ᎤᏂᏍᏆᏂᎪᏔᏅ. ᏂᎦᎥ ᎦᏬᏂᏍᎬ ᏓᏆᏙᎥ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جووڵە لە هێڵەکە بەولاوە کلیپێک تۆمار دەکات: %@ ـی وێنەکە دەگۆڕدرێت. هەموو وێنەکە هەژمار دەکرێت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pohyb za čarou zaznamená klip: %@ obrazu se mění. Počítá se celý obraz."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae symudiad heibio’r llinell yn recordio clip: %@ o’r llun yn newid. Mae’r llun cyfan yn cyfrif."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bevægelse over stregen optager et klip: %@ af billedet ændrer sig. Hele billedet tæller."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bewegung hinter der Linie zeichnet einen Clip auf: %@ des Bildes ändert sich. Das ganze Bild zählt."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रेखा थमां परे गति क्लिप रिकॉर्ड करदी है: तस्वीर दे बदलने दा %@। सारी तस्वीर गिनी जंदी है।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ލައިން ފަހަނައަޅައި ހަރަކާތް ކްލިޕެއް ރެކޯޑްކުރޭ: ފޮޓޯ ބަދަލުވާ %@. މުޅި ފޮޓޯ ގުނާނެ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κίνηση πέρα από τη γραμμή καταγράφει κλιπ: %@ της εικόνας αλλάζει. Ολόκληρη η εικόνα μετρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El movimiento tras la línea graba un clip: %@ de la imagen cambiando. Cuenta toda la imagen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Joont ületav liikumine salvestab klipi: %@ pildi muutumisest. Kogu pilt läheb arvesse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حرکتِ فراتر از خط کلیپ ضبط می‌کند: %@ از تغییر تصویر. کل تصویر حساب می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Viivan ylittävä liike tallentaa klipin: %@ kuvan muuttumisesta. Koko kuva lasketaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ang galaw na lumagpas sa linya ay nagre-record ng clip: %@ ng larawan ang nagbabago. Lahat ng larawan ay binibilang."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rørsla um linjuna upptakir eitt klipp: %@ av myndini broytist. Øll myndin telur við."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un mouvement au-delà de la ligne enregistre un clip : %@ de l’image qui change. Toute l’image compte."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Taifeadann gluaiseacht thar an líne gearrthóg: %@ den phictiúr ag athrú. Áirítear an pictiúr ar fad."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "રેખા પાર ગતિ ક્લિપ રેકોર્ડ કરે છે: ચિત્રના %@ બદલાવાથી. આખું ચિત્ર ગણાય છે."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoʻopaʻa ka neʻe ma ʻō aku o ka laina i kilepa: %@ o ke kiʻi e loli ana. Helu ʻia ke kiʻi a pau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
