    "The Mac that runs %@ may be asleep or offline. Try again once it’s on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قد يكون الـ Mac الذي يشغّل %@ نائمًا أو غير متصل. حاول مجددًا عندما يعمل."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الماك اللي يشغّل %@ يمكن نايم أو مو متصل. حاول مرة ثانية إذا اشتغل."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ চলোৱা Macটো শুই থাকিব পাৰে বা অফলাইন হ’ব পাৰে। অন হ’লে পুনৰ চেষ্টা কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-nı işlədən Mac yatmış və ya oflayn ola bilər. O açılanda yenidən cəhd et."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac, на якім працуе %@, можа спаць або быць афлайн. Паспрабуйце зноў, калі ён уключыцца."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac-ът, който изпълнява %@, може да е заспал или офлайн. Опитайте отново, когато е включен."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যে Mac %@ চালায় সেটি ঘুমন্ত বা অফলাইন থাকতে পারে। এটি চালু হলে আবার চেষ্টা করুন।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ འགྲོ་བཞིན་པའི་ Mac གཉིད་ཁུག་པའམ་དྲ་ཐོག་མིན་པ་ཡིན་སྲིད། ཁ་སྦྱར་ནས་བསྐྱར་ཚོད།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@खौ चलायग्रा Macआ उसुबाय थानो हागौ ना अफलाइन। बेयो बानाय जाब्ला फिन नाजाद।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "És possible que el Mac que executa %@ estigui en repòs o fora de línia. Torna-ho a provar quan estigui encès."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac ᎠᎵᏍᏙᎢ %@ ᎤᏔᎵᎢ ᎠᎴᏃ ᎥᏝ ᎦᏔᎲ. ᎢᏤ ᏥᏭᎦᏔᏅ ᎢᏧᏔ ᎢᎦᏛ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ئەو Macـەی %@ کارپێدەکات لەوانەیە خەوتووبێت یان ئۆفلاین بێت. کاتێک هەڵبوو دووبارە هەوڵبدە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac, na kterém běží %@, může spát nebo být offline. Zkuste to znovu, až bude zapnutý."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Efallai bod y Mac sy'n rhedeg %@ yn cysgu neu all-lein. Ceisiwch eto unwaith y bydd ymlaen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac'en, der kører %@, sover måske eller er offline. Prøv igen, når den er tændt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Mac, der %@ ausführt, ist möglicherweise im Ruhezustand oder offline. Versuche es erneut, sobald er an ist."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ओह Mac जेह्ड़ा %@ चलांदा है सों करदा होग या ऑफलाइन होग। जदूं एह चालू होऐ फिरी कोशिश करो।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ހިންގާ Mac ނިދާފައި ނުވަތަ އޮފްލައިންގައި އޮވެދާނެ. އത് އޮންނައިރު އަލުން މަސައްކަތްކުރޭ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Mac που εκτελεί το %@ μπορεί να κοιμάται ή να είναι εκτός σύνδεσης. Δοκιμάστε ξανά μόλις ενεργοποιηθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es posible que el Mac que ejecuta %@ esté en reposo o sin conexión. Inténtalo de nuevo cuando esté encendido."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac, kus töötab %@, võib magada või olla võrguühenduseta. Proovige uuesti, kui see on sees."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مکی که %@ را اجرا می‌کند ممکن است خواب یا آفلاین باشد. وقتی روشن شد دوباره امتحان کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac, joka ajaa kohdetta %@, saattaa nukkua tai olla offline. Yritä uudelleen, kun se on päällä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maaaring tulog o offline ang Mac na nagpapatakbo ng %@. Subukang muli kapag naka-on na ito."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Macin sum koyrir %@ kann sova ella vera offline. Royn aftur tá hann er tendraður."
