        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ তখন এই %@ কে একটি নতুন ডিভাইস হিসেবে দেখে, এবং একজন মালিক এটিকে আবার অনুমোদন করে।"
          }
        },
        "brx" : {
          "stringUnit" : {
