    "Other devices ask for it once to watch %@. This device’s own pages don’t." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تطلبه الأجهزة الأخرى مرة واحدة لمشاهدة %@. أما صفحات هذا الجهاز نفسه فلا."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الأجهزة الثانية تطلبه مرة وحدة عشان تشوف %@. صفحات هذا الجهاز نفسه ما تطلبه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ চাবলৈ আন ডিভাইচবোৰে ইয়াক এবাৰ সুধিব। এই ডিভাইচটোৰ নিজৰ পৃষ্ঠাবোৰে নুসুধে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Digər cihazlar %@-ni izləmək üçün onu bir dəfə soruşur. Bu cihazın öz səhifələri yox."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Іншыя прылады просяць яе аднойчы, каб глядзець %@. Уласныя старонкі гэтай прылады — не."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Другите устройства го искат веднъж, за да гледат %@. Собствените страници на това устройство не."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ দেখতে অন্য ডিভাইস একবার এটি চায়। এই ডিভাইসের নিজের পেজগুলো চায় না।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "སྒྲིག་གཞན་%@ ལྟ་ཕྱིར་ཐེངས་གཅིག་ཞུ། སྒྲིག་འདིའི་ཤོག་རང་མི་ཞུ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@खौ नायनो गुबुन डिभाइसफोरा बेखौ खेबसे बियो। बे डिभाइसनि गावनि पेजफोरा नाङा।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altres dispositius ho demanen una vegada per mirar %@. Les pàgines pròpies d'aquest dispositiu no."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎢᏧᎳ ᏗᏧᎦᏔᏅᎯ %@ ᎠᎪᏩᏛᏱ ᏌᏊ ᎢᏓᏛᏓ. ᎯᎠ ᏗᏧᎦᏔᏅᎯ ᎤᏩᏒ ᎦᏖᎸ ᎥᏝ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ئامێرەکانی تر جارێک داوای دەکەن بۆ سەیرکردنی %@. پەڕەکانی خودی ئەم ئامێرە نایکەن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ostatní zařízení jej požádají jednou pro sledování %@. Vlastní stránky tohoto zařízení ne."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae dyfeisiau eraill yn gofyn amdano unwaith i wylio %@. Nid yw tudalennau’r ddyfais hon ei hun yn gwneud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Andre enheder beder om den én gang for at se %@. Denne enheds egne sider gør ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Andere Geräte fragen einmal danach, um %@ anzusehen. Die eigenen Seiten dieses Geräts nicht."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "होर डिवाइस %@ दिखने आस्ते इसगी इक बारी मंगदे न। इस डिवाइस दे अपने पन्ने नेईं मंगदे।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ބެލުމަށް އެހެން ޑިވައިސްތައް އެއްފަހަރު އެއަށް އެދޭ. މި ޑިވައިސްގެ އަމިއްލަ ޕޭޖްތަކުން ނޫން."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Άλλες συσκευές το ζητούν μία φορά για να παρακολουθήσουν το %@. Οι σελίδες αυτής της συσκευής όχι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otros dispositivos lo piden una vez para ver %@. Las propias páginas de este dispositivo no."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teised seadmed küsivad seda üks kord, et vaadata %@. Selle seadme enda lehed mitte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دستگاه‌های دیگر برای تماشای %@ یک‌بار آن را می‌خواهند. صفحه‌های خود این دستگاه نه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muut laitteet kysyvät sitä kerran katsellakseen %@. Tämän laitteen omat sivut eivät."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hinihingi ito ng ibang mga device nang isang beses para mapanood ang %@. Hindi ito hinihingi ng sariling mga page ng device na ito."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aðrar eindir spyrja eftir tí eina ferð fyri at hyggja at %@. Egnu síður hjá hesi eind gera ikki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les autres appareils le demandent une fois pour regarder %@. Les propres pages de cet appareil, non."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Iarrann gléasanna eile é uair amháin chun breathnú ar %@. Ní iarrann leathanaigh an ghléis seo féin é."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ જોવા માટે અન્ય ડિવાઇસ તે એક વાર માંગે છે. આ ડિવાઇસના પોતાના પેજ માંગતા નથી."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Noi nā mea ʻē aʻe iā ia i hoʻokahi manawa e nānā i %@. ʻAʻole nā ʻaoʻao o kēia mea ponoʻī."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מכשירים אחרים מבקשים זאת פעם אחת כדי לצפות ב%@. הדפים של מכשיר זה עצמו לא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अन्य डिवाइस %@ देखने के लिए इसे एक बार मांगते हैं। इस डिवाइस के अपने पेज नहीं मांगते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ostali uređaji traže ga jednom za gledanje %@. Vlastite stranice ovog uređaja ne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Más eszközök egyszer kérik a %@ megtekintéséhez. Ennek az eszköznek a saját oldalai nem."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Մյուս սարքերը այն խնդրում են մեկ անգամ %@ դիտելու համար։ Այս սարքի սեփական էջերը՝ ոչ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perangkat lain memintanya sekali untuk menonton %@. Halaman perangkat ini sendiri tidak."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Önnur tæki biðja um það einu sinni til að horfa á %@. Eigin síður þessa tækis gera það ekki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli altri dispositivi lo chiedono una volta per guardare %@. Le pagine proprie di questo dispositivo no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "他のデバイスは %@ を視聴するために一度だけ要求します。このデバイス自身のページでは要求しません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "სხვა მოწყობილობები ითხოვენ მას ერთხელ %@-ის საყურებლად. ამ მოწყობილობის საკუთარი გვერდები – არა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Басқа құрылғылар %@-ны көру үшін оны бір рет сұрайды. Бұл құрылғының өз беттері сұрамайды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ឧបករណ៍ផ្សេងសុំវាម្តងដើម្បីមើល %@។ ទំព័រផ្ទាល់របស់ឧបករណ៍នេះមិនសុំទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ವೀಕ್ಷಿಸಲು ಇತರ ಸಾಧನಗಳು ಒಮ್ಮೆ ಅದನ್ನು ಕೇಳುತ್ತವೆ. ಈ ಸಾಧನದ ಸ್ವಂತ ಪುಟಗಳು ಕೇಳುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다른 기기는 %@를 시청하기 위해 한 번 요청합니다. 이 기기의 자체 페이지는 요청하지 않습니다."
          }
        },
        "kok" : {
