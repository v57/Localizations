    "Ends every connection to %@. Devices that are still allowed reconnect with new access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ينهي كل اتصال بـ %@. الأجهزة التي لا تزال مسموحة تعيد الاتصال بوصول جديد."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ينهي كل اتصال بـ %@. الأجهزة اللي للحين مسموحة تتصل من جديد بوصول جديد."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-লৈ প্ৰতিটো সংযোগ শেষ কৰে। এতিয়াও অনুমতি থকা ডিভাইচবোৰ নতুন প্ৰৱেশেৰে পুনৰ সংযোগ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-yə bütün bağlantıları bitirir. Hələ icazəli olan cihazlar yeni girişlə yenidən qoşulur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Завяршае кожнае злучэнне з %@. Прылады, якім усё яшчэ дазволена, перападключаюцца з новым доступам."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Прекратява всяка връзка с %@. Устройствата, които все още са разрешени, се свързват отново с нов достъп."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-এর প্রতিটি সংযোগ শেষ করে। যে ডিভাইসগুলোর এখনও অনুমতি আছে সেগুলো নতুন অ্যাক্সেস দিয়ে পুনঃসংযোগ করে।"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@आव गासै कनेक्सनखौ जोबफुनो। दासिमबो होजानाय डिभाइसफोरा गोदान एक्सेसजों फिन कनेक्ट जायो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acaba cada connexió a %@. Els dispositius que encara estan permesos es reconnecten amb nou accés."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᏂᎦᏛ ᏓᏓᏅᏍᏗ %@ ᎤᏍᏓᎸᎢ. ᎾᏍᎩ ᏓᏅᏓᏅᏖᏛ ᎢᏤ ᎤᏓᏅᏖ ᎢᏤ ᎠᏛᏅᏙ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هەموو پەیوەندییەک بۆ %@ کۆتایی پێدەهێنێت. ئەو ئامێرانەی هێشتا ڕێگەیان پێدراوە بە دەستڕاگەیشتنێکی نوێ دووبارە پەیوەست دەبن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ukončí každé připojení k %@. Zařízení, která jsou stále povolena, se znovu připojí s novým přístupem."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yn gorffen pob cysylltiad i %@. Mae dyfeisiau sy’n dal i gael eu caniatáu yn ailgysylltu gyda mynediad newydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Afslutter hver forbindelse til %@. Enheder, der stadig er tilladt, forbinder igen med ny adgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beendet jede Verbindung zu %@. Geräte, die weiterhin erlaubt sind, verbinden sich mit neuem Zugriff erneut."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ कन्नै हर कनेक्शन खत्म करदा है। डिवाइस जिन्हें अजें आज्ञा है नमीं पहुंच कन्नै दुबारा जुड़दे न।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ އަށް ހުރިހާ ކަނެކްޝަނެއް ނިންމާ. އަދިވެސް ހުއްދައޮތް ޑިވައިސްތައް އާ އެކްސެސްއެކު އަލުން ކަނެކްޓްވޭ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τερματίζει κάθε σύνδεση στο %@. Οι συσκευές που εξακολουθούν να επιτρέπονται επανασυνδέονται με νέα πρόσβαση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termina todas las conexiones a %@. Los dispositivos que aún están permitidos se reconectan con nuevo acceso."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lõpetab kõik ühendused %@-ga. Seadmed, mis on endiselt lubatud, ühenduvad uue juurdepääsuga uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هر اتصال به %@ را پایان می‌دهد. دستگاه‌هایی که هنوز مجاز هستند با دسترسی جدید دوباره متصل می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Päättää jokaisen yhteyden kohteeseen %@. Laitteet, joilla on yhä lupa, yhdistävät uudelleen uudella käyttöoikeudella."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tinapos ang bawat koneksyon sa %@. Muling kumokonekta nang may bagong access ang mga device na pinapayagan pa rin."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Endar hvørt samband til %@. Eindir, sum enn eru loyvdar, tengja seg aftur við nýggja atgongd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Met fin à toutes les connexions à %@. Les appareils toujours autorisés se reconnectent avec un nouvel accès."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuireann sé deireadh le gach nasc le %@. Athnascann gléasanna a bhfuil cead acu fós le rochtain nua."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ સાથેના દરેક જોડાણને સમાપ્ત કરે છે. જે ડિવાઇસને હજુ મંજૂરી છે તે નવી ઍક્સેસ સાથે ફરી કનેક્ટ થાય છે."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoʻopau i nā pilina a pau i %@. Hoʻopili hou nā mea i ʻae ʻia me ke komo hou."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מסיים כל חיבור אל %@. מכשירים שעדיין מורשים מתחברים מחדש עם גישה חדשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ के हर कनेक्शन को समाप्त करता है। जिन डिवाइसों को अभी भी अनुमति है वे नई एक्सेस से फिर से कनेक्ट होते हैं।"
