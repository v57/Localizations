        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prekida svaku vezu s %@. Uređaji koji su i dalje dopušteni ponovno se povezuju s novim pristupom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minden kapcsolatot lezár ide: %@. A továbbra is engedélyezett eszközök új hozzáféréssel csatlakoznak újra."
