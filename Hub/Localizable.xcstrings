    "Hubs from before each hub got keys of its own stay on these, and so does the hub this %@ runs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المراكز من قبل أن يحصل كل مركز على مفاتيحه الخاصة تبقى على هذه، وكذلك المركز الذي يشغّله هذا %@."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الـ Hubs اللي من قبل ما صار لكل hub مفاتيحه الخاصة تبقى على هذي، ونفس الشي للـ hub اللي يشغّله %@ هذا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্ৰতিটো hub-এ নিজৰ কী পোৱাৰ আগৰ Hubবোৰ এইবোৰতে থাকে, আৰু এই %@-এ চলোৱা hubটোও।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər hab öz açarlarını almazdan əvvəlki hablar bunlarda qalır, bu %@-nin işlətdiyi hab da."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хабы, якія былі да таго, як кожны хаб атрымаў уласныя ключы, застаюцца на гэтых, як і хаб, які працуе на гэтым %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хъбовете отпреди всеки хъб да има собствени ключове остават на тях, както и хъбът, който това %@ изпълнява."
          }
        },
        "bn" : {
