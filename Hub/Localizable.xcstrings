    "Accepts the key %@ now shows.%@ Do this only if you know why it changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقبل المفتاح الذي يعرضه %@ الآن.%@ لا تفعل ذلك إلا إذا كنت تعرف سبب تغييره."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقبل المفتاح اللي يعرضه %@ الحين.%@ سوّ هذا بس إذا تدري ليش تغيّر."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এতিয়া %@-এ দেখুওৱা কীটো গ্ৰহণ কৰক।%@ ই কিয় সলনি হ’ল জানিলেহে এয়া কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-nın indi göstərdiyi açarı qəbul edir.%@ Bunu yalnız niyə dəyişdiyini bilirsinizsə edin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Прымае ключ, які %@ зараз паказвае.%@ Рабіце гэта, толькі калі ведаеце, чаму ён змяніўся."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Приема ключа, който %@ показва сега.%@ Направете това само ако знаете защо се е променил."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এখন %@ যে কী দেখাচ্ছে তা গ্রহণ করে।%@ কেন এটি বদলেছে তা জানলেই শুধু এটি করুন।"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दायाव %@आ दिन्थिनाय किखौ आजावो।%@ बेयो सोलायनायनि जाहोनखौ नों मिथियोब्लाल' बेखौ खालाम।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accepta la clau que %@ mostra ara.%@ Fes-ho només si saps per què ha canviat."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᏧᏍᏗ %@ ᎠᎭ ᎠᏓᏅᏙ.%@ ᎯᎠ ᎯᏍᏗ ᎢᏳᏃ ᎯᎦᏔᎭ ᎦᏙ ᎤᏛᏅᎢ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کلیلەکە قبوڵ بکە کە %@ ئێستا نیشانی دەدات.%@ ئەمە تەنها بکە ئەگەر دەزانیت بۆچی گۆڕاوە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přijme klíč, který %@ nyní zobrazuje.%@ Dělejte to pouze pokud víte, proč se změnil."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yn derbyn yr allwedd mae %@ yn ei dangos nawr.%@ Gwnewch hyn dim ond os ydych yn gwybod pam y newidiodd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accepterer den nøgle, som %@ nu viser.%@ Gør kun dette, hvis du ved, hvorfor den ændrede sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Akzeptiert den Schlüssel, den %@ jetzt anzeigt.%@ Tue dies nur, wenn du weißt, warum er sich geändert hat."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "उस की गी स्वीकार करो जेह्ड़ी %@ हुण दिखांदा है।%@ एह् सिर्फ तदूं करो जे तुसेंगी पता होए जे एह् कियूं बदली।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "މިހާރު %@ ދައްކާ ކީ ގަބޫލުކުރައްވާ.%@ މިކަން ކުރައްވަނީ އެ ބަދަލުވީ ކީއްވެގެންކަން އެނގިލައްވާނަމަ އެކަނި."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αποδέχεται το κλειδί που δείχνει τώρα το %@.%@ Κάντε το μόνο αν ξέρετε γιατί άλλαξε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acepta la clave que %@ muestra ahora.%@ Hazlo solo si sabes por qué cambió."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktsepteerib võtit, mida %@ praegu näitab.%@ Tehke seda ainult siis, kui teate, miks see muutus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کلیدی را که %@ اکنون نشان می‌دهد بپذیرید.%@ این کار را فقط وقتی انجام دهید که می‌دانید چرا تغییر کرده است."
