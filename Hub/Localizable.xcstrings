        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ अजें कोई ऐप साझा नेईं करदा। एह् तुहाडे डिवाइसें तक पुज्ज सकदा है, ते ओह् इस तक पुज्ज सकदे न।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ އަދި އެޕެއް ޝެއަރކޮށްފައެއް ނެތް. އެއަށް ތިޔަބޭފުޅާގެ ޑިވައިސްތަކަށް ވާސިލްވެވޭ، އަދި އެތަކަށް އެއަށް ވާސިލްވެވޭ."
