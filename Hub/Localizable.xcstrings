        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যদি %@-এ উত্তৰ দিবলৈ বন্ধ কৰে"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Əgər %@ cavab verməyi dayandırsa"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Калі %@ перастае адказваць"
