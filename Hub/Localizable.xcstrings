            "value" : "ಸೇವೆಗಳು ಆ್ಯಪ್‌ಗಳನ್ನು ಪ್ರಕಟಿಸುತ್ತವೆ: ಅವು ವಿವರಿಸುವುದರಿಂದ ಪುಟಗಳು, ವಿಜೆಟ್‌ಗಳು ಮತ್ತು ವೆಬ್ ಆ್ಯಪ್‌ಗಳು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "서비스는 앱을 게시합니다: 설명을 기반으로 한 페이지, 위젯 및 웹 앱."
          }
        },
        "kok" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सेवा अ‍ॅप प्रकाशित करतात: पानां, विजेटां आनी वेब अ‍ॅप, तीं वर्णन करतात तांतूंतल्यान काडिल्ले."
          }
        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سروسز چھِ ایپس شایَع کَران: صفحہٕ، وِجِٹ تہٕ ویب ایپس یِم تِم بیان کَران چھِ اَتھ مَنٛز بنان۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xizmet apan diweşînin: rûpel, widget û web-app ji tiştên ku vedibêjin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кызматтар колдонмолорду жарыялайт: баракчалар, виджеттер жана алар сүрөттөгөндөн түзүлгөн веб-колдонмолор."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ບໍລິການເຜີຍແຜ່ແອັບ: ໜ້າ, ວິດເຈັດ ແລະ ເວັບແອັບ ຈາກສິ່ງທີ່ພວກມັນອະທິບາຍ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paslaugos skelbia programas: puslapius, valdiklius ir žiniatinklio programas iš to, ką jos aprašo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pakalpojumi publicē lietotnes: lapas, logrīkus un tīmekļa lietotnes, kas veidotas no to apraksta."
          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सेवासभ ऐप प्रकाशित करैत अछि: पेज, विजेट आ वेब ऐप जे ओ वर्णन करैत अछि ओकरासँ बनल।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ka whakaputa ngā ratonga i ngā taupānga: ngā whārangi, ngā widget me ngā taupānga paetukutuku mai i ngā mea e whakaahuatia ana e rātou."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Услугите објавуваат апликации: страници, виџети и веб-апликации создадени од тоа што го опишуваат."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "സേവനങ്ങൾ ആപ്പുകൾ പ്രസിദ്ധീകരിക്കുന്നു: അവ വിവരിക്കുന്നതിൽ നിന്നുള്ള പേജുകൾ, വിജറ്റുകൾ, വെബ് ആപ്പുകൾ."
          }
