    "Waiting for its turn with this hub. The code comes once the hub has this %@’s request." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بانتظار دوره مع هذا Hub. يصل الرمز عندما يتلقى Hub طلب هذا %@."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ننتظر دوره مع هالـ Hub. الكود يجي إذا الـ Hub استلم طلب %@ هذا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই Hub-ৰ সৈতে ইয়াৰ পাললৈ ৰৈ আছে। Hub-এ এই %@-ৰ অনুৰোধ পোৱাৰ পিছত ক’ড আহে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu hub ilə növbəsi gözlənilir. Hub bu %@-nın sorğusunu aldıqda kod gəlir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чаканне сваёй чаргі ў гэтага хаба. Код з'явіцца, калі хаб атрымае запыт гэтага %@."
          }
        },
        "bg" : {
