        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Për një pajisje të humbur ose të komprometuar. Lidhjet e saj mbyllen, çelësi i shërbimit revokohet, grantet dhe peer-ët e Hub Network hiqen, dhe ajo nuk mund të miratohet më kurrë. Çdo pajisje e bashkangjitur poshtë saj revokohet gjithashtu."
          }
        },
        "sr" : {
          "stringUnit" : {
