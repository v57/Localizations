        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ পর্যন্ত রেকর্ড হচ্ছে, আপনি এটি ব্যবহার করলেও"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ བར་བླངས། ཁྱེད་བེད་སྤྱོད་ཀྱང་།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@जासिम रेकर्ड जादों, नों बेखौ बाहायबाय थायोब्लाबो"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enregistrant fins a %@, fins i tot mentre ho utilitzes"
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ᎤᏩᏒ ᎯᏃᏪᎸ ᎠᏛᏒ, ᏂᎦᏃ ᏣᏴᏍᏗ ᎢᏳ"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تۆمار دەکات تا %@، تەنانەت لە کاتێکدا بەکاری دەهێنیت"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nahrává se do %@, i když jej používáte"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yn recordio tan %@, hyd yn oed tra rydych yn ei ddefnyddio"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Optager indtil %@, selv mens du bruger den"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nimmt bis %@ auf, auch während du es verwendest"
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ तक रिकॉर्ड होआ करदा, तदों बी जदों तुस इसगी बर्तदे ओ"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ދެން ރެކޯޑްކުރަމުން، ތިޔަބޭފުޅާ އެ ބޭނުންކުރައްވައިރުވެސް"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εγγραφή έως %@, ακόμη και ενώ το χρησιμοποιείτε"
