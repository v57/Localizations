        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यो हबले यसको साँचो विरुद्ध जाँच गर्ने कुनै सुरक्षा कोड दिँदैन, त्यसैले यो अनुरोध तपाईंको उपकरणबाट आएको हो भनी केही देखिँदैन। हबमा पुग्न सक्ने जो कोहीले कुनै पनि नाममा सामेल हुन सोध्न सक्छ, र अनुमोदित उपकरणले हबले साझा गरेको कुरा प्रयोग गर्न सक्छ। तपाईंले भर्खरै आफ्नै उपकरणबाट सोध्नुभएको हो र अरू कोही हुन सक्दैनथ्यो भने मात्र अनुमोदन गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
