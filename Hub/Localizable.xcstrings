        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ഇത്രയും നേരം കീബോർഡോ മൗസോ ഇല്ല. ലോക്ക് ചെയ്തതോ ഉറങ്ങിയതോ ഉടൻ കണക്കാക്കുന്നു."
