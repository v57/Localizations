        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ডিভাইচবোৰে ইয়াৰ মাজেৰে ইটোৱে সিটোক বিচাৰি পায়। আমন্ত্ৰণবোৰত ই অন্তৰ্ভুক্ত থাকে; ইয়াৰ মাজেৰে কোনো ট্ৰেফিক পাৰ নহয়।"
