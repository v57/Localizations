    "Watches for motion and records clips. Only %@’s devices on Hub Network with the password can watch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يراقب الحركة ويسجّل المقاطع. فقط أجهزة %@ على شبكة Hub التي لديها كلمة المرور يمكنها المشاهدة."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يراقب الحركة ويسجل مقاطع. بس أجهزة %@ على Hub Network اللي معها كلمة السر تقدر تراقب."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "গতিৰ বাবে চোৱা দিয়ে আৰু ক্লিপ ৰেকৰ্ড কৰে। পাছৱৰ্ডসহ Hub Network-ত কেৱল %@-ৰ ডিভাইচবোৰেহে চাব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hərəkəti izləyir və kliplər yazır. Yalnız Hub Network-də parolla %@-nın cihazları izləyə bilər."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Назірае за рухам і запісвае кліпы. Назіраць могуць толькі прылады %@ у Hub Network з паролем."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Наблюдава за движение и записва клипове. Само устройствата на %@ в Hub Network с паролата могат да гледат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "মোশনের জন্য নজর রাখে এবং ক্লিপ রেকর্ড করে। পাসওয়ার্ড সহ Hub Network-এ কেবল %@-এর ডিভাইসগুলো দেখতে পারে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ས་གུལ་ལྟ་ནས་གཏུབ་པར་ཐོན། %@ གི་སྒྲིག་ཆས་ Hub Network སྟེང་གསང་ཨང་དང་ཁོ་ནས་ལྟ་ཐུབ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मोशननि थाखाय नायो आरो क्लिपफोरखौ रेकर्ड खालामो। पासवार्डजों Hub Networkआवनि %@नि डिभाइसफोरसो नायनो हायो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vigila el moviment i grava clips. Només els dispositius de %@ a Hub Network amb la contrasenya ho poden mirar."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎠᏓᏅᏖᎢ ᎡᎭ ᎠᎴ ᎩᎵᏈ ᎠᏅᏍᏙᎢ. %@ ᏧᏤᎵ ᏗᏧᎦᏔᏅᎯ Hub Network ᎬᏩᎶᏒ ᏧᏓᎴᏅᏓ ᏧᏬᏪ ᎠᎪᏩᏛ Ꮵ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "چاودێری جووڵە دەکات و کلیپ تۆمار دەکات. تەنها ئامێرەکانی %@ لە تۆڕی Hub بە وشەی نهێنییەوە دەتوانن سەیری بکەن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sleduje pohyb a nahrává klipy. Sledovat mohou pouze zařízení %@ v Hub Network s heslem."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yn gwylio am symudiad ac yn recordio clipiau. Dim ond dyfeisiau %@ ar Rwydwaith Hub gyda'r cyfrinair all wylio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overvåger bevægelse og optager klip. Kun %@’s enheder på Hub Network med adgangskoden kan se med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Achtet auf Bewegung und zeichnet Clips auf. Nur %@s Geräte im Hub-Netzwerk mit dem Passwort können zusehen."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मोशन लेई दिखदा है ते क्लिप रिकॉर्ड करदा है। सिर्फ हब नेटवर्क पर पासवर्ड समेत %@ दे डिवाइस गै दिख सकदे न।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ހަރަކާތަށް ބަލައި ކްލިޕްތައް ރެކޯޑްކުރޭ. ޕާސްވޯޑާއެކު Hub Network ގައިވާ %@ ގެ ޑިވައިސްތަކަށް އެކަނި ބެލެވޭ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Παρακολουθεί για κίνηση και εγγράφει κλιπ. Μόνο οι συσκευές του/της %@ στο Hub Network με τον κωδικό πρόσβασης μπορούν να παρακολουθήσουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vigila el movimiento y graba clips. Solo los dispositivos de %@ en Hub Network con la contraseña pueden verlos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jälgib liikumist ja salvestab klippe. Vaadata saavad ainult %@ seadmed Hub Networkis, millel on parool."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مراقب حرکت است و کلیپ ضبط می‌کند. فقط دستگاه‌های %@ در شبکه هاب با رمز عبور می‌توانند تماشا کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tarkkailee liikettä ja tallentaa klippejä. Vain %@n laitteet Hub Networkissa salasanalla voivat katsella."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nagbabantay ng galaw at nagre-record ng mga clip. Ang mga device lang ni %@ sa Hub Network na may password ang makakabantay."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anar eftir rørslu og tekur upp klipp. Bert eindir hjá %@ á Hub Network við loyniorðinum kunnu hyggja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Surveille les mouvements et enregistre des clips. Seuls les appareils de %@ sur Hub Network avec le mot de passe peuvent regarder."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faireann gluaiseacht agus taifeadann gearrthóga. Ní féidir ach le gléasanna %@ ar Líonra Hub leis an bhfocal faire faire."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ગતિ માટે જુએ છે અને ક્લિપ્સ રેકોર્ડ કરે છે. પાસવર્ડ સાથે Hub Network પર માત્ર %@ ના ડિવાઇસ જોઈ શકે છે."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kiaʻi i ka neʻe a hoʻopaʻa i nā kilepa. ʻO nā mea wale nō o %@ ma Hub Network me ka ʻōlelo huna ke kiaʻi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "משגיח על תנועה ומקליט קליפים. רק המכשירים של %@ ב-Hub Network עם הסיסמה יכולים לצפות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मोशन के लिए देखता है और क्लिप रिकॉर्ड करता है। पासवर्ड के साथ Hub Network पर केवल %@ के डिवाइस देख सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nadzire pokret i snima isječke. Gledati mogu samo uređaji od %@ na Hub mreži s lozinkom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mozgást figyel és klipeket rögzít. Csak %@ eszközei nézhetik a Hub Networkön a jelszóval."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Հետևում է շարժմանը և ձայնագրում հոլովակներ։ Միայն Hub Network-ում %@-ի սարքերը՝ գաղտնաբառով, կարող են դիտել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Memantau gerakan dan merekam klip. Hanya perangkat %@ di Hub Network dengan kata sandi yang dapat memantau."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fylgist með hreyfingu og tekur upp klippur. Aðeins tæki %@ á Hub-neti með lykilorðinu geta fylgst með."
          }
        },
