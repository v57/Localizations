        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "হারিয়ে যাওয়া বা আপস করা ডিভাইসের জন্য। এর সংযোগগুলো বন্ধ হয়, এর %lldটি সার্ভিস কী বাতিল করা হয়, এর গ্রান্ট ও Hub Network পিয়ারগুলো সরিয়ে ফেলা হয়, এবং এটি আর কখনো অনুমোদিত হতে পারবে না। এর নিচে সংযুক্ত প্রতিটি ডিভাইসও বাতিল করা হয়।"
