    "Takes %@ off the network, so devices on %@ can’t connect to it anymore." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يزيل %@ من الشبكة، فلا تعود الأجهزة الموجودة على %@ قادرة على الاتصال به."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يشيل %@ من الشبكة، فأجهزة %@ ما عاد تقدر تتصل فيه."
          }
        },
        "as" : {
