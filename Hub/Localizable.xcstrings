    "Hubs from before each hub got keys of its own stay on these, and so does the hub this %@ runs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المراكز من قبل أن يحصل كل مركز على مفاتيحه الخاصة تبقى على هذه، وكذلك المركز الذي يشغّله هذا %@."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الـ Hubs اللي من قبل ما صار لكل hub مفاتيحه الخاصة تبقى على هذي، ونفس الشي للـ hub اللي يشغّله %@ هذا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্ৰতিটো hub-এ নিজৰ কী পোৱাৰ আগৰ Hubবোৰ এইবোৰতে থাকে, আৰু এই %@-এ চলোৱা hubটোও।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər hab öz açarlarını almazdan əvvəlki hablar bunlarda qalır, bu %@-nin işlətdiyi hab da."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хабы, якія былі да таго, як кожны хаб атрымаў уласныя ключы, застаюцца на гэтых, як і хаб, які працуе на гэтым %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хъбовете отпреди всеки хъб да има собствени ключове остават на тях, както и хъбът, който това %@ изпълнява."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি হাব নিজের কী পাওয়ার আগের হাবগুলো এগুলোতেই থাকে, আর এই %@ যে হাব চালায় সেটিও থাকে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "hub རེ་རེར་ལྡེ་མིག་ཐོབ་མདུན་གྱི་hub རྣམས་འདིར་གནས། %@ འདིས་གཉེར་བའི་hub ཡང་།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मोनफ्रोमबो गावनि किफोर मोननाय सिगांनि Hubफोरा बेफोरावनो थायो, आरो बे %@ सालायग्रा हाबआबो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els hubs d'abans que cada hub tingués claus pròpies continuen amb aquestes, i també el hub que executa aquest %@."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hubs ᎢᎬᏱ ᎢᏯᏔᏬᏁᏗ ᏂᎦᎥ hub ᎤᏤᎵ ᎢᏤ ᎯᎠᏉ ᎢᎦᏔᎲ, ᎠᎴ hub ᎯᎠ %@ ᏥᎦᏛᏒ ᎾᏍᎩ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ئەو Hub ـانەی پێش ئەوەی هەر هەبێک کلیلی خۆی هەبێت لەسەر ئەمانە دەمێننەوە، و هەروەها ئەو هەبەی کە ئەم %@ ـە بەڕێوە دەبات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Huby z doby, než každý hub dostal vlastní klíče, zůstávají na těchto, stejně jako hub, který toto %@ provozuje."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae hubs o cyn i bob hub gael allweddi ei hun yn aros ar y rhain, ac felly mae’r hub mae’r %@ hwn yn ei redeg."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hubs fra før hver hub fik sine egne nøgler bliver på disse, og det samme gør den hub, denne %@ kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hubs aus der Zeit, bevor jeder Hub eigene Schlüssel bekam, bleiben auf diesen, ebenso der Hub, den dieses %@ betreibt."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "उस थमां पैह्लें दे हब जदों हर हब गी अपनीयां कुंजियां मिलियां, एन्हां पर ही रौंह्दे न, ते ओह् हब बी जेह्ड़ा एह् %@ चलांदा है।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ކޮންމެ hub އަކަށް އަމިއްލަ ކީތައް ލިބުމުގެ ކުރިންގެ ހަބްތައް މިތަކުގައި ތިބޭ، އަދި މި %@ ރަންކުރާ hub ވެސް މިތާގައި."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα Hub από πριν αποκτήσει κάθε hub τα δικά του κλειδιά παραμένουν σε αυτά, όπως και το hub που εκτελεί αυτό το %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los hubs de antes de que cada hub tuviera sus propias claves siguen en estos, igual que el hub que ejecuta este %@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hubid ajast enne, kui iga hub sai oma võtmed, jäävad nendele, samuti hub, mida see %@ käitab."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هاب‌های قدیمی‌تر از زمانی که هر هاب کلیدهای خودش را گرفت روی همین‌ها می‌مانند، و هابی هم که این %@ اجرا می‌کند همین‌طور."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hubit ajalta ennen kuin jokainen hub sai omat avaimensa pysyvät näillä, kuten myös hub, jota tämä %@ käyttää."
