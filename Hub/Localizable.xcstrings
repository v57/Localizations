        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-ը մոտ %@ է։ Ուղիղ դիտումը տվյալներ է օգտագործում միայն մինչ ինչ-որ մեկը դիտում է։ Հոլովակները ենթադրում են օրական %@ շարժում (վերջին 7 օրը)։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ adalah sekitar %@. Tampilan langsung hanya memakai data saat ada yang menonton. Klip mengasumsikan %@ gerakan per hari (7 hari terakhir)."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ er um %@. Bein útsending notar aðeins gögn meðan einhver horfir. Klippur gera ráð fyrir %@ af hreyfingu á dag (síðustu 7 daga)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ riguarda %@. La visualizzazione live usa dati solo mentre qualcuno guarda. Le clip presuppongono %@ di movimento al giorno (ultimi 7 giorni)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ は約 %@ です。ライブビューは視聴中のみデータを使用します。クリップは1日あたり %@ のモーションを想定しています（過去7日間）。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ არის %@-ის შესახებ. პირდაპირი ყურება მონაცემებს იყენებს მხოლოდ მაშინ, როცა ვინმე უყურებს. კლიპები ითვალისწინებს დღეში %@ მოძრაობას (ბოლო 7 დღე)."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ шамамен %@. Тікелей қарау біреу қарап тұрғанда ғана дерек пайдаланады. Клиптер күніне %@ қозғалысты болжайды (соңғы 7 күн)."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ គឺប្រហែល %@។ ការមើលផ្ទាល់ប្រើទិន្នន័យតែពេលមានអ្នកមើល។ ឃ្លីបសន្មត %@ នៃចលនាក្នុងមួយថ្ងៃ (7 ថ្ងៃចុងក្រោយ)។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ಸುಮಾರು %@ ಆಗಿದೆ. ಯಾರಾದರೂ ನೋಡುವಾಗ ಮಾತ್ರ ಲೈವ್ ವೀಕ್ಷಣೆ ಡೇಟಾ ಬಳಸುತ್ತದೆ. ಕ್ಲಿಪ್‌ಗಳು ದಿನಕ್ಕೆ %@ ಚಲನೆ ಎಂದು ಭಾವಿಸುತ್ತವೆ (ಕಳೆದ 7 ದಿನಗಳು)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@은(는) %@에 관한 것입니다. 실시간 보기는 시청 중에만 데이터를 사용합니다. 클립은 하루 %@의 움직임(최근 7일)을 가정합니다."
          }
        },
        "kok" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ हो %@ विशीं आसा. थेट दृश्य फकत कोण पळयता तेन्नाच डेटा वापरता. क्लिपीं दिसाक %@ हालचाल धरतात (फाटले 7 दीस)."
          }
        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ چھُ %@ مُتعلق۔ لائیو ویوو چھُ ڈیٹا صِرَف ییٚلہِ کانٛہہ وُچھان اِستعمال کَران۔ کلِپس چھِ دۄہس مَنٛز %@ حرکت فرض کَران (پِچھلے 7 دۄہ)۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ li ser %@ ye. Dîtina zindî tenê dema kesek temaşe dike daneyê bikar tîne. Klîp rojê %@ tevgerê texmîn dikin (7 rojên dawî)."
