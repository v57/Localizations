    "So it answers when you’re away. It can sleep with the lid closed only on power." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ليستجيب أثناء غيابك. يمكنه السكون والغطاء مغلق فقط عند توصيل الطاقة."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عشان يرد وانت برا. يقدر ينام والغطا مقفل بس على الكهرب."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যাতে আপুনি আঁতৰত থাকোঁতে ই সঁহাৰি দিয়ে। পাৱাৰত থাকিলেহে ঢাকনি বন্ধ কৰি ই শুব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sən uzaqda olanda cavab verməsi üçün. Qapağı bağlı yatması yalnız cərəyanla mümkündür."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каб ён адказваў, калі вас няма. З закрытай вечкам ён можа спаць толькі ад сеткі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "За да отговаря, когато сте далеч. Може да спи със затворен капак само когато е включен в захранването."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "তাই আপনি দূরে থাকলেও এটি সাড়া দেয়। এটি ঢাকনা বন্ধ অবস্থায় কেবল পাওয়ারে থাকলেই স্লিপ করতে পারে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཁྱེད་མེད་དུས་ལན་འདེབས་ཆེད། གློག་ཐོག་ཡོད་ན་སྒོ་བརྒྱབ་ཀྱང་གཉིད་ཁུག་ཆོག"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बेनिखाय नों गयाब्लाबो बेयो फिनजोयो। पावारआव थालाब्ला बन्द खिबजोंबो बेयो उसुयो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perquè respongui quan siguis fora. Pot reposar amb la tapa tancada només amb corrent."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎾᏍᎩ ᎠᏁᎲᎢ ᎢᏧᏔ ᏣᏤᏍᎦ. ᎤᏩᏒ ᎠᏴ ᏗᏓᏅᏙ ᎢᏳᏃ ᎠᏓᏔᏅᎢ ᎬᏩᎶᏒ Ꮵ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بۆیە کاتێک دووریت وەڵام دەداتەوە. تەنها لەسەر کارەبا دەتوانێت بە داپۆشراوی بخەوێت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aby odpovídal, když jste pryč. Se zavřeným víkem může spát pouze při napájení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fel ei fod yn ateb pan fyddwch i ffwrdd. Gall gysgu gyda'r caead ar gau ar bŵer yn unig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Så den svarer, når du er væk. Den kan sove med lukket låg kun på strøm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit es antwortet, wenn du weg bist. Mit geschlossenem Deckel kann es nur am Strom ruhen."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "तां जे तुस दूर होओ तां बी एह जवाब दिंदा है। एह ढक्कन बंद करियै सिर्फ पावर पर सों सकदा है।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "އެހެންވެ ތިޔަބޭފުޅާ ބޭރުގައި އުޅޭއިރު ޖަވާބުދޭ. ޕަވަރުގައި ހުންނައިރު އެކަނި ލިޑް ބަންދުކޮށް ނިދިދާނެ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Για να αποκρίνεται όταν λείπετε. Μπορεί να κοιμάται με κλειστό καπάκι μόνο στο ρεύμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Así responde cuando estás fuera. Puede dormir con la tapa cerrada solo conectado a la corriente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et see vastaks, kui olete eemal. Suletud kaanega saab see magada ainult toitel."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تا وقتی دور هستید پاسخ دهد. فقط با برق می‌تواند با درب بسته بخوابد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jotta se vastaa poissa ollessasi. Se voi nukkua kansi suljettuna vain verkkovirralla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para sumagot ito kapag wala ka. Maaari itong matulog nang nakasara ang takip kapag nakasaksak lang."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "So tað svarar tá tú ert burtur. Tað kann sova við lokinum afturlatnum bert á streymi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour qu’il réponde quand vous êtes absent. Il peut dormir couvercle fermé uniquement sur secteur."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mar sin freagraíonn sé nuair atá tú as láthair. Is féidir leis codladh leis an gclúdach dúnta ar chumhacht amháin."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "જેથી તમે દૂર હો ત્યારે તે જવાબ આપે. તે ઢાંકણ બંધ સાથે માત્ર પાવર પર જ સ્લીપ કરી શકે છે."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No laila pane ia ke ʻole ʻoe. Hiki iā ia ke hiamoe me ka pani pani wale ma ka uila."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "כדי שיענה כשאתה לא בסביבה. הוא יכול לישון עם מכסה סגור רק כשהוא מחובר לחשמל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ताकि आपके दूर रहने पर भी यह जवाब दे। ढक्कन बंद होने पर यह केवल पावर पर ही स्लीप कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kako bi odgovarao dok ste odsutni. Može spavati sa zatvorenim poklopcem samo na napajanju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hogy akkor is válaszoljon, amikor távol vagy. Lecsukott fedéllel csak hálózatról tud aludni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Որպեսզի այն պատասխանի, երբ բացակայում եք։ Փակ կափարիչով այն կարող է քնել միայն հոսանքի դեպքում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agar tetap merespons saat Anda pergi. Perangkat dapat tidur dengan tutup tertutup hanya saat tersambung daya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Svo það svari þegar þú ert í burtu. Það getur sofið með lokið lokað aðeins í rafmagni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Così risponde quando sei via. Può restare in stop a coperchio chiuso solo se alimentato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "外出中も応答できるようにします。電源接続時のみ、ふたを閉じたままスリープできます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "რომ მან უპასუხოს, როდესაც არ ხართ. დახურული სახურავით ძილი შეუძლია მხოლოდ კვებაზე."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сіз жоқта жауап беруі үшін. Қақпағы жабық күйде тек қуатқа қосылғанда ұйықтай алады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ដូច្នេះវាឆ្លើយតបនៅពេលអ្នកនៅឆ្ងាយ។ វាអាចគេងដោយបិទគម្របបានតែពេលមានភ្លើងប៉ុណ្ណោះ។"
          }
        },
