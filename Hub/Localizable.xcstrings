        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "សម្រាប់ឧបករណ៍ដែលបាត់ ឬត្រូវបានលួចចូល។ ការតភ្ជាប់របស់វាត្រូវបានបិទ សោសេវាត្រូវបានដកហូត ការអនុញ្ញាត និង Hub Network ពៀរ ត្រូវបានលុបចេញ ហើយវាមិនអាចត្រូវបានអនុម័តម្តងទៀតឡើយ។"
