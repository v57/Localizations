            "state" : "needs_review",
            "value" : " %@ پوءِ هن %@ کي نئين ڊوائيس طور ڏسي ٿو، ۽ مالڪ ان کي ٻيهر منظور ڪري ٿو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ එවිට මෙම %@ නව උපාංගයක් ලෙස දකින අතර, හිමිකරුවෙකු එය නැවත අනුමත කරයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ potom vidí toto %@ ako nové zariadenie a vlastník ho znova schváli."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ nato vidi ta %@ kot novo napravo, lastnik pa jo znova odobri."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ pastaj e sheh këtë %@ si pajisje të re, dhe një pronar e miraton sërish."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ tada vidi ovaj %@ kao novi uređaj, a vlasnik ga ponovo odobrava."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ ser då detta %@ som en ny enhet, och en ägare godkänner den igen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ kisha huona %@ hii kama kifaa kipya, na mmiliki anaiidhinisha tena."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ பின்னர் இந்த %@ ஐ புதிய சாதனமாகக் காணும், மேலும் உரிமையாளர் அதை மீண்டும் அங்கீகரிப்பார்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ అప్పుడు ఈ %@ను కొత్త పరికరంగా చూస్తుంది, మరియు యజమాని దాన్ని మళ్లీ ఆమోదిస్తారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ он гоҳ ин %@-ро ҳамчун дастгоҳи нав мебинад ва соҳиб онро дубора тасдиқ мекунад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ จะเห็น %@ นี้เป็นอุปกรณ์ใหม่ และเจ้าของจะอนุมัติอีกครั้ง"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ soň bu %@-ny täze enjam hökmünde görýär we eýesi ony täzeden tassyklaýar."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ pea sio ki he %@ ko ha me‘angāue fo‘ou, pea fakangofua leva ‘e ha owner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ daha sonra bu %@’yi yeni bir aygıt olarak görür ve bir sahip onu yeniden onaylar."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ ئاندىن بۇ %@ نى يېڭى ئۈسكۈنە دەپ كۆرىدۇ، ئىگىسى قايتا تەستىقلايدۇ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ потім бачить цей %@ як новий пристрій, і власник знову його схвалює."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ پھر اس %@ کو نئے ڈیوائس کے طور پر دیکھتا ہے، اور کوئی مالک اسے دوبارہ منظور کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ sau đó xem %@ này như một thiết bị mới, và chủ sở hữu phê duyệt lại thiết bị."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ 之後會將呢個 %@ 視為新裝置，並由擁有人再次批准。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@ 会将此 %@ 视为新设备，所有者需再次批准。"
          }
        }
      }
    },
