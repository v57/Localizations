        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дійсний до %@, одноразово. У програмі Hub на іншому пристрої відкрийте **Підключити до хаба** та введіть %@ і цей код або відскануйте код нижче."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ تک کارآمد، ایک بار۔ دوسری ڈیوائس پر Hub ایپ میں **Connect to a Hub** کھولیں اور %@ اور یہ کوڈ درج کریں، یا نیچے دیا کوڈ اسکین کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Có hiệu lực đến %@, một lần. Trong ứng dụng Hub trên thiết bị khác, mở **Kết nối tới Hub** và nhập %@ cùng mã này, hoặc quét mã bên dưới."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "needs_review",
