        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সিহঁত বাহিৰত থাকিলে সুবিধাজনক: সিহঁত ইয়াত থকাৰ দৰেই ব্ৰাউজ কৰে।"
