        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಸ್ವಲ್ಪ ಸಮಯದಲ್ಲಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ. ಅದು ವಿಫಲವಾಗುತ್ತಲೇ ಇದ್ದರೆ, ಹೊಸ ಆಹ್ವಾನ ಕೇಳಿ."
