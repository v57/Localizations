    "A group gives its connections the permissions you tick. Owners always have every permission." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تمنح المجموعة اتصالاتها الأذونات التي تحددها. يمتلك المالكون دائمًا كل الأذونات."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المجموعة تعطي اتصالاتها الأذونات اللي تحدّدها. الملاك دايم عندهم كل الأذونات."
          }
        },
