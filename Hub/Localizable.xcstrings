          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার ফোন এমনভাবে ব্রাউজ করে যেন এটি এখানে ছিল: সাইটগুলো এই Mac-এর ঠিকানা দেখে। অন্য কারো সার্ভারের মাধ্যমে কিছুই যায় না; v57.dev কেবল দুটিকে একে অপরকে খুঁজে পেতে সাহায্য করে।"
