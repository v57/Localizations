        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जो Mac %@ चलाता है वह सोया हुआ या ऑफ़लाइन हो सकता है। उसके चालू होने पर फिर से प्रयास करें।"
