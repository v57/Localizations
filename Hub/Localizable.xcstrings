        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಚಲನೆಗಾಗಿ ಗಮನಿಸಿ ಕ್ಲಿಪ್‌ಗಳನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡುತ್ತದೆ. ಪಾಸ್‌ವರ್ಡ್‌ನೊಂದಿಗೆ Hub Network ನಲ್ಲಿರುವ %@ ನ ಸಾಧನಗಳು ಮಾತ್ರ ವೀಕ್ಷಿಸಬಹುದು. Hub ತೆರೆದಿರಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "움직임을 감시하고 클립을 녹화합니다. 비밀번호가 있는 Hub Network의 %@ 기기만 볼 수 있습니다. Hub를 계속 열어 두어야 합니다."
          }
        },
        "kok" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हालचाली खातीर पळयता आनी क्लिपी रेकॉर्ड करता. फकत पासवर्ड आशिल्ले Hub Network वयले %@ चीं डिव्हायसां पळोवंक शकतात. Hub उगतो दवरूंक जाय."
          }
        },
        "ks" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حرکت خٲطرٕ وُچھان تہٕ کلِپ ریکارڈ کَران۔ صِرِف Hub Network پؠٹھ %@ سٕنٛدؠ ڈیوائس پاسورڈ سٟتؠ ہێکَن وُچھِتھ۔ Hub آسُن گژھِہ کھُلہٕ روزُن۔"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tevgerê dişopîne û klîpan tomar dike. Tenê amûrên %@ li ser Hub Network bi şîfreyê dikarin temaşe bikin. Divê Hub vekirî bimîne."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кыймылды көзөмөлдөп, клиптерди жазат. Hub Network’төгү сырсөзү бар %@’нун түзмөктөрү гана көрө алат. Hub ачык турушу керек."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ເຝົ້າເບິ່ງການເຄື່ອນໄຫວ ແລະ ບັນທຶກຄລິບ. ມີພຽງອຸປະກອນຂອງ %@ ໃນ Hub Network ທີ່ມີລະຫັດຜ່ານເທົ່ານັ້ນທີ່ເບິ່ງໄດ້. Hub ຕ້ອງເປີດຄ້າງໄວ້."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stebi judesį ir įrašo klipus. Stebėti gali tik %@ įrenginiai tinkle „Hub Network“ su slaptažodžiu. „Hub“ turi likti atidarytas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Novēro kustību un ieraksta klipus. Skatīties var tikai %@ ierīces Hub Network ar paroli. Hub jāpaliek atvērtam."
          }
        },
        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "गतिक लेल देखैत अछि आ क्लिप रिकॉर्ड करैत अछि। मात्र Hub Network पर %@ क डिवाइससभ पासवर्डक संग देखि सकैत अछि। Hub खुलल रहबाक चाही।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ka mātaki mō te nekehanga, ka hopu topenga. Ko ngā pūrere o %@ anake i runga i Hub Network me te kupuhipa ka taea te mātakitaki. Me tuwhera tonu a Hub."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Набљудува движење и снима снимки. Само уредите на %@ на Hub Network со лозинката можат да гледаат. Hub мора да остане отворен."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ചലനം നിരീക്ഷിച്ച് ക്ലിപ്പുകൾ റെക്കോർഡ് ചെയ്യുന്നു. പാസ്‌വേഡുള്ള Hub Network-ലെ %@-ന്റെ ഉപകരണങ്ങൾക്ക് മാത്രം കാണാനാകും. Hub തുറന്നിരിക്കണം."
          }
        }
      }
    },
