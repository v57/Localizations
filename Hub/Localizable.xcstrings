        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ang mga hub mula bago nagkaroon ng sariling key ang bawat hub ay nananatili sa mga ito, gayundin ang hub na pinapatakbo ng %@ na ito."
