    "Connect to Wi-Fi or Ethernet so other devices can reach this hub." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اتصل بشبكة Wi-Fi أو Ethernet حتى تتمكن الأجهزة الأخرى من الوصول إلى هذا المركز."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اتصل بالواي فاي أو الإيثرنت عشان الأجهزة الثانية تقدر توصل لهالهب."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wi-Fi বা Ethernet-ত সংযোগ কৰক যাতে আন ডিভাইচবোৰে এই হাবক যোগাযোগ কৰিব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Digər cihazlar bu haba çata bilsin deyə Wi-Fi və ya Ethernet-ə qoşulun."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Падключыцеся да Wi-Fi або Ethernet, каб іншыя прылады маглі дасягнуць гэтага хаба."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Свържете се с Wi-Fi или Ethernet, за да могат други устройства да достигнат този хъб."
          }
        },
        "bn" : {
