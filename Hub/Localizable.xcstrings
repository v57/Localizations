        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हराएको वा सम्झौता भएको उपकरणका लागि। यसका जडानहरू बन्द हुन्छन्, यसको सेवा कुञ्जी रद्द हुन्छ, यसका अनुदान र हब नेटवर्क पियरहरू हटाइन्छन्, र यसलाई फेरि कहिल्यै अनुमोदन गर्न सकिँदैन। यसमुनि जोडिएका हरेक उपकरण पनि रद्द हुन्छन्।"
