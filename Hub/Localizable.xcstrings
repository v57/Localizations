        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ចលនាកន្លងខ្សែថតឃ្លីបមួយ៖ %@ នៃរូបភាពប្រែប្រួល។ រូបភាពទាំងមូលត្រូវបានរាប់។"
