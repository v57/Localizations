        "mni" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "নঙনা কৌরিবা ডিভাইসশিংনা হব অসিনা হোস্ট তৌরিবা প্রাইভেট নেটওয়ার্ক অমদা য়াওই। মফমসিদা মগী নোড সেট তৌ অমসুং ইনভিটেসনশিং শেমলু; ডিভাইস অসিগী মশাগী নেটওয়ার্ক এক্সটেনসন অসি অহানবা মেম্বর অমসুং কৌবা মী ওই।"
