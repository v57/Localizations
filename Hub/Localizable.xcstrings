    "%@ %@" : {
      "shouldTranslate" : false
    },
    "%@ (the default) · helps your devices find each other and never sees what they send" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ (الافتراضي) · يساعد أجهزتك على العثور على بعضها ولا يرى أبدًا ما ترسله"
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ (الافتراضي) · يساعد أجهزتك تلقى بعضها ولا يشوف وش ترسل أبد"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ (ডিফল্ট) · আপোনাৰ ডিভাইচবোৰে ইটোৱে সিটোক বিচাৰি উলিওৱাত সহায় কৰে আৰু সিহঁতে কি পঠায় সেয়া কেতিয়াও নাচায়"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ (standart) · cihazlarınızın bir-birini tapmasına kömək edir və göndərdiklərini heç vaxt görmür"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ (па змаўчанні) · дапамагае вашым прыладам знаходзіць адна адну і ніколі не бачыць, што яны перадаюць"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ (по подразбиране) · помага на устройствата ви да се намират взаимно и никога не вижда какво изпращат"
