        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಎಲ್ಲಿಂದಲಾದರೂ ನಿಮ್ಮ ಇತರ ಸಾಧನಗಳನ್ನು ತಲುಪಲು ಮತ್ತು ಅವು ಇದನ್ನು ತಲುಪಲು ಬಿಡಲು ಅದನ್ನು ಆನ್ ಮಾಡಿ."
