        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎠᎴ ᎾᏍᎩ ᎯᎠ %@ ᎠᎪᏩᏛ, ᎦᏚᏩᏛ ᎠᎴᏃ ᎢᏅᎠᏓᎴ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "و ئەوان دەتوانن بگەن بەم %@، لە ماڵەوە یان لە دەرەوە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A mohou se připojit k tomuto %@, doma i venku."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A gallant gyrraedd y %@ hwn, gartref neu i ffwrdd."
