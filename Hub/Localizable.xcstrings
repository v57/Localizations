    "%@ is about %@. Live view uses data only while someone watches. Clips assume %@ of motion a day (the last 7 days)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ يتعلق بـ %@. يستخدم العرض المباشر البيانات فقط أثناء المشاهدة. تفترض المقاطع %@ من الحركة يوميًا (آخر 7 أيام)."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ حجمه تقريبًا %@. البث المباشر يستهلك بيانات بس إذا أحد يتابع. المقاطع محسوبة على %@ حركة باليوم (آخر 7 أيام)."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ প্ৰায় %@। কোনোবাই চাই থাকোঁতেহে লাইভ ভিউৱে ডাটা ব্যৱহাৰ কৰে। ক্লিপবোৰে দিনে %@ গতি ধৰি লয় (যোৱা 7 দিন)।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ təxminən %@-dır. Canlı baxış yalnız kimsə izləyərkən trafik sərf edir. Kliplər gündə %@ hərəkət nəzərdə tutur (son 7 gün)."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ — гэта прыкладна %@. Жывы прагляд выкарыстоўвае даныя, толькі пакуль хтосьці глядзіць. Кліпы разлічаны на %@ руху ў дзень (за апошнія 7 дзён)."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ е около %@. Прегледът на живо използва данни само докато някой гледа. Клиповете приемат %@ движение на ден (последните 7 дни)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ প্রায় %@। কেউ দেখার সময়ই শুধু লাইভ ভিউ ডেটা ব্যবহার করে। ক্লিপগুলো দিনে %@ মোশন ধরে নেয় (গত 7 দিন)।"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@आ %@नि बागै। लाइभ भिउआ सासेया नायबाय थानाय समावल' डाटा बाहायो। क्लिपफोरा सानफ्रोमबो %@ मोशन थायो होनना सान्नाय जायो (थांनाय 7 सान)।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ és aproximadament %@. La visualització en directe només fa servir dades mentre algú mira. Els clips suposen %@ de moviment al dia (els últims 7 dies)."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ᎾᏍᎩ %@ ᎨᏒ. ᏗᎦᏔᏅ ᎠᎪᏩᏛ ᏗᏔ ᎯᎠ ᎠᎪᏩᏛᎢᏍᏗ. ᎩᎵᏈ %@ ᎢᎦ ᎠᏓᏅᏖᏛ (7 ᎢᎦ)."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ دەربارەی %@ ـە. بینینی ڕاستەوخۆ داتا بەکاردەهێنێت تەنها کاتێک کەسێک سەیری دەکات. کلیپەکان وا دادەنێن %@ جووڵە لە ڕۆژێکدا (٧ ڕۆژی ڕابردوو)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ je asi %@. Živé zobrazení využívá data jen když se někdo dívá. Klipy předpokládají %@ pohybu denně (posledních 7 dní)."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae %@ yn ymwneud â %@. Mae golwg fyw yn defnyddio data dim ond tra bo rhywun yn gwylio. Mae clipiau’n tybio %@ o symudiad y dydd (y 7 diwrnod diwethaf)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ er ca. %@. Livevisning bruger kun data, mens nogen ser med. Klip antager %@ bevægelse om dagen (de sidste 7 dage)."
