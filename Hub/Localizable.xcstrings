    "%@ isn’t online. It answers again once it wakes up and Hub runs on it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ غير متصل. سيستجيب مجددًا بمجرد استيقاظه وتشغيل Hub عليه."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ مو متصل. يرد مرة ثانية إذا صحى واشتغل عليه Hub."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ অনলাইন নহয়। সাৰ পাই Hub ইয়াত চলিলে ই পুনৰ সঁহাৰি দিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ onlayn deyil. Oyanıb üzərində Hub işlədikdən sonra yenidən cavab verəcək."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ не ў сетцы. Яно зноў адкажа, калі прачнецца і на ім запусціцца Hub."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ не е на линия. Ще отговори отново, след като се събуди и Hub стартира на него."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ অনলাইন নেই। এটি জেগে উঠলে এবং এতে Hub চললে আবার সাড়া দেবে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ དྲ་ཐོག་མིན། ཁོ་སད་ནས་ཁོར Hub འགྲོ་བཞིན་དུས་བསྐྱར་དུ་ལན་འདེབས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@आ अनलाइन नङा। बेयो गोजोननायनिफ्राय सिखांनानै आरो बेयाव हबआ रन जायोब्ला फिन फिनगोन।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ no està en línia. Tornarà a respondre quan es desperti i Hub s'hi executi."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ᎥᏝ ᎠᎭ. ᏔᎵᏁ ᎠᏛᏅᏙ ᎢᏳᏃ ᏗᏂᏙᎢ ᎠᎴ Hub ᎬᏔᏅᎢ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ئۆنلاین نییە. جارێکی تر وەڵام دەداتەوە کاتێک لە خەو هەڵدەستێت و Hub لەسەری کاردەکات."
          }
