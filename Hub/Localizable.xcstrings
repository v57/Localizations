          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ قابلِ اعتماد نہیں ہیں۔ پہلے ان پر اعتماد کریں، یا لاک ڈاؤن آن کریں تو وہ منقطع ہو جائیں گے۔"
