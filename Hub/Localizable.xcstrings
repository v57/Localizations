        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনি যে ডিভাইসগুলোকে আমন্ত্রণ জানান সেগুলো এই হাব হোস্ট করা একটি ব্যক্তিগত নেটওয়ার্কে যোগ দেয়। এর নোড সেট করুন এবং এখানে আমন্ত্রণ তৈরি করুন; এই ডিভাইসের নিজের নেটওয়ার্ক এক্সটেনশন প্রথম সদস্য ও আমন্ত্রণকারী।"
