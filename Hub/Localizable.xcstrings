        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το %@ δεν κοινοποιεί ακόμη εφαρμογές. Μπορεί να φτάσει τις συσκευές σας και αυτές μπορούν να το φτάσουν."
