        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ສິ້ນສຸດການເຊື່ອມຕໍ່ທັງໝົດກັບ %@. ອຸປະກອນທີ່ຍັງໄດ້ຮັບອະນຸຍາດຈະເຊື່ອມຕໍ່ໃໝ່ດ້ວຍສິດເຂົ້າເຖິງໃໝ່."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutraukia visus ryšius su %@. Įrenginiai, kuriems vis dar leidžiama, prisijungia iš naujo su nauja prieiga."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
