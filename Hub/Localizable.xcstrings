        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अहाँक फोन एहन ब्राउज़ करैत अछि जेना ई एतहि हो: साइटसभ एहि Mac क पता देखैत अछि। किछु आन ककरो सर्वर सँ नहि गुजरैत अछि; v57.dev मात्र दूनू केँ एक-दोसर केँ खोजामे मदद करैत अछि।"
