        "mai" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ लगभग %@ अछि। लाइव व्यू मात्र तखन डेटा उपयोग करैत अछि जखन कोनो देखैत अछि। क्लिपसभ दिनमे %@ गति मानैत अछि (पिछला 7 दिन)।"
