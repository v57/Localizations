    "Try again in a moment. If it keeps failing, ask for a new invitation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حاول مجددًا بعد لحظة. إذا استمر الفشل، اطلب دعوة جديدة."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حاول مرة ثانية بعد شوي. إذا لسه يفشل، اطلب دعوة جديدة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কিছু সময় পিছত পুনৰ চেষ্টা কৰক। বাৰে বাৰে বিফল হ’লে, নতুন আমন্ত্ৰণ বিচাৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir azdan yenidən cəhd et. Uğursuzluq davam edərsə, yeni dəvət istə."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Паспрабуйце зноў праз момант. Калі працягвае не атрымлівацца, папрасіце новае запрашэнне."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Опитайте отново след малко. Ако продължава да се проваля, поискайте нова покана."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কিছুক্ষণ পরে আবার চেষ্টা করুন। ব্যর্থ হতে থাকলে, একটি নতুন আমন্ত্রণ চান।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "སྐར་ཆར་ཞིག་ནས་བསྐྱར་ཚོད། རྒྱུན་མ་ཐུབ་ན་གདན་ཞུ་གསར་འདྲི།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "खिन्थायाव फिन नाजाद। बेयो गोबावसो फेलेङाब्ला, गोदान लिंहरनाय बिहर।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Torna-ho a provar d'aquí un moment. Si continua fallant, demana una nova invitació."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᏧᏍᏗ ᎢᏤ ᏥᏭᎦᏔᏅ. ᎢᏳᏃ ᎠᏏ ᎤᏲᎢᏍᏗ, ᎢᏤ ᏓᏅᏙ ᎠᏛᏅᏙ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دوای ساتێک دووبارە هەوڵبدە. ئەگەر هەر سەرکەوتوو نەبوو، داوای بانگهێشتێکی نوێ بکە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zkuste to znovu za chvíli. Pokud to stále selhává, požádejte o novou pozvánku."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ceisiwch eto ymhen eiliad. Os yw'n parhau i fethu, gofynnwch am wahoddiad newydd."
