    "Hub needs it to connect your devices. Try again and choose Allow." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحتاج Hub إليه لتوصيل أجهزتك. حاول مجددًا واختر السماح."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub يحتاجه عشان يوصل أجهزتك. حاول مرة ثانية واختر سماح."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপোনাৰ ডিভাইচবোৰ সংযোগ কৰিবলৈ Hub-ক ইয়াৰ প্ৰয়োজন। পুনৰ চেষ্টা কৰক আৰু Allow বাছক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub-a cihazlarınızı qoşmaq üçün bu lazımdır. Yenidən cəhd edin və İcazə Ver seçin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хабу гэта трэба, каб злучыць вашы прылады. Паспрабуйце зноў і выберыце Дазволіць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub се нуждае от него, за да свърже устройствата ви. Опитайте отново и изберете Allow."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার ডিভাইসগুলো সংযোগ করতে হাবের এটি দরকার। আবার চেষ্টা করুন এবং Allow বেছে নিন।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཁྱེད་ཀྱི་སྒྲིག་ཆས་འབྲེལ་ཕྱིར་Hub ལ་དགོས། བསྐྱར་ཚོད་དང་ ཆོག སེལ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नोंनि डिभाइसफोरखौ कनेक्ट खालामनो Hubआ बेखौ नांगौ। फिन नाजाला आरो Allowखौ सायख।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub ho necessita per connectar els teus dispositius. Torna-ho a provar i tria Permet."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub ᎾᏍᎩ ᎠᏓᏅᏙ ᏗᏧᎦᏔᏅᎯ ᏥᏓᏓᏅᏙᏱ. ᎢᏤ ᎢᏛᏓ ᎠᎴ Allow ᎯᏥᏯ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub پێویستیەتی بۆ پەیوەستکردنی ئامێرەکانت. دووبارە تاقی بکەرەوە و ڕێگەبدە هەڵبژێرە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub to potřebuje k propojení vašich zařízení. Zkuste to znovu a zvolte Povolit."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae ei angen ar Hub i gysylltu eich dyfeisiau. Rhowch gynnig arall arni a dewiswch Caniatáu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub skal bruge den for at forbinde dine enheder. Prøv igen, og vælg Tillad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub braucht es, um deine Geräte zu verbinden. Versuche es erneut und wähle Erlauben."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हब गी तुहाडे डिवाइस जोड़ने आस्ते इसदी लोड़ है। दुबारा कोशिश करो ते अनुमति चुनो।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ތިޔަބޭފުޅާގެ ޑިވައިސްތައް ކަނެކްޓްކުރަން Hub އަށް އެބޭނުންވޭ. އަލުން ޓްރައިކޮށް Allow ހޮއްވަވާ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Hub το χρειάζεται για να συνδέσει τις συσκευές σας. Δοκιμάστε ξανά και επιλέξτε Αποδοχή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub lo necesita para conectar tus dispositivos. Inténtalo de nuevo y elige Permitir."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub vajab seda teie seadmete ühendamiseks. Proovige uuesti ja valige Luba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هاب برای اتصال دستگاه‌های شما به آن نیاز دارد. دوباره امتحان کنید و «اجازه دادن» را انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub tarvitsee sen yhdistääkseen laitteesi. Yritä uudelleen ja valitse Salli."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kailangan ito ng Hub para ikonekta ang mga device mo. Subukan ulit at piliin ang Allow."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub krevur tað fyri at samantvinna eindirnar tínar. Royn aftur og vel Loyv."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub en a besoin pour connecter vos appareils. Réessayez et choisissez Autoriser."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teastaíonn sé ó Hub chun do ghléasanna a nascadh. Bain triail eile as agus roghnaigh Ceadaigh."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "તમારા ડિવાઇસને કનેક્ટ કરવા માટે Hub ને તેની જરૂર છે. ફરી પ્રયાસ કરો અને મંજૂર પસંદ કરો."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pono ʻo Hub iā ia e hoʻohui i kāu mau mea. E hoʻāʻo hou a koho iā ʻAe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hub זקוק לזה כדי לחבר את המכשירים שלך. נסה שוב ובחר אפשר."
          }
        },
