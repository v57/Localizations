    "Services connect with their key and post their APIs here. Install one, or run your own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتصل الخدمات بمفتاحها وتنشر واجهات API الخاصة بها هنا. ثبّت واحدة، أو شغّل خدمتك الخاصة."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الخدمات تتصل بمفتاحها وتنشر الـ APIs حقتها هنا. ثبّت وحدة، أو شغّل حقتك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সেৱাবোৰে সিহঁতৰ কীৰে সংযোগ কৰে আৰু ইয়াত সিহঁতৰ API প’ষ্ট কৰে। এটা ইনষ্টল কৰক, বা নিজৰটো চলাওক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xidmətlər açarları ilə qoşulur və API-lərini burada dərc edir. Birini quraşdır və ya özünkünü işə sal."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сэрвісы падключаюцца са сваім ключом і публікуюць тут свае API. Усталюйце адзін або запусціце свой."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Услугите се свързват със своя ключ и публикуват своите API тук. Инсталирайте такава или стартирайте своя."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পরিষেবাগুলো তাদের কী দিয়ে সংযোগ করে এবং এখানে তাদের API পোস্ট করে। একটি ইনস্টল করুন, অথবা নিজেরটি চালান।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཞབས་ཞུ་ཚོས་རང་གི་ལྡེ་མིག་གིས་འབྲེལ་ནས་ API འདིར་སྤེལ། ཞིག་སྒྲིགས་ ཡང་ན་རང་གི་སྤེལ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सार्भिसफोरा गावनि चाबिजों सोमोन्दो लाखियो आरो बिसोरनि APIफोरखौ बेयाव पोस्ट खालामो। मोनसेखौ इनस्टल खालाम, ना गावनि जौगाखौ चलाय।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els serveis es connecten amb la seva clau i publiquen aquí les seves API. Instal·la'n un o executa'n el teu."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᏗᎠᎵᏍᏙᏗ ᏧᏂᏔᏅ ᏗᏧᎦᏔᏅ ᎠᎴ ᏧᏂᏔᏅ APIs ᎯᎠ. ᎢᏤ ᎢᏧᏍᏔᏅ, ᎠᎴᏃ ᏣᎵᏍᏙᏓ ᏣᏤᎵ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خزمەتگوزارییەکان بە کلیلەکەیان پەیوەست دەبن و APIـەکانیان لێرە دادەنێن. دانەیەک دامەزرێنە، یان هی خۆت کارپێبکە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Služby se připojují svým klíčem a zveřejňují zde svá API. Nainstalujte si nějakou, nebo provozujte vlastní."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae gwasanaethau'n cysylltu â'u hallwedd ac yn postio eu APIs yma. Gosodwch un, neu rhedwch eich un eich hun."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tjenester forbinder med deres nøgle og lægger deres API'er her. Installer en, eller kør din egen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dienste verbinden sich mit ihrem Schlüssel und veröffentlichen hier ihre APIs. Installiere einen oder betreibe einen eigenen."
          }
        },
        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सेवां अपनी कुंजी नाल जुड़दियां न ते अपने API इ’त्थे पोस्ट करदियां न। इक इंस्टॉल करो, या अपनी चलाओ।"
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ސާވިސްތައް ކީއާއެކު ކޮނެކްޓްވެ އެމީހުންގެ API ތައް މިތަނަށް ޕޯސްޓްކުރޭ. އެއް ސާވިސް އިންސްޓޯލްކުރޭ، ނުވަތަ އަމިއްލައަށް ހިންގޭ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι υπηρεσίες συνδέονται με το κλειδί τους και δημοσιεύουν τα API τους εδώ. Εγκαταστήστε μία ή εκτελέστε τη δική σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
