        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक्सपोजार आरो कलार 10 सेकेन्डाव सोलायो, फ्रेमफ्रोमबो नङा।"
          }
        },
        "ca" : {
          "stringUnit" : {
