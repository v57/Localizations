            "value" : "Stabilisering på där kameran har det; fokus, exponering och färg justeras hela tiden."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uthabiti pale kamera inapokuwa nayo; fokasi, mwangaza na rangi hurekebishwa kila wakati."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "கேமராவில் உள்ள இடத்தில் நிலைப்படுத்தல் இயக்கத்தில்; ஃபோகஸ், எக்ஸ்போஷர் மற்றும் நிறம் எப்போதும் சரிசெய்யப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "కెమెరాకు ఉన్నచోట స్థిరీకరణ ఆన్; ఫోకస్, ఎక్స్‌పోజర్ మరియు రంగు ఎల్లప్పుడూ సర్దుబాటు అవుతాయి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дар ҷое ки камера дорад, устуворсозӣ фурӯзон; фокус, экспозитсия ва ранг ҳамеша танзим мешаванд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เปิดระบบกันสั่นในจุดที่กล้องรองรับ โฟกัส ค่าแสง และสีจะปรับตลอดเวลา"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kamerada bar ýerinde durnuklaşdyrma açyk; fokus, ekspozisiýa we reňk hemişe sazlanýar."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "’Oku 'on 'a e stabilization 'i he feitu'u 'oku ma'u ai 'e he kāmela; 'oku fetu'utaki ma'u pē 'a e focus, exposure mo e lanu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kamerada varsa stabilizasyon açık; odak, pozlama ve renk her zaman ayarlanır."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كامېرادا بولسا تۇراقلاشتۇرۇش ئوچۇق؛ فوكۇس، يورۇقلۇق ۋە رەڭ دائىم تەڭشىلىدۇ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стабілізація там, де її має камера; фокус, експозиція та колір налаштовуються постійно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جہاں کیمرے میں ہو اسٹیبلائزیشن آن؛ فوکس، ایکسپوزر اور رنگ ہر وقت ایڈجسٹ ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bật ổn định hình ảnh ở camera có hỗ trợ; lấy nét, phơi sáng và màu sắc điều chỉnh liên tục."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有防震功能嘅相機會開啟防震；對焦、曝光同色彩會持續調整。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有防抖的摄像头会开启防抖；对焦、曝光和色彩将持续调整。"
          }
        }
      }
    },
