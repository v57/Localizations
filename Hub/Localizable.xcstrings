        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បើកវាដើម្បីទាក់ទងឧបករណ៍ផ្សេងទៀតរបស់អ្នកពីគ្រប់ទីកន្លែង និងដើម្បីអនុញ្ញាតឱ្យពួកវាទាក់ទងឧបករណ៍នេះ។"
