        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "হারিয়ে যাওয়া বা আপসকৃত ডিভাইসের জন্য। এর সংযোগগুলো বন্ধ হয়, এর %lldটি সার্ভিস কী বাতিল হয়, এর গ্রান্ট ও হাব নেটওয়ার্ক পিয়ার সরানো হয়, এবং এটি আর কখনো অনুমোদন পাবে না। এর নিচে সংযুক্ত প্রতিটি ডিভাইসও বাতিল হয়।"
