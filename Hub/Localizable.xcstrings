          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ הוא בערך %@. צפייה חיה משתמשת בנתונים רק בזמן שמישהו צופה. קליפים מניחים %@ תנועה ביום (7 הימים האחרונים)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ लगभग %@ है। लाइव व्यू केवल जब कोई देखता है तभी डेटा उपयोग करता है। क्लिप प्रतिदिन %@ मोशन मानते हैं (पिछले 7 दिन)।"
