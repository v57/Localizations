        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ болжол менен %@. Түз көрүү маалыматты бирөө карап жатканда гана колдонот. Клиптер күнүнө %@ кыймыл деп эсептелет (акыркы 7 күн)."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ແມ່ນປະມານ %@. ການເບິ່ງສົດໃຊ້ຂໍ້ມູນສະເພາະຕອນມີຄົນເບິ່ງ. ຄລິບຄາດຄະເນວ່າມີການເຄື່ອນໄຫວ %@ ຕໍ່ມື້ (7 ມື້ຫຼ້າສຸດ)."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ yra apie %@. Tiesioginė peržiūra naudoja duomenis tik kol kas nors stebi. Įrašams numatoma %@ judesio per dieną (paskutinės 7 dienos)."
