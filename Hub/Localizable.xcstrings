    "Translation feature was introduced in %@ and %@ for devices with %@ so it's not possible to run it on other devices or lower versions" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تم تقديم ميزة الترجمة في %@ و %@ للأجهزة المزودة بـ %@ لذلك لا يمكن تشغيلها على أجهزة أخرى أو إصدارات أقدم"
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ميزة الترجمة نزلت في %@ و %@ للأجهزة اللي فيها %@ فما يمكن تشغيلها على أجهزة ثانية أو إصدارات أقل"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অনুবাদ সুবিধা %@ আৰু %@-ত %@ থকা ডিভাইচৰ বাবে আৰম্ভ কৰা হৈছিল সেয়ে আন ডিভাইচ বা নিম্ন সংস্কৰণত চলোৱা সম্ভৱ নহয়"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tərcümə funksiyası %@ və %@-də %@ olan cihazlar üçün təqdim olunub, ona görə onu digər cihazlarda və ya aşağı versiyalarda işlətmək mümkün deyil"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Функцыя перакладу з'явілася ў %@ і %@ для прылад з %@, таму яе немагчыма запусціць на іншых прыладах або ранейшых версіях"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Функцията за превод беше въведена в %@ и %@ за устройства с %@, затова не е възможно да работи на други устройства или по-ниски версии"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অনুবাদ বৈশিষ্ট্য %@ এবং %@-এ %@ সহ ডিভাইসগুলোর জন্য চালু করা হয়েছিল তাই অন্য ডিভাইস বা নিম্ন সংস্করণে এটি চালানো সম্ভব নয়"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "སྒྱུར་བྱའི་ཁྱད་ཆོས་ %@ དང་ %@ ནང་ %@ ཡོད་པའི་སྒྲིག་ཆསར་སྤེལ། དེས་སྒྲིག་ཆས་གཞན་སམ་གཞི་རིམ་དམའ་བར་འགྲོ་མི་ཐུབ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "राव सोलाय हाबआ %@ आरो %@आव जाहाजदों %@ थानाय डिभाइसफोरनि थाखाय बेनिखाय गुबुन डिभाइस ना गाहाय भर्सनफोराव बेखौ चलायनो हानाय नङा"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La funció de traducció es va introduir a %@ i %@ per a dispositius amb %@, per la qual cosa no és possible executar-la en altres dispositius o versions anteriors"
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎦᏬᏂᎯᏍᏗ ᏗᎦᏔᏅ %@ ᎠᎴ %@ ᏧᏂᏔᏅ ᏗᏧᎦᏔᏅᎯ %@ ᎠᎴ ᎢᏳᏒ, ᎾᏍᎩ ᎥᏝ ᏴᎦᎵᏍᏙᏓ Ꮭ ᏗᏧᎦᏔᏅᎯ ᎠᎴᏃ ᎡᎳᏗ versions"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تایبەتمەندی وەرگێڕان لە %@ و %@ ـدا بۆ ئامێرەکانی %@ ناسێنرا، بۆیە ناکرێت لە ئامێرەکانی تر یان وەشانە کۆنترەکان بەکاربهێنرێت"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funkce překladu byla představena v %@ a %@ pro zařízení s %@, takže ji nelze provozovat na jiných zařízeních ani nižších verzích"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cyflwynwyd y nodwedd gyfieithu yn %@ a %@ ar gyfer dyfeisiau gyda %@ felly nid yw'n bosibl ei rhedeg ar ddyfeisiau eraill neu fersiynau is"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
