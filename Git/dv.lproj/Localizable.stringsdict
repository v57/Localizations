			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@، %2$@ އަދި %3$lld އިތުރު</string>
			<key>other</key>
			<string>%1$@، %2$@ އަދި %3$lld އިތުރު</string>
