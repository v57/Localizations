		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld मध्ये %@ ब्लकलाई छनोट आवश्यक छ</string>
			<key>other</key>
			<string>%lld मध्ये %@ ब्लकहरूलाई छनोट आवश्यक छ</string>
		</dict>
	</dict>
