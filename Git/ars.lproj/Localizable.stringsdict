<plist version="1.0">
<dict>
	<key> Your %lld commits stay.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>كومتاتك الـ%lld تبقى.</string>
			<key>many</key>
			<string>كومتاتك الـ%lld تبقى.</string>
			<key>one</key>
			<string>كومت واحد لك يبقى.</string>
			<key>other</key>
			<string>كومتاتك الـ%lld تبقى.</string>
			<key>two</key>
			<string>كومتين لك تبقى.</string>
			<key>zero</key>
			<string>كومتاتك الـ%lld تبقى.</string>
		</dict>
	</dict>
	<key>%@ of %lld blocks need a choice</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%1$@ من %2$lld بلوكات تحتاج اختيار</string>
			<key>many</key>
			<string>%1$@ من %2$lld بلوك يحتاج اختيار</string>
			<key>one</key>
			<string>%1$@ من بلوك واحد يحتاج اختيار</string>
			<key>other</key>
