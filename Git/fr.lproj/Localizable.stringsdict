<dict>
	<key> Your %lld commits stay.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>Vos %lld commits sont conservés.</string>
			<key>one</key>
			<string>Votre %lld commit est conservé.</string>
			<key>other</key>
			<string>Vos %lld commits sont conservés.</string>
		</dict>
	</dict>
