<dict>
	<key> Your %lld commits stay.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Ваши %lld коммита остаются.</string>
			<key>many</key>
			<string>Ваши %lld коммитов остаются.</string>
			<key>one</key>
			<string>Ваш %lld коммит остаётся.</string>
			<key>other</key>
			<string>Ваши %lld коммитов остаются.</string>
		</dict>
	</dict>
	<key>%@ of %lld blocks need a choice</key>
