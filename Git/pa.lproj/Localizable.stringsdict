<dict>
	<key> Your %lld commits stay.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਤੁਹਾਡਾ %lld ਕਮਿਟ ਰਹਿੰਦਾ ਹੈ।</string>
			<key>other</key>
			<string>ਤੁਹਾਡੇ %lld ਕਮਿਟ ਰਹਿੰਦੇ ਹਨ।</string>
		</dict>
	</dict>
