			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਬਲਾਕ ਵਿੱਚੋਂ %@ ਨੂੰ ਚੋਣ ਦੀ ਲੋੜ ਹੈ</string>
			<key>other</key>
			<string>%lld ਬਲਾਕਾਂ ਵਿੱਚੋਂ %@ ਨੂੰ ਚੋਣ ਦੀ ਲੋੜ ਹੈ</string>
		</dict>
	</dict>
