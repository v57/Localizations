		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ no %2$lld bloka nepieciešama izvēle</string>
			<key>other</key>
			<string>%1$@ no %2$lld blokiem nepieciešama izvēle</string>
			<key>zero</key>
