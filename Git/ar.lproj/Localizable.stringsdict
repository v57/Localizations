<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key> Your %lld commits stay.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>تبقى %lld التزامات لك.</string>
			<key>many</key>
			<string>يبقى %lld التزامًا لك.</string>
			<key>one</key>
			<string>يبقى التزام واحد لك.</string>
			<key>other</key>
			<string>يبقى %lld التزام لك.</string>
			<key>two</key>
			<string>يبقى التزامان لك.</string>
			<key>zero</key>
			<string>تبقى %lld التزام لك.</string>
		</dict>
	</dict>
	<key>%@ of %lld blocks need a choice</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%1$@ من %2$lld كتل تحتاج إلى اختيار</string>
			<key>many</key>
			<string>%1$@ من %2$lld كتلة تحتاج إلى اختيار</string>
			<key>one</key>
			<string>%1$@ من كتلة واحدة يحتاج إلى اختيار</string>
			<key>other</key>
			<string>%1$@ من %2$lld كتلة تحتاج إلى اختيار</string>
			<key>two</key>
			<string>%1$@ من كتلتين يحتاج إلى اختيار</string>
			<key>zero</key>
			<string>%1$@ من %2$lld كتلة يحتاج إلى اختيار</string>
		</dict>
	</dict>
