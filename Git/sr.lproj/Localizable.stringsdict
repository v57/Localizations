<dict>
	<key> Your %lld commits stay.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Ваша %lld комита остају.</string>
			<key>one</key>
			<string>Ваш %lld комит остаје.</string>
			<key>other</key>
			<string>Ваши %lld комитови остају.</string>
		</dict>
	</dict>
	<key>%@ of %lld blocks need a choice</key>
