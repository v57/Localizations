			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@, %2$@, %3$lld കൂടി</string>
			<key>other</key>
			<string>%1$@, %2$@, %3$lld കൂടി</string>
		</dict>
