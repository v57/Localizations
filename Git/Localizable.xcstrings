        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use git ᎢᏤᎢ, ᎾᏍᎩ git ᏂᎯ ᎠᏤᎵ ᎨᏒ ᏗᏂᎸᏫᏍᏓᏁᏗ ᎠᎴ ᎠᎵᏍᏕᎸᏗᏍᎩ, ᎾᏍᎩ ᎢᏳᏃ passphrase ᎠᎴ Touch ID ᎠᏓᏳᎶᏒ ᏧᏔᏅᎯ ᎠᏝᎥ ᏱᏚᎦᏔᏅᎢ."
