        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ আঁতৰায় আৰু %@ ক শেষ কমিটত যেনে আছিল তেনেকৈ ঘূৰাই দিয়ে, unstaged পৰিৱৰ্তনো। আগতে সোধে; আপুনি ইয়াক undo কৰিব নোৱাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-i silir və %@-i son kommitdəki vəziyyətinə qaytarır, stage-ə əlavə edilməmiş dəyişikliklər də daxil. Əvvəlcə soruşur; bunu geri ala bilməzsiniz."
