    "Vault key only is on, and git on that device signs in with its own keys." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مفتاح الخزنة فقط مفعّل، ويسجّل git على ذلك الجهاز الدخول بمفاتيحه الخاصة."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وضع مفتاح الخزنة بس شغّال، و git على هاك الجهاز يسجّل دخول بمفاتيحه الخاصة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কেৱল Vault কি অন আছে, আৰু সেই ডিভাইচত git-এ নিজা কিৰে ছাইন ইন কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yalnız anbar açarı aktivdir və həmin cihazda git öz açarları ilə daxil olur."
