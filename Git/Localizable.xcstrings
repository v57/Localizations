        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use git आव बेयो नोङनि सेटअप जों git खौ चलायो, बेखायनो पासफ्रेज एबा Touch ID नांगौनाय किआ सोंनो हायो।"
