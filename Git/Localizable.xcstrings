    "%@ isn't a Git repository yet. Create one there to track its files; once it has a commit, Publish puts it on GitHub." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ليس مستودع Git بعد. أنشئ واحدًا هناك لتتبع ملفاته؛ وبمجرد أن يحتوي على التزام، فإن النشر يضعه على GitHub."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ للحين مو مستودع Git. أنشئ واحد هناك لتتبع ملفاته؛ وإذا صار فيه كومت، النشر يحطه على GitHub."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ এতিয়াও Git ৰিপ’জিটৰি হোৱা নাই। ইয়াৰ ফাইল ট্ৰেক কৰিবলৈ তাত এটা বনাওক; এটা কমিট হ’লেই Publish-এ GitHub ত দিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hələ Git repozitoriyası deyil. Fayllarını izləmək üçün orada yaradın; kommit olduqdan sonra Publish onu GitHub-a yerləşdirir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ яшчэ не рэпазіторый Git. Стварыце яго там, каб адсочваць файлы; як толькі ў ім з'явіцца коміт, Publish змесціць яго на GitHub."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ все още не е Git хранилище. Създайте такова там, за да следите файловете му; след като има къмит, Publish го качва в GitHub."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ এখনও Git রিপোজিটরি নয়। এর ফাইল ট্র্যাক করতে সেখানে একটি তৈরি করুন; একবার কমিট হলে, Publish এটিকে GitHub-এ রাখে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ད་དུང་གིཊ་གསོག་མཛོད་མིན། ཡིག་ཆ་ཉར་བར་དེར་གསར་བཟོ། ཀོ་མིཊ་ཡོད་རྗེས་ Publish ཡིས་ GitHub ལ་སྐྱེལ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ आ दासिम Git रिपजिटरी नङ। बेनि फाइलफोरखौ ट्रेक खालामनो बेयाव मोनसेखौ सोरजि; मोनसे कमिट थानाय उनाव, Publish आ बेखौ GitHub आव दोनगोन।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ encara no és un repositori Git. Crea'n un per fer el seguiment dels fitxers; quan tingui un commit, Publica el posa a GitHub."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ᎠᏏ ᎾᎿ Git ᦎᏚᏩᎲ ᏂᎨᏒᎾ ᏥᏳ. ᎾᎿ ᎢᏤ ᎢᏳᎴᏗ ᏥᏄᏍᏔᏅ ᏗᏕᎶᏆᏍᏙᏗ ᏗᎧᏃᎲᏍᎩ; ᎢᏳᏃ commit ᎢᏳᏩᏁᎸᎢ, Publish ᎠᎴ GitHub ᏫᏚᏔᏅᎢ."
          }
        },
        "ckb" : {
          "stringUnit" : {
