            "value" : "%@ केँ %@ सँ हटबैत अछि; जे आहाँ स्टेज कएलहुँ से रहैत अछि। पहिने पुछैत अछि; आहाँ एकरा अनडू नहि कऽ सकैत छी।"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ka tango i a %@ mai i %@; ka mau ngā mea i whakaritehia e koe. Ka pātai i te tuatahi; e kore e taea te wetewete."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Го отстранува %@ од %@; она што го подготвивте останува. Прво прашува; не можете да го вратите ова."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-ൽ നിന്ന് %@ നീക്കം ചെയ്യുന്നു; നിങ്ങൾ സ്റ്റേജ് ചെയ്തത് നിലനിൽക്കും. ആദ്യം ചോദിക്കും; ഇത് തിരിച്ചെടുക്കാനാകില്ല."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-г %@-ээс хасна; таны stage хийсэн зүйл үлдэнэ. Эхлээд асууна; үүнийг буцаах боломжгүй."
          }
        },
        "mni" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ বু %@ দগী লৌথোকই; নঙনা স্টেজ তৌখিবদু লৈহৌরি। মমাংদা হংগনি; অমুক হনজিনবা ঙমদে।"
