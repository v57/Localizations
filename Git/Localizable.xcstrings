        },
        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use git ގައި، އެއިން ތިޔަބޭފުޅާގެ އަމިއްލަ ސެޓަޕާއެކު git ރަންކުރެއެވެ، އެހެންވެ ޕާސްފްރޭޒް ނުވަތަ Touch ID ބޭނުންވާ ކީއެއް ސުވާލުކުރެދާނެއެވެ."
