        "dv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ނައްތާލައި %@ އެންމެ ފަހު ކޮމިޓްގައި އޮތް ގޮތަށް އަނބުރާ ލައެވެ، unstaged ބަދަލުތައްވެސް. ކުރިން އަހާނެއެވެ؛ މި އަންޑޫނުކުރެވޭ."
