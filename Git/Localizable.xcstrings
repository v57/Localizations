        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vault कि मात्रमा, HTTPS रिमोट भएका रिपोजिटरीहरू तपाईंका लागि पर्खन्छन्, र तपाईंका अन्य उपकरणहरूमा भएकाहरू छुट्छन्।"
