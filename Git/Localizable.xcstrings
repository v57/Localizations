        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ལ་བྲཱནཆ་གསར་པ་འགོ་འཛུགས། སྔོན་དུ་མིང་འདོགས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ आव गोदान ब्रान्च जागायगोन। नों सिगाङाव बेनो मुं दोनगोन।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comença una nova branca a %@. Li poses nom abans."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎢᏤ branch %@ ᎾᎿ ᎠᎵᏍᏓᏴᏗ. ᎢᎬᏱ ᏕᎪᏔᏅ ᎯᏁᎲ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
