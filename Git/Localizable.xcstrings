        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يبدأ برانش جديد عند %@. تسمّيه أول."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ত এটা নতুন ব্ৰাঞ্চ আৰম্ভ কৰে। আপুনি আগতে ইয়াৰ নাম দিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-də yeni budaq başlayır. Əvvəlcə siz onu adlandırırsınız."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пачынае новую галіну ў %@. Спачатку вы яе называеце."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Започва нов клон в %@. Първо го именувате."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-এ নতুন ব্রাঞ্চ শুরু করে। আপনি প্রথমে নাম দেন।"
