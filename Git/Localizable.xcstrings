    "Later commits are removed from the branch. Their changes stay in the working tree, so you can commit them again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُزال الالتزامات اللاحقة من الفرع. تبقى تغييراتها في شجرة العمل، لتتمكن من الالتزام بها مرة أخرى."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الكومتات اللاحقة تنشال من الفرع. تغييراتها تبقى في شجرة العمل، فتقدر تثبتها مرة ثانية."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পিছৰ কমিটবোৰ ব্ৰাঞ্চৰ পৰা আঁতৰোৱা হয়। সেইবোৰৰ পৰিৱৰ্তন working tree-ত থাকে, সেয়ে আপুনি সেইবোৰ আকৌ কমিট কৰিব পাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sonrakı kommitlər budaqdan silinir. Onların dəyişiklikləri iş ağacında qalır, ona görə onları yenidən kommit edə bilərsiniz."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пазнейшыя каміты выдаляюцца з галінкі. Іх змены застаюцца ў працоўным дрэве, таму вы можаце закаміціць іх зноў."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "По-късните къмити се премахват от клона. Промените им остават в работното дърво, за да можете да ги къмитнете отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পরের কমিটগুলো ব্রাঞ্চ থেকে সরানো হয়। তাদের পরিবর্তন working tree-তে থাকে, তাই আপনি আবার কমিট করতে পারেন।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "རྗེས་ཀྱི་ཀོ་མིཊ་ཡན་ལག་ལས་བསུབ། དེའི་འགྱུར་བ་ལས་བྱེད་ཁུལ་དུ་གནས། སླར་ཀོ་མིཊ་བྱ་ཐུབ།"
          }
        },
        "brx" : {
