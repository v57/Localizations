    "%@ aren't Git repositories yet. Create one in each to track their files; once they have a commit, Publish puts them on GitHub." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ليست مستودعات Git بعد. أنشئ واحدًا في كل منها لتتبع ملفاتها؛ وبمجرد أن تحتوي على التزام، فإن النشر يضعها على GitHub."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ للحين مو مستودعات Git. أنشئ واحد في كل واحد لتتبع ملفاتها؛ وإذا صار فيها كومت، النشر يحطها على GitHub."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ এতিয়াও Git ৰিপ’জিটৰি হোৱা নাই। সেইবোৰৰ ফাইল ট্ৰেক কৰিবলৈ প্ৰতিটোতে এটাকৈ বনাওক; এটা কমিট হ’লেই Publish-এ সেইবোৰ GitHub ত দিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hələ Git repozitoriyası deyil. Fayllarını izləmək üçün hər birində yaradın; kommit olduqdan sonra Publish onları GitHub-a yerləşdirir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ яшчэ не рэпазіторыі Git. Стварыце ў кожнай па адным, каб адсочваць файлы; як толькі ў іх з'явіцца коміт, Publish змесціць іх на GitHub."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ все още не са Git хранилища. Създайте по едно във всяко, за да следите файловете им; след като имат къмит, Publish ги качва в GitHub."
          }
