          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alla på internet kan se det. Du väljer vem som kan committa."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mtu yeyote mtandaoni anaweza kuiona. Wewe unachagua nani anaweza ku-commit."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "இணையத்தில் உள்ள எவரும் அதைப் பார்க்கலாம். யார் commit செய்யலாம் என்பதை நீங்கள் தேர்வு செய்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ఇంటర్నెట్‌లో ఎవరైనా దాన్ని చూడవచ్చు. ఎవరు కమిట్ చేయవచ్చో మీరు ఎంచుకుంటారు."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ҳар кас дар интернет метавонад онро бубинад. Шумо интихоб мекунед, ки кӣ коммит карда метавонад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ทุกคนบนอินเทอร์เน็ตสามารถเห็นได้ คุณเลือกได้ว่าใครคอมมิตได้"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Internetdäki her kim ony görüp biler. Kim commit edip biljekdigini siz saýlaýarsyňyz."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "’E lava ’e ha taha pē ’i he ’initaneti ke sio ki ai. Ko koe ’oku fili ko hai ’e lava ke komiti."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İnternetteki herkes görebilir. Kimlerin commit yapabileceğini siz seçersiniz."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ئىنتېرنېتتىكى ھەممەيلەن ئۇنى كۆرەلەيدۇ. كىم commit قىلالايدىغانلىقىنى سىز تاللايسىز."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Будь-хто в інтернеті може його бачити. Ви обираєте, хто може робити коміти."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "انٹرنیٹ پر کوئی بھی اسے دیکھ سکتا ہے۔ آپ منتخب کرتے ہیں کہ کون کمیٹ کر سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
