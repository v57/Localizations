        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "শুধু Vault কী চালু আছে, এবং সেই ডিভাইসে git নিজস্ব কী দিয়ে সাইন ইন করে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "མཛོད་ལྡེ་མིག་ཁོ་ན་ཕྱེ་ཡོད། སྒྲོམ་དེའི་གིཊ་རང་གི་ལྡེ་མིག་གིས་ཐོ་འགོད།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vault साबिसो अन दं, आरो बे डिभाइसआव git आ बेनि गावनि साबिफोरजों साइन इन जागोन।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Només la clau del vault està activada, i git en aquell dispositiu inicia sessió amb les seves pròpies claus."
