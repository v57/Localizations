    "Drop a folder here. Every Git repository inside it is added, or a new one is started in it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أفلت مجلدًا هنا. يُضاف كل مستودع Git بداخله، أو يُبدأ واحد جديد فيه."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أسقط مجلد هنا. كل مستودع Git داخله ينضاف، أو يُبدأ واحد جديد فيه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ইয়াত এটা ফোল্ডাৰ পেলাওক। ইয়াৰ ভিতৰৰ প্ৰতিটো Git ৰিপ’জিটৰি যোগ হয়, বা তাত এটা নতুন আৰম্ভ হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bura qovluq buraxın. İçindəki hər Git repozitoriyası əlavə edilir və ya onda yeni biri başlanır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перацягніце сюды папку. Кожны рэпазіторый Git унутры яе будзе дададзены, або ў ёй будзе створаны новы."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пуснете папка тук. Всяко Git хранилище в нея се добавя или се създава ново в нея."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এখানে একটি ফোল্ডার ড্রপ করুন। এর ভিতরের প্রতিটি Git রিপোজিটরি যোগ করা হয়, অথবা এতে নতুন একটি শুরু করা হয়।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "འདིར་ཡིག་སྣོད་འཇོག ནང་གི་གིཊ་གསོག་མཛོད་ཚང་མ་ཁ་སྣོན། ཡང་ན་དེར་གསར་བ་འགོ་འཛུགས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बेयाव मोनसे फोल्डार ड्रप खालाम। बेनि गेजेराव थानाय मोनफ्रोम Git रिपजिटरी दाजाबजायो, एबा बेयाव गोदान मोनसेखौ जागायो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deixa anar una carpeta aquí. S'hi afegeix cada repositori Git que conté, o se n'inicia un de nou."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᎯᎠ ᎤᏪᏅᏒ ᏧᏓᎴᏅᏛ ᎢᏳᏓᎵ. ᎾᎿ ᎢᏳᎢ ᏂᎦᏛ Git ᏗᎦᎳᏫᎢᏍᏗ ᎠᏓᏅᏖᏟ, ᎠᎴ ᎢᏤ ᎢᏤ ᎤᎵᏍᏆᏛᏍᏗ ᎠᏓᏅᏖᏟ ᎤᎵᏍᏆᏛᏍᏗ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بوخچەیەک لێرە دابنێ. هەر ڕیپۆزیتەریێکی Git لەناویدا زیاد دەکرێت، یان دانەیەکی نوێ تیایدا دەستپێدەکرێت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přetáhněte sem složku. Každý repozitář Git uvnitř bude přidán, nebo v ní bude založen nový."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gollwng ffolder yma. Mae pob storfa Git ynddi yn cael ei hychwanegu, neu mae un newydd yn cael ei chychwyn ynddi."
          }
        },
        "da" : {
