        "doi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use git पर एह् git गी तुंदे अपने सेटअप नाल चलांदा ऐ, इसलेई इक key जिसगी पासफ्रेज जां Touch ID दी लोड़ ऐ पुच्छी सकदी ऐ।"
