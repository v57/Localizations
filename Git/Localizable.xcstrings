        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выдаляе %@ і вяртае %@ да стану апошняга коміта, уключна з незастэйджанымі зменамі. Спачатку пытаецца; гэта нельга адмяніць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Премахва %@ и връща %@ както беше в последния къмит, включително нестейджнатите промени. Пита първо; не можете да отмените това."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ মুছে দেয় এবং %@ কে শেষ কমিটের মতো ফিরিয়ে দেয়, unstaged পরিবর্তনসহ। আগে জিজ্ঞাসা করে; এটি পূর্বাবস্থায় ফেরাতে পারবেন না।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ བསུབ་ཅིང %@ འདི་མཐའ་མའི་ཀོ་མིཊ་བཞིན་སླར་འཇོག སྟེཇ་མ་བྱས་པའི་འགྱུར་བ་ཡང་། སྔོན་དུ་འདྲི། འདི་ཕྱིར་སློག་མི་ཐུབ།"
