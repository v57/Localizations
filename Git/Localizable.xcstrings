        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बे लिस्टनि क्रमखौल' सोलायो; अक्टोनि क्रमआ Group by Folder खौ अफ खालामो। नोङनि रिपजिटरीफोर थानाय बादिनो थागोन।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Només canvia l'ordre d'aquesta llista; un ordre per data desactiva Agrupa per carpeta. Els teus repositoris es mantenen com estan."
