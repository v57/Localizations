    "Links you click open in your browser, which talks to those sites itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الروابط التي تنقر عليها تُفتح في متصفحك، الذي يتواصل مع تلك المواقع بنفسه."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الروابط اللي تضغطها تنفتح في متصفحك، اللي يكلم تلك المواقع بنفسه."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপুনি ক্লিক কৰা লিংক আপোনাৰ ব্ৰাউজাৰত খোলে, যিয়ে সেই ছাইটবোৰৰ সৈতে নিজে কথা পাতে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kliklədiyiniz keçidlər brauzerinizdə açılır, o özü həmin saytlarla danışır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Спасылкі, якія вы націскаеце, адкрываюцца ў вашым браўзеры, які сам звязваецца з гэтымі сайтамі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Връзките, които щраквате, се отварят във вашия браузър, който сам говори с тези сайтове."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনি ক্লিক করা লিংক আপনার ব্রাউজারে খোলে, যা নিজেই সেই সাইটগুলোর সাথে কথা বলে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཁྱེད་ཀྱིས་མནན་པའི་འབྲེལ་ཐག་ཁྱེད་ཀྱི་ལྟ་ཆས་ནང་འབྱེད། དེ་རང་གིས་གནས་ཚུལ་དེ་དག་ལ་སྐད་ཆ།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नों क्लिक खालामनाय लिङ्कफोर नोङनि ब्राउजाराव खुलियो, जाय बे साइटफोरजों गावनो रायजलायो।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els enllaços en què cliques s'obren al teu navegador, que parla amb aquests llocs pel seu compte."
          }
        },
        "chr" : {
