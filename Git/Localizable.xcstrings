        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ खौ होखारगोन आरो %@ खौ जोबथा कमिटआव बादि थामोन बिदिनो फिन दोनफिनगोन, अनस्टेज्ड सोलायनायफोरजोंबो। सिगाङाव सोंगोन; नों बेखौ अनडु खालामनो हाया।"
