		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ चों %2$lld ब्लॉक गी इक चुनां दी लोड़ ऐ</string>
			<key>other</key>
			<string>%1$@ चों %2$lld ब्लॉकें गी इक चुनां दी लोड़ ऐ</string>
		</dict>
