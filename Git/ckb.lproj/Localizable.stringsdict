			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ لە %2$lld بلۆک پێویستی بە هەڵبژاردنێکە</string>
			<key>other</key>
			<string>%1$@ لە %2$lld بلۆکەکان پێویستیان بە هەڵبژاردنە</string>
		</dict>
