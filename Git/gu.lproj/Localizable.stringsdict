			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld બ્લોકમાંથી %@ ને પસંદગી જરૂરી છે</string>
			<key>other</key>
