			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@, %2$@ ಮತ್ತು %3$lld ಇನ್ನಷ್ಟು</string>
			<key>other</key>
			<string>%1$@, %2$@ ಮತ್ತು %3$lld ಇನ್ನಷ್ಟು</string>
		</dict>
