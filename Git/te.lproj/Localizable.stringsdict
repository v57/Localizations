			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ లో %2$lld బ్లాక్‌కు ఎంపిక అవసరం</string>
			<key>other</key>
			<string>%1$@ లో %2$lld బ్లాక్‌లకు ఎంపిక అవసరం</string>
		</dict>
	</dict>
