		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld தொகுதியில் %@-க்கு தேர்வு தேவை</string>
			<key>other</key>
			<string>%lld தொகுதிகளில் %@-க்கு தேர்வு தேவை</string>
		</dict>
	</dict>
