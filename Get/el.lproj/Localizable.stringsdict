		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ενεργή</string>
			<key>other</key>
			<string>%lld ενεργές</string>
		</dict>
	</dict>
