			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld σύνδεση</string>
			<key>other</key>
			<string>%lld συνδέσεις</string>
		</dict>
	</dict>
	<key>%lld downloading</key>
