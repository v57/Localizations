<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld active</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld aktywne</string>
			<key>many</key>
			<string>%lld aktywnych</string>
			<key>one</key>
			<string>%lld aktywny</string>
			<key>other</key>
			<string>%lld aktywnego</string>
		</dict>
	</dict>
	<key>%lld connections</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld połączenia</string>
			<key>many</key>
			<string>%lld połączeń</string>
			<key>one</key>
			<string>%lld połączenie</string>
			<key>other</key>
			<string>%lld połączenia</string>
		</dict>
	</dict>
	<key>%lld downloading</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld pobierane</string>
			<key>many</key>
			<string>%lld pobieranych</string>
			<key>one</key>
			<string>%lld pobierany</string>
			<key>other</key>
			<string>%lld pobieranego</string>
		</dict>
	</dict>
	<key>%lld downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld pobrania</string>
			<key>many</key>
			<string>%lld pobrań</string>
			<key>one</key>
			<string>%lld pobieranie</string>
			<key>other</key>
			<string>%lld pobrania</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld pliki</string>
			<key>many</key>
			<string>%lld plików</string>
			<key>one</key>
			<string>%lld plik</string>
			<key>other</key>
			<string>%lld pliku</string>
		</dict>
	</dict>
</dict>
</plist>
