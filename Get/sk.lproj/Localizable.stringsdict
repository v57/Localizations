<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld active</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld aktívne</string>
			<key>many</key>
			<string>%lld aktívnych</string>
			<key>one</key>
			<string>%lld aktívny</string>
			<key>other</key>
			<string>%lld aktívnych</string>
		</dict>
	</dict>
	<key>%lld connections</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld pripojenia</string>
			<key>many</key>
			<string>%lld pripojení</string>
			<key>one</key>
			<string>%lld pripojenie</string>
			<key>other</key>
			<string>%lld pripojení</string>
		</dict>
	</dict>
	<key>%lld downloading</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld sa sťahujú</string>
			<key>many</key>
			<string>%lld sa sťahuje</string>
			<key>one</key>
			<string>%lld sa sťahuje</string>
			<key>other</key>
			<string>%lld sa sťahuje</string>
		</dict>
	</dict>
	<key>%lld downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld sťahovania</string>
			<key>many</key>
			<string>%lld sťahovaní</string>
			<key>one</key>
			<string>%lld sťahovanie</string>
			<key>other</key>
			<string>%lld sťahovaní</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld súbory</string>
			<key>many</key>
			<string>%lld súborov</string>
			<key>one</key>
			<string>%lld súbor</string>
			<key>other</key>
			<string>%lld súborov</string>
		</dict>
	</dict>
</dict>
</plist>
