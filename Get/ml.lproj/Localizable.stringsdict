		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ഫയൽ</string>
			<key>other</key>
			<string>%lld ഫയലുകൾ</string>
		</dict>
	</dict>
</dict>
</plist>
