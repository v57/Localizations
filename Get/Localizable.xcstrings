    "Takes it off the list and moves its file to the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يزيله من القائمة وينقل ملفه إلى سلة المهملات."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يشيله من القائمة وينقل ملفه إلى سلة المهملات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ইয়াক তালিকাৰ পৰা আঁতৰাই ইয়াৰ ফাইলটো ট্ৰেছলৈ নিয়ে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Onu siyahıdan çıxarır və faylını Zibil qutusuna köçürür."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Прыбірае са спісу і перамяшчае яго файл у Сметніцу."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Премахва го от списъка и премества файла му в Кошчето."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এটি তালিকা থেকে সরিয়ে এর ফাইলটি ট্র্যাশে পাঠায়।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "རེའུ་མིག་ནས་བསལ་ནས་ཁོའི་ཡིག་ཆ་གད་སྙིགས་ཁང་དུ་སྤོས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बेखौ लिस्टनिफ्राय बोखारो आरो बेनि फाइलखौ ट्रेशआव लांगोन।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’elimina de la llista i mou el seu fitxer a la Paperera."
          }
        },
        "chr" : {
