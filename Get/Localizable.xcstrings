    "Click files to set priority 1–4; others download after." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "انقر الملفات لتعيين الأولوية 1–4؛ تُنزَّل الملفات الأخرى بعدها."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط على الملفات لتحديد الأولوية 1–4؛ الباقي ينزل بعدها."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অগ্ৰাধিকাৰ 1–4 দিবলৈ ফাইলত ক্লিক কৰক; বাকীবোৰ পাছত ডাউনলোড হ’ব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1–4 prioritet təyin etmək üçün fayllara klikləyin; digərləri sonra endirilir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Націсніце на файлы, каб задаць прыярытэт 1–4; астатнія спампуюцца пасля."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Щракни върху файловете, за да зададеш приоритет 1–4; останалите се изтеглят след това."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অগ্রাধিকার 1–4 সেট করতে ফাইলগুলোতে ক্লিক করুন; বাকিগুলো পরে ডাউনলোড হবে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཡིག་ཆ་ལ་མནན་ནས་གལ་གནད་རིམ་པ་ 1–4 གཏན་འཁེལ། གཞན་དག་རྗེས་སུ་ཕབ་ལེན་བྱེད།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "प्रायोरिटि 1–4 साननो थाखाय फाइलफोरखौ क्लिक खालाम; गुबुनफोरा उनाव डाउनलोड जागोन।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fes clic als fitxers per definir la prioritat d’1 a 4; els altres es baixen després."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᏗᎪᏪᎸ ᏗᏥᏔᏲᎦ ᎢᎬᏱ ᎤᏟ 1–4 ᏥᏔᏲᎦ; ᏅᏓᎥ ᎣᏂ ᏖᏣᏔᏲᏍᏗ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کرتە لە فایلەکان بکە بۆ دانانی پێشینە 1–4؛ ئەوانی تر دواتر دادەبەزن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kliknutím na soubory nastavíte prioritu 1–4; ostatní se stáhnou poté."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cliciwch ffeiliau i osod blaenoriaeth 1–4; mae'r lleill yn lawrlwytho wedyn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klik på filer for at indstille prioritet 1–4; andre overføres bagefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dateien anklicken, um Priorität 1–4 festzulegen; andere werden danach geladen."
          }
        },
        "doi" : {
