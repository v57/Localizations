<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld active</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld активны</string>
			<key>many</key>
			<string>%lld активны</string>
			<key>one</key>
			<string>%lld активен</string>
			<key>other</key>
			<string>%lld активны</string>
		</dict>
	</dict>
	<key>%lld connections</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld соединения</string>
			<key>many</key>
			<string>%lld соединений</string>
			<key>one</key>
			<string>%lld соединение</string>
			<key>other</key>
			<string>%lld соединений</string>
		</dict>
	</dict>
	<key>%lld downloading</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld загружаются</string>
			<key>many</key>
			<string>%lld загружаются</string>
			<key>one</key>
			<string>%lld загружается</string>
			<key>other</key>
			<string>%lld загружаются</string>
		</dict>
	</dict>
	<key>%lld downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld загрузки</string>
			<key>many</key>
			<string>%lld загрузок</string>
			<key>one</key>
			<string>%lld загрузка</string>
			<key>other</key>
			<string>%lld загрузок</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld файла</string>
			<key>many</key>
			<string>%lld файлов</string>
			<key>one</key>
			<string>%lld файл</string>
			<key>other</key>
			<string>%lld файлов</string>
		</dict>
	</dict>
</dict>
</plist>
