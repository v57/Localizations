<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld active</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld aktyvūs</string>
			<key>many</key>
			<string>%lld aktyvaus</string>
			<key>one</key>
			<string>%lld aktyvus</string>
			<key>other</key>
			<string>%lld aktyvių</string>
		</dict>
	</dict>
	<key>%lld connections</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld ryšiai</string>
			<key>many</key>
			<string>%lld ryšio</string>
			<key>one</key>
			<string>%lld ryšys</string>
			<key>other</key>
			<string>%lld ryšių</string>
		</dict>
	</dict>
	<key>%lld downloading</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld atsisiunčiama</string>
			<key>many</key>
			<string>%lld atsisiunčiama</string>
			<key>one</key>
			<string>%lld atsisiunčiama</string>
			<key>other</key>
			<string>%lld atsisiunčiama</string>
		</dict>
	</dict>
	<key>%lld downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld atsisiuntimai</string>
			<key>many</key>
			<string>%lld atsisiuntimo</string>
			<key>one</key>
			<string>%lld atsisiuntimas</string>
			<key>other</key>
			<string>%lld atsisiuntimų</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld failai</string>
			<key>many</key>
			<string>%lld failo</string>
			<key>one</key>
			<string>%lld failas</string>
			<key>other</key>
			<string>%lld failų</string>
		</dict>
	</dict>
</dict>
</plist>
