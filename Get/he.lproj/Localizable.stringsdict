			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>מוריד אחד</string>
			<key>other</key>
			<string>%lld מורידים</string>
			<key>two</key>
			<string>שני מורידים</string>
		</dict>
	</dict>
	<key>%lld downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>הורדה אחת</string>
			<key>other</key>
			<string>%lld הורדות</string>
			<key>two</key>
			<string>שתי הורדות</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>קובץ אחד</string>
			<key>other</key>
			<string>%lld קבצים</string>
			<key>two</key>
			<string>שני קבצים</string>
		</dict>
