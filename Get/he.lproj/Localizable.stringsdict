			<string>%lld חיבורים</string>
			<key>two</key>
			<string>שני חיבורים</string>
		</dict>
	</dict>
	<key>%lld downloading</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
