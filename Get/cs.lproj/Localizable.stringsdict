<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld active</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld aktivní</string>
			<key>many</key>
			<string>%lld aktivního</string>
			<key>one</key>
			<string>%lld aktivní</string>
			<key>other</key>
			<string>%lld aktivních</string>
		</dict>
	</dict>
	<key>%lld connections</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld připojení</string>
			<key>many</key>
			<string>%lld připojení</string>
			<key>one</key>
			<string>%lld připojení</string>
			<key>other</key>
			<string>%lld připojení</string>
		</dict>
	</dict>
	<key>%lld downloading</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld stahované</string>
			<key>many</key>
			<string>%lld stahovaného</string>
			<key>one</key>
			<string>%lld stahovaný</string>
			<key>other</key>
			<string>%lld stahovaných</string>
		</dict>
	</dict>
	<key>%lld downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld stahování</string>
			<key>many</key>
			<string>%lld stahování</string>
			<key>one</key>
			<string>%lld stahování</string>
			<key>other</key>
			<string>%lld stahování</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld soubory</string>
			<key>many</key>
			<string>%lld souboru</string>
			<key>one</key>
			<string>%lld soubor</string>
			<key>other</key>
			<string>%lld souborů</string>
		</dict>
	</dict>
</dict>
</plist>
