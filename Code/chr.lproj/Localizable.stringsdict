<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ / %lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ / %2$lld ᏖᏍᏘ</string>
			<key>other</key>
			<string>%1$@ / %2$lld ᏗᏖᏍᏘ</string>
		</dict>
	</dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎦᏬᏂᏏᏅ</string>
			<key>other</key>
			<string>%lld ᏗᎦᏬᏂᏏᏅ</string>
		</dict>
	</dict>
	<key>%lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎠᏓᏅᏖᏗ</string>
			<key>other</key>
			<string>%lld ᏗᎠᏓᏅᏖᏗ</string>
		</dict>
	</dict>
	<key>%lld errors</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎠᏍᎦᏅᏙᎯ</string>
			<key>other</key>
			<string>%lld ᏗᎠᏍᎦᏅᏙᎯ</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎪᏪᎶᏗ</string>
			<key>other</key>
			<string>%lld ᏗᎪᏪᎶᏗ</string>
		</dict>
	</dict>
	<key>%lld hidden files also match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎤᏍᏕᎸ ᎪᏪᎶᏗ ᎠᎴ ᎤᏬᏪᎳᏅ</string>
			<key>other</key>
			<string>%lld ᎤᏍᏕᎸ ᏗᎪᏪᎶᏗ ᎠᎴ ᎤᏂᏬᏪᎳᏅ</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎠᎢᏘᎻ</string>
			<key>other</key>
			<string>%lld ᏗᎠᎢᏘᎻ</string>
		</dict>
	</dict>
	<key>%lld lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᏗᎦᏃᏣᎸ</string>
			<key>other</key>
			<string>%lld ᏗᎦᏃᏣᎸ</string>
		</dict>
	</dict>
	<key>%lld matches</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎠᏛᏁᎸ</string>
			<key>other</key>
			<string>%lld ᏗᏛᏁᎸ</string>
		</dict>
	</dict>
	<key>%lld more places: ⌘-click to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎢᏳᎢ ᎤᏟ ᎦᏔᏅ: ⌘-click ᎠᎪᏩᏛᏗ ᎾᎿᎭ.</string>
			<key>other</key>
			<string>%lld ᎢᏳᎢ ᎤᏟ ᏗᎦᏔᏅ: ⌘-click ᎠᎪᏩᏛᏗ ᏂᎦᏛ.</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᏇᎧᏨ</string>
			<key>other</key>
			<string>%lld ᏗᏇᎧᏨ</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎦᏔᏅ `%@` ᎠᏛᏁᎵ: ⌘-click ᎯᎠ ᎠᎵᏍᏓᏴᏗ ᎤᎪᏩᎸ ᎢᏳᏍᏗ ᏧᎸᏫᏍᏓᏁᏗ ᎢᏳᎢ.</string>
			<key>other</key>
			<string>%lld ᏗᎦᏔᏅ `%@` ᎠᏂᏛᏁᎵ: ⌘-click ᎯᎠ ᎠᎵᏍᏓᏴᏗ ᎤᎪᏩᎸ ᎢᏳᏍᏗ ᏧᎸᏫᏍᏓᏁᏗ ᎢᏳᎢ.</string>
		</dict>
	</dict>
	<key>%lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᏧᏓᎴᏅᏛ</string>
			<key>other</key>
			<string>%lld ᏧᏓᎴᏅᏛ</string>
		</dict>
	</dict>
	<key>%lld spaces</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᏍᏇᏏ</string>
			<key>other</key>
			<string>%lld ᏗᏍᏇᏏ</string>
		</dict>
	</dict>
	<key>%lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᏖᏍᏘ</string>
			<key>other</key>
			<string>%lld ᏗᏖᏍᏘ</string>
		</dict>
	</dict>
	<key>%lld warnings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎠᏓᏅᏙ ᎢᏳᎢ</string>
			<key>other</key>
			<string>%lld ᏗᎠᏓᏅᏙ ᎢᏳᎢ</string>
		</dict>
	</dict>
	<key>Closes all %lld tabs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᏗᏟᎶᏗ ᏧᏍᏚᎢ.</string>
			<key>other</key>
			<string>ᏂᎦᏛ %lld ᏗᏟᎶᏗ ᏧᏍᏚᎢ.</string>
		</dict>
	</dict>
	<key>Filter %lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ᏓᎦᏛᏂᏙᎯ %lld ᎠᏓᏅᏖᏗ</string>
			<key>other</key>
			<string>ᏓᎦᏛᏂᏙᎯ %lld ᏗᎠᏓᏅᏖᏗ</string>
		</dict>
	</dict>
	<key>Filter %lld schemes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ᏓᎦᏛᏂᏙᎯ %lld ᏍᎩᎻ</string>
			<key>other</key>
			<string>ᏓᎦᏛᏂᏙᎯ %lld ᏗᏍᎩᎻ</string>
		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᎦᏔᏅ %@ ᎠᏴᏍᎩ ᎠᏲᎵ ᏧᏓᎴᏅᏛ ᎦᏙᎬ ᏚᏙᎢᏛ.</string>
			<key>other</key>
			<string>%lld ᏗᎦᏔᏅ %@ ᎠᏂᏴᏍᎩ ᎠᏲᎵ ᏧᏓᎴᏅᏛ ᎦᏙᎬ ᏚᏙᎢᏛ.</string>
		</dict>
	</dict>
</dict>
</plist>
