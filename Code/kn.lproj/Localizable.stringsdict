<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ / %lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ / %2$lld ಪರೀಕ್ಷೆ</string>
			<key>other</key>
			<string>%1$@ / %2$lld ಪರೀಕ್ಷೆಗಳು</string>
		</dict>
	</dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಅಕ್ಷರ</string>
			<key>other</key>
			<string>%lld ಅಕ್ಷರಗಳು</string>
		</dict>
	</dict>
	<key>%lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಸಾಧನ</string>
			<key>other</key>
			<string>%lld ಸಾಧನಗಳು</string>
		</dict>
	</dict>
	<key>%lld errors</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ದೋಷ</string>
			<key>other</key>
			<string>%lld ದೋಷಗಳು</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಫೈಲ್</string>
			<key>other</key>
			<string>%lld ಫೈಲ್‌ಗಳು</string>
		</dict>
	</dict>
	<key>%lld hidden files also match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಗುಪ್ತ ಫೈಲ್ ಕೂಡ ಹೊಂದಿಕೆಯಾಗುತ್ತದೆ</string>
			<key>other</key>
			<string>%lld ಗುಪ್ತ ಫೈಲ್‌ಗಳು ಕೂಡ ಹೊಂದಿಕೆಯಾಗುತ್ತವೆ</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಐಟಂ</string>
			<key>other</key>
			<string>%lld ಐಟಂಗಳು</string>
		</dict>
	</dict>
	<key>%lld lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಸಾಲು</string>
			<key>other</key>
			<string>%lld ಸಾಲುಗಳು</string>
		</dict>
	</dict>
	<key>%lld matches</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಹೊಂದಾಣಿಕೆ</string>
			<key>other</key>
			<string>%lld ಹೊಂದಾಣಿಕೆಗಳು</string>
		</dict>
	</dict>
	<key>%lld more places: ⌘-click to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಹೆಚ್ಚುವರಿ ಸ್ಥಳ: ಅದನ್ನು ನೋಡಲು ⌘-click ಮಾಡಿ.</string>
			<key>other</key>
			<string>%lld ಹೆಚ್ಚುವರಿ ಸ್ಥಳಗಳು: ಎಲ್ಲವನ್ನೂ ನೋಡಲು ⌘-click ಮಾಡಿ.</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಪ್ಯಾಕೇಜ್</string>
			<key>other</key>
			<string>%lld ಪ್ಯಾಕೇಜ್‌ಗಳು</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಸ್ಥಳವು `%@` ಅನ್ನು ಘೋಷಿಸುತ್ತದೆ: ಜಂಪ್ ಮಾಡುವ ಬದಲು ಈ ಮೆನುವನ್ನು ತೋರಿಸಲು ⌘-click ಮಾಡಿ.</string>
			<key>other</key>
			<string>%lld ಸ್ಥಳಗಳು `%@` ಅನ್ನು ಘೋಷಿಸುತ್ತವೆ: ಜಂಪ್ ಮಾಡುವ ಬದಲು ಈ ಮೆನುವನ್ನು ತೋರಿಸಲು ⌘-click ಮಾಡಿ.</string>
		</dict>
	</dict>
	<key>%lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಯೋಜನೆ</string>
			<key>other</key>
			<string>%lld ಯೋಜನೆಗಳು</string>
		</dict>
	</dict>
	<key>%lld spaces</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಸ್ಪೇಸ್</string>
			<key>other</key>
			<string>%lld ಸ್ಪೇಸ್‌ಗಳು</string>
		</dict>
	</dict>
	<key>%lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಪರೀಕ್ಷೆ</string>
			<key>other</key>
			<string>%lld ಪರೀಕ್ಷೆಗಳು</string>
		</dict>
	</dict>
	<key>%lld warnings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಎಚ್ಚರಿಕೆ</string>
			<key>other</key>
			<string>%lld ಎಚ್ಚರಿಕೆಗಳು</string>
		</dict>
	</dict>
	<key>Closes all %lld tabs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ಟ್ಯಾಬ್ ಅನ್ನು ಮುಚ್ಚುತ್ತದೆ.</string>
			<key>other</key>
			<string>ಎಲ್ಲಾ %lld ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮುಚ್ಚುತ್ತದೆ.</string>
		</dict>
	</dict>
	<key>Filter %lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ಫಿಲ್ಟರ್ %lld ಸಾಧನ</string>
			<key>other</key>
			<string>ಫಿಲ್ಟರ್ %lld ಸಾಧನಗಳು</string>
		</dict>
	</dict>
	<key>Filter %lld schemes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ಫಿಲ್ಟರ್ %lld ಸ್ಕೀಮ್</string>
			<key>other</key>
			<string>ಫಿಲ್ಟರ್ %lld ಸ್ಕೀಮ್‌ಗಳು</string>
		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ಯೋಜನೆಯಲ್ಲಿ ಹುಡುಕಿ ನಲ್ಲಿ %1$@ ಅನ್ನು ಬಳಸುವ %2$lld ಸ್ಥಳವನ್ನು ಪಟ್ಟಿ ಮಾಡುತ್ತದೆ.</string>
			<key>other</key>
			<string>ಯೋಜನೆಯಲ್ಲಿ ಹುಡುಕಿ ನಲ್ಲಿ %1$@ ಅನ್ನು ಬಳಸುವ %2$lld ಸ್ಥಳಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡುತ್ತದೆ.</string>
		</dict>
	</dict>
</dict>
</plist>
