	<key>Closes all %lld tabs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Uždaro visus %lld skirtukus.</string>
			<key>many</key>
			<string>Uždaro visus %lld skirtukų.</string>
			<key>one</key>
			<string>Uždaro %lld skirtuką.</string>
			<key>other</key>
			<string>Uždaro visus %lld skirtukų.</string>
