	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld vietos deklaruoja `%@`: ⌘-click rodo šį meniu, o ne peršoka.</string>
			<key>many</key>
			<string>%lld vietų deklaruoja `%@`: ⌘-click rodo šį meniu, o ne peršoka.</string>
			<key>one</key>
			<string>%lld vieta deklaruoja `%@`: ⌘-click rodo šį meniu, o ne peršoka.</string>
			<key>other</key>
			<string>%lld vietų deklaruoja `%@`: ⌘-click rodo šį meniu, o ne peršoka.</string>
		</dict>
