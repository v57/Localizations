	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld įrenginiai</string>
			<key>many</key>
			<string>%lld įrenginių</string>
			<key>one</key>
			<string>%lld įrenginys</string>
			<key>other</key>
			<string>%lld įrenginių</string>
