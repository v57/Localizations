			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Išvardija %lld vietas, kuriose Rasti projekte naudojamas %@.</string>
			<key>many</key>
			<string>Išvardija %lld vietų, kuriose Rasti projekte naudojamas %@.</string>
			<key>one</key>
			<string>Išvardija %lld vietą, kurioje Rasti projekte naudojamas %@.</string>
			<key>other</key>
