	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ᱴᱷᱟᱶ `%@` ᱮ ᱩᱫᱩᱜᱼᱟ: ᱥᱮᱱᱚᱜ ᱵᱚᱫᱚᱞ ᱛᱮ ⌘-click ᱱᱚᱣᱟ ᱢᱮᱱᱩ ᱮ ᱥᱩᱫᱩᱜᱼᱟ᱾</string>
			<key>other</key>
			<string>%lld ᱴᱷᱟᱶ ᱠᱚ `%@` ᱠᱚ ᱩᱫᱩᱜᱼᱟ: ᱥᱮᱱᱚᱜ ᱵᱚᱫᱚᱞ ᱛᱮ ⌘-click ᱱᱚᱣᱟ ᱢᱮᱱᱩ ᱮ ᱥᱩᱫᱩᱜᱼᱟ᱾</string>
			<key>two</key>
			<string>%lld ᱴᱷᱟᱶ ᱠᱤᱱ `%@` ᱠᱚ ᱩᱫᱩᱜᱼᱟ: ᱥᱮᱱᱚᱜ ᱵᱚᱫᱚᱞ ᱛᱮ ⌘-click ᱱᱚᱣᱟ ᱢᱮᱱᱩ ᱮ ᱥᱩᱫᱩᱜᱼᱟ᱾</string>
		</dict>
