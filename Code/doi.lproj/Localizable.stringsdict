			<string>%lld पैकेज</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld जगह `%@` दी घोषणा करदी ऐ: ⌘-click करने पर जंप करने दी बजाय एह् मेनू दिखदा ऐ।</string>
			<key>other</key>
			<string>%lld जगहां `%@` दी घोषणा करदियां न: ⌘-click करने पर जंप करने दी बजाय एह् मेनू दिखदा ऐ।</string>
		</dict>
	</dict>
