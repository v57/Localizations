		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>प्रोजेक्ट च लब्भो च %1$@ दी वर्तों करने आली %2$lld जगह सूचीबद्ध करदा ऐ।</string>
			<key>other</key>
			<string>प्रोजेक्ट च लब्भो च %1$@ दी वर्तों करने आलियां %2$lld जगहां सूचीबद्ध करदा ऐ।</string>
