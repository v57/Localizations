			<key>other</key>
			<string>سڀ %lld ٽيب بند ڪري ٿو.</string>
		</dict>
	</dict>
	<key>Filter %lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>فلٽر %lld ڊوائيس</string>
			<key>other</key>
			<string>فلٽر %lld ڊوائيسون</string>
		</dict>
	</dict>
	<key>Filter %lld schemes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>فلٽر %lld اسڪيم</string>
			<key>other</key>
			<string>فلٽر %lld اسڪيمون</string>
		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>پروجيڪٽ ۾ ڳولو ۾ %1$@ استعمال ڪندڙ %2$lld جڳهه ڏيکاري ٿو.</string>
			<key>other</key>
			<string>پروجيڪٽ ۾ ڳولو ۾ %1$@ استعمال ڪندڙ %2$lld جڳهون ڏيکاري ٿو.</string>
		</dict>
	</dict>
