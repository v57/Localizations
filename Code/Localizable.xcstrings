        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ཁྱེད་ཀྱིས་གཞན་ཞིག་མ་བདམས་བར་དུ་འདེམས་འཇོག་བྱས་ཡོད།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ बियो सायखʼजानायै थायो जेसिम नों गुबुन सासेखौ सायखʼआ।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Es manté seleccionat fins que en seleccioneu un altre."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ᎢᏳᎾᏛᏁᏗ ᎠᏎᏉ ᎢᏤ ᎢᏣᏁᎸ ᏂᎦᎵᏍᏗᏍᎬ."
