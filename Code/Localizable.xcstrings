            "value" : "मार्गे फलकानि स्रष्टुं “/” उपयुङ्क्ताम्।"
          }
        },
        "sat" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ᱦᱚᱨ ᱨᱮ ᱯᱷᱚᱞᱰᱟᱨ ᱵᱮᱱᱟᱣ ᱞᱟᱹᱜᱤᱫ “/” ᱵᱮᱵᱷᱟᱨ ᱢᱮ᱾"
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وچ ۾ فولڊر ٺاهڻ لاءِ “/” استعمال ڪريو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "අතරමග ෆෝල්ඩර සෑදීමට “/” භාවිතා කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pomocou „/“ môžete cestou vytvárať priečinky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uporabite »/« za sprotno ustvarjanje map."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Përdor “/” për të krijuar dosje gjatë rrugës."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koristite „/“ da usput napravite fascikle."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Använd ”/” för att skapa mappar längs vägen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tumia “/” kuunda folda njiani."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "வழியில் கோப்புறைகளை உருவாக்க “/” ஐப் பயன்படுத்தவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "మార్గంలో ఫోల్డర్‌లను సృష్టించడానికి “/” ఉపయోగించండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Барои сохтани ҷузвдонҳо дар роҳ “/”-ро истифода баред."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ใช้ “/” เพื่อสร้างโฟลเดอร์ระหว่างทาง"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ýolda bukjalar döretmek üçin “/” ulanyň."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ngāue'aki 'a e “/” ke fai 'a e ngaahi fōlatā 'i he hala."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ara klasörler oluşturmak için “/” kullanın."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يول بويى قىسقۇچ قۇرۇش ئۈچۈن «/» نى ئىشلىتىڭ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Використовуйте «/», щоб створювати папки дорогою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "راستے میں فولڈرز بنانے کے لیے “/” استعمال کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dùng “/” để tạo thư mục trên đường đi."
