    "%@ It stays picked until you pick another." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ يبقى محددًا حتى تختار غيره."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ يبقى مختار لين تختار غيره."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ আন এটা নবছালৈকে ই বাছনি হৈ থাকে।"
          }
        },
        "az" : {
          "stringUnit" : {
