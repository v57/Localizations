    "Deletes %@ build products. The next build starts over." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحذف منتجات بناء %@. سيبدأ البناء التالي من جديد."
          }
        },
        "ars" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحذف منتجات بناء %@. البناء الجاي يبدأ من جديد."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ বিল্ড সামগ্ৰীসমূহ মচে। পৰৱৰ্তী বিল্ড নতুনকৈ আৰম্ভ হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ yığım məhsullarını silir. Növbəti yığım sıfırdan başlayır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выдаляе прадукты зборкі %@. Наступная зборка пачнецца нанова."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изтрива продуктите от изграждането на %@. Следващото изграждане започва отначало."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ বিল্ড প্রোডাক্ট মুছে দেয়। পরের বিল্ড নতুন করে শুরু হয়।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ གི་བསྐྲུན་ཐོན་རྫས་བསུབ། བསྐྲུན་རྗེས་མ་གསར་དུ་འགོ་བཙུགས།"
          }
        },
        "brx" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ नि बिल्ड प्रडाक्टफोरखौ डिलिटो। उननि बिल्डआ गोदानै जागायगोन।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suprimeix els productes de compilació de %@. La pròxima compilació començarà de zero."
          }
        },
        "chr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ᎠᏁᎵ ᏧᎦᏔᏅ ᏕᎦᎢᎢ. ᎢᎦᎢ ᎠᏁᎵ ᎢᏤ ᎠᎵᏍᏓᏴᏗ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بەرهەمەکانی بنیادی %@ دەسڕێتەوە. بنیادی داهاتوو لە سەرەتاوە دەستپێدەکات."
          }
        },
        "cs" : {
