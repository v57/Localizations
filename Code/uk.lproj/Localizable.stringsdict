			<string>lld</string>
			<key>few</key>
			<string>%lld об’єкти</string>
			<key>many</key>
			<string>%lld об’єктів</string>
			<key>one</key>
			<string>%lld об’єкт</string>
			<key>other</key>
			<string>%lld об’єктів</string>
		</dict>
	</dict>
	<key>%lld lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld рядки</string>
