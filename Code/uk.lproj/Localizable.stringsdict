	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld файли</string>
			<key>many</key>
			<string>%lld файлів</string>
			<key>one</key>
			<string>%lld файл</string>
			<key>other</key>
			<string>%lld файлів</string>
		</dict>
