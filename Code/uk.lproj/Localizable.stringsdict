			<string>%lld пакетів</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld місця оголошують `%@`: ⌘-клац показує це меню замість переходу.</string>
			<key>many</key>
			<string>%lld місць оголошують `%@`: ⌘-клац показує це меню замість переходу.</string>
			<key>one</key>
			<string>%lld місце оголошує `%@`: ⌘-клац показує це меню замість переходу.</string>
			<key>other</key>
			<string>%lld місць оголошують `%@`: ⌘-клац показує це меню замість переходу.</string>
		</dict>
