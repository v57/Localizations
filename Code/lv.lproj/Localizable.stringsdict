	<key>%lld more places: ⌘-click to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Vēl %lld vieta: ⌘-klikšķiniet, lai to skatītu.</string>
			<key>other</key>
			<string>Vēl %lld vietas: ⌘-klikšķiniet, lai skatītu tās visas.</string>
