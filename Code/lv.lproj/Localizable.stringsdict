			<key>zero</key>
			<string>%lld pakotņu</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld vieta deklarē `%@`: ⌘-klikšķis parāda šo izvēlni, nevis pāriet.</string>
			<key>other</key>
			<string>%lld vietas deklarē `%@`: ⌘-klikšķis parāda šo izvēlni, nevis pāriet.</string>
			<key>zero</key>
			<string>%lld vietu deklarē `%@`: ⌘-klikšķis parāda šo izvēlni, nevis pāriet.</string>
