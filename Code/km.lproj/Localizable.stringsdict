			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld កន្លែងទៀត៖ ⌘-ចុចដើម្បីមើលទាំងអស់។</string>
		</dict>
	</dict>
