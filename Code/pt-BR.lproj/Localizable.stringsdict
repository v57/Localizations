		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>%1$@ / %2$lld testes</string>
			<key>one</key>
			<string>%1$@ / %2$lld teste</string>
			<key>other</key>
			<string>%1$@ / %2$lld testes</string>
		</dict>
	</dict>
