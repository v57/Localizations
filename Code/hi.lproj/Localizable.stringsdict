		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld स्थान `%@` घोषित करता है: जंप करने के बजाय ⌘-click यह मेनू दिखाता है।</string>
			<key>other</key>
			<string>%lld स्थान `%@` घोषित करते हैं: जंप करने के बजाय ⌘-click यह मेनू दिखाता है।</string>
		</dict>
