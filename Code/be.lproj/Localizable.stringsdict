	<key>%lld hidden files also match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld схаваныя файлы таксама супадаюць</string>
			<key>many</key>
			<string>%lld схаваных файлаў таксама супадаюць</string>
			<key>one</key>
			<string>%lld схаваны файл таксама супадае</string>
