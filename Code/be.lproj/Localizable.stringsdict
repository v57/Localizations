			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld памылкі</string>
			<key>many</key>
			<string>%lld памылак</string>
			<key>one</key>
			<string>%lld памылка</string>
			<key>other</key>
			<string>%lld памылак</string>
