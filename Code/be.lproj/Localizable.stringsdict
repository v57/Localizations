<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ / %lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%1$@ / %2$lld тэсты</string>
			<key>many</key>
			<string>%1$@ / %2$lld тэстаў</string>
			<key>one</key>
			<string>%1$@ / %2$lld тэст</string>
			<key>other</key>
			<string>%1$@ / %2$lld тэстаў</string>
		</dict>
	</dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld сімвалы</string>
			<key>many</key>
			<string>%lld сімвалаў</string>
			<key>one</key>
			<string>%lld сімвал</string>
			<key>other</key>
			<string>%lld сімвалаў</string>
		</dict>
	</dict>
	<key>%lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld прылады</string>
			<key>many</key>
			<string>%lld прылад</string>
			<key>one</key>
			<string>%lld прылада</string>
			<key>other</key>
			<string>%lld прылад</string>
