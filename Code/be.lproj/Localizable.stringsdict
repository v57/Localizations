		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld папярэджанні</string>
			<key>many</key>
			<string>%lld папярэджанняў</string>
			<key>one</key>
			<string>%lld папярэджанне</string>
			<key>other</key>
			<string>%lld папярэджанняў</string>
		</dict>
	</dict>
	<key>Closes all %lld tabs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
