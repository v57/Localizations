			<key>other</key>
			<string>هەموو %lld بازدەکان دادەخات.</string>
		</dict>
	</dict>
	<key>Filter %lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>پاڵاوتن %lld ئامێر</string>
			<key>other</key>
			<string>پاڵاوتن %lld ئامێرەکان</string>
		</dict>
	</dict>
	<key>Filter %lld schemes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>پاڵاوتن %lld سکیم</string>
			<key>other</key>
			<string>پاڵاوتن %lld سکیمەکان</string>
		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ئەو %lld شوێنە لیست دەکات کە %@ لە بدۆزە لە پڕۆژەدا بەکاردەهێنێت.</string>
			<key>other</key>
			<string>ئەو %lld شوێنانە لیست دەکات کە %@ لە بدۆزە لە پڕۆژەدا بەکاردەهێنن.</string>
		</dict>
	</dict>
</dict>
</plist>
