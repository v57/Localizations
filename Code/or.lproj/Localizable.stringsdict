<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ / %lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ / %2$lld ଟେଷ୍ଟ</string>
			<key>other</key>
			<string>%1$@ / %2$lld ଟେଷ୍ଟଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଅକ୍ଷର</string>
			<key>other</key>
			<string>%lld ଅକ୍ଷରଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଡିଭାଇସ୍</string>
			<key>other</key>
			<string>%lld ଡିଭାଇସ୍‌ଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld errors</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ତ୍ରୁଟି</string>
			<key>other</key>
			<string>%lld ତ୍ରୁଟିଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଫାଇଲ୍</string>
			<key>other</key>
			<string>%lld ଫାଇଲ୍‌ଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld hidden files also match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଲୁଚିଥିବା ଫାଇଲ୍ ମଧ୍ୟ ମେଳ ଖାଉଛି</string>
			<key>other</key>
			<string>%lld ଲୁଚିଥିବା ଫାଇଲ୍‌ଗୁଡ଼ିକ ମଧ୍ୟ ମେଳ ଖାଉଛନ୍ତି</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଆଇଟମ୍</string>
			<key>other</key>
			<string>%lld ଆଇଟମ୍‌ଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଲାଇନ୍</string>
			<key>other</key>
			<string>%lld ଲାଇନ୍‌ଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld matches</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ମ୍ୟାଚ୍</string>
			<key>other</key>
			<string>%lld ମ୍ୟାଚ୍‌ଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld more places: ⌘-click to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଅଧିକ ସ୍ଥାନ: ଏହାକୁ ଦେଖିବା ପାଇଁ ⌘-କ୍ଲିକ୍ କରନ୍ତୁ।</string>
			<key>other</key>
			<string>%lld ଅଧିକ ସ୍ଥାନଗୁଡ଼ିକ: ସମସ୍ତଙ୍କୁ ଦେଖିବା ପାଇଁ ⌘-କ୍ଲିକ୍ କରନ୍ତୁ।</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ପ୍ୟାକେଜ୍</string>
			<key>other</key>
			<string>%lld ପ୍ୟାକେଜ୍‌ଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>`%1$@` ଘୋଷଣା କରୁଥିବା %2$lld ସ୍ଥାନ: ଯିବା ବଦଳରେ ⌘-କ୍ଲିକ୍ ଏହି ମେନୁ ଦେଖାଏ।</string>
			<key>other</key>
			<string>`%1$@` ଘୋଷଣା କରୁଥିବା %2$lld ସ୍ଥାନଗୁଡ଼ିକ: ଯିବା ବଦଳରେ ⌘-କ୍ଲିକ୍ ଏହି ମେନୁ ଦେଖାଏ।</string>
		</dict>
	</dict>
	<key>%lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ପ୍ରୋଜେକ୍ଟ</string>
			<key>other</key>
			<string>%lld ପ୍ରୋଜେକ୍ଟଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld spaces</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ସ୍ପେସ୍</string>
			<key>other</key>
			<string>%lld ସ୍ପେସ୍‌ଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଟେଷ୍ଟ</string>
			<key>other</key>
			<string>%lld ଟେଷ୍ଟଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>%lld warnings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଚେତାବନୀ</string>
			<key>other</key>
			<string>%lld ଚେତାବନୀଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>Closes all %lld tabs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ଟ୍ୟାବ୍ ବନ୍ଦ କରେ।</string>
			<key>other</key>
			<string>ସମସ୍ତ %lld ଟ୍ୟାବ୍ ବନ୍ଦ କରେ।</string>
		</dict>
	</dict>
	<key>Filter %lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ଫିଲ୍ଟର୍ %lld ଡିଭାଇସ୍</string>
			<key>other</key>
			<string>ଫିଲ୍ଟର୍ %lld ଡିଭାଇସ୍‌ଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>Filter %lld schemes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ଫିଲ୍ଟର୍ %lld ସ୍କିମ୍</string>
			<key>other</key>
			<string>ଫିଲ୍ଟର୍ %lld ସ୍କିମ୍‌ଗୁଡ଼ିକ</string>
		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ପ୍ରୋଜେକ୍ଟରେ ଖୋଜନ୍ତୁ ରେ %1$@ ବ୍ୟବହାର କରୁଥିବା %2$lld ସ୍ଥାନ ତାଲିକା କରେ।</string>
			<key>other</key>
			<string>ପ୍ରୋଜେକ୍ଟରେ ଖୋଜନ୍ତୁ ରେ %1$@ ବ୍ୟବହାର କରୁଥିବା %2$lld ସ୍ଥାନଗୁଡ଼ିକ ତାଲିକା କରେ।</string>
		</dict>
	</dict>
</dict>
</plist>
