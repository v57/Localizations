		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld áit a dhearbhaíonn `%@`: ⌘-cliceáil chun an roghchlár seo a thaispeáint in ionad léime.</string>
			<key>many</key>
			<string>%lld áiteanna a dhearbhaíonn `%@`: ⌘-cliceáil chun an roghchlár seo a thaispeáint in ionad léime.</string>
