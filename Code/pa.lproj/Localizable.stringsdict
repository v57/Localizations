<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ / %lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ / %2$lld ਟੈਸਟ</string>
			<key>other</key>
			<string>%1$@ / %2$lld ਟੈਸਟ</string>
		</dict>
	</dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਅੱਖਰ</string>
			<key>other</key>
			<string>%lld ਅੱਖਰ</string>
		</dict>
	</dict>
	<key>%lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਡਿਵਾਈਸ</string>
			<key>other</key>
			<string>%lld ਡਿਵਾਈਸਾਂ</string>
		</dict>
	</dict>
	<key>%lld errors</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਗਲਤੀ</string>
			<key>other</key>
			<string>%lld ਗਲਤੀਆਂ</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਫਾਈਲ</string>
			<key>other</key>
			<string>%lld ਫਾਈਲਾਂ</string>
		</dict>
	</dict>
	<key>%lld hidden files also match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਲੁਕੀ ਫਾਈਲ ਵੀ ਮਿਲਦੀ ਹੈ</string>
			<key>other</key>
			<string>%lld ਲੁਕੀਆਂ ਫਾਈਲਾਂ ਵੀ ਮਿਲਦੀਆਂ ਹਨ</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਆਈਟਮ</string>
			<key>other</key>
			<string>%lld ਆਈਟਮਾਂ</string>
		</dict>
	</dict>
	<key>%lld lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਲਾਈਨ</string>
			<key>other</key>
			<string>%lld ਲਾਈਨਾਂ</string>
		</dict>
	</dict>
	<key>%lld matches</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਮੈਚ</string>
			<key>other</key>
			<string>%lld ਮੈਚ</string>
		</dict>
	</dict>
	<key>%lld more places: ⌘-click to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਹੋਰ ਥਾਂ: ਇਸਨੂੰ ਦੇਖਣ ਲਈ ⌘-click ਕਰੋ।</string>
			<key>other</key>
			<string>%lld ਹੋਰ ਥਾਂਵਾਂ: ਸਭ ਦੇਖਣ ਲਈ ⌘-click ਕਰੋ।</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਪੈਕੇਜ</string>
			<key>other</key>
			<string>%lld ਪੈਕੇਜ</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਥਾਂ `%@` ਦਾ ਐਲਾਨ ਕਰਦੀ ਹੈ: ⌘-click ਛਾਲ ਮਾਰਨ ਦੀ ਬਜਾਏ ਇਹ ਮੀਨੂ ਦਿਖਾਉਂਦਾ ਹੈ।</string>
			<key>other</key>
			<string>%lld ਥਾਂਵਾਂ `%@` ਦਾ ਐਲਾਨ ਕਰਦੀਆਂ ਹਨ: ⌘-click ਛਾਲ ਮਾਰਨ ਦੀ ਬਜਾਏ ਇਹ ਮੀਨੂ ਦਿਖਾਉਂਦਾ ਹੈ।</string>
		</dict>
	</dict>
	<key>%lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਪ੍ਰੋਜੈਕਟ</string>
			<key>other</key>
			<string>%lld ਪ੍ਰੋਜੈਕਟ</string>
		</dict>
	</dict>
	<key>%lld spaces</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਸਪੇਸ</string>
			<key>other</key>
			<string>%lld ਸਪੇਸ</string>
		</dict>
	</dict>
	<key>%lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਟੈਸਟ</string>
			<key>other</key>
			<string>%lld ਟੈਸਟ</string>
		</dict>
	</dict>
	<key>%lld warnings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਚੇਤਾਵਨੀ</string>
			<key>other</key>
			<string>%lld ਚੇਤਾਵਨੀਆਂ</string>
		</dict>
	</dict>
	<key>Closes all %lld tabs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਟੈਬ ਬੰਦ ਕਰਦਾ ਹੈ।</string>
			<key>other</key>
			<string>ਸਾਰੇ %lld ਟੈਬ ਬੰਦ ਕਰਦਾ ਹੈ।</string>
		</dict>
	</dict>
	<key>Filter %lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਫਿਲਟਰ %lld ਡਿਵਾਈਸ</string>
			<key>other</key>
			<string>ਫਿਲਟਰ %lld ਡਿਵਾਈਸਾਂ</string>
		</dict>
	</dict>
	<key>Filter %lld schemes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਫਿਲਟਰ %lld ਸਕੀਮ</string>
			<key>other</key>
			<string>ਫਿਲਟਰ %lld ਸਕੀਮਾਂ</string>
		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਥਾਂ ਸੂਚੀਬੱਧ ਕਰਦਾ ਹੈ ਜੋ ਪ੍ਰੋਜੈਕਟ ਵਿੱਚ ਲੱਭੋ ਵਿੱਚ %@ ਵਰਤਦੀ ਹੈ।</string>
			<key>other</key>
			<string>%lld ਥਾਂਵਾਂ ਸੂਚੀਬੱਧ ਕਰਦਾ ਹੈ ਜੋ ਪ੍ਰੋਜੈਕਟ ਵਿੱਚ ਲੱਭੋ ਵਿੱਚ %@ ਵਰਤਦੀਆਂ ਹਨ।</string>
		</dict>
	</dict>
</dict>
</plist>
