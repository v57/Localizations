<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ / %lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ / %2$lld పరీక్ష</string>
			<key>other</key>
			<string>%1$@ / %2$lld పరీక్షలు</string>
		</dict>
	</dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld అక్షరం</string>
			<key>other</key>
			<string>%lld అక్షరాలు</string>
		</dict>
	</dict>
	<key>%lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld పరికరం</string>
			<key>other</key>
			<string>%lld పరికరాలు</string>
		</dict>
	</dict>
	<key>%lld errors</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld లోపం</string>
			<key>other</key>
			<string>%lld లోపాలు</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ఫైల్</string>
			<key>other</key>
			<string>%lld ఫైళ్లు</string>
		</dict>
	</dict>
	<key>%lld hidden files also match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld దాచిన ఫైల్ కూడా సరిపోలుతుంది</string>
			<key>other</key>
			<string>%lld దాచిన ఫైళ్లు కూడా సరిపోలుతున్నాయి</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld అంశం</string>
			<key>other</key>
			<string>%lld అంశాలు</string>
		</dict>
	</dict>
	<key>%lld lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld పంక్తి</string>
			<key>other</key>
			<string>%lld పంక్తులు</string>
		</dict>
	</dict>
	<key>%lld matches</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld సరిపోలిక</string>
			<key>other</key>
			<string>%lld సరిపోలికలు</string>
		</dict>
	</dict>
	<key>%lld more places: ⌘-click to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>మరో %lld స్థానం: చూడటానికి ⌘-click చేయండి.</string>
			<key>other</key>
			<string>మరో %lld స్థానాలు: అన్నింటినీ చూడటానికి ⌘-click చేయండి.</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ప్యాకేజీ</string>
			<key>other</key>
			<string>%lld ప్యాకేజీలు</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld స్థానం `%@`ను ప్రకటిస్తుంది: దూకడానికి బదులు ఈ మెనూను చూపడానికి ⌘-click చేయండి.</string>
			<key>other</key>
			<string>%lld స్థానాలు `%@`ను ప్రకటిస్తాయి: దూకడానికి బదులు ఈ మెనూను చూపడానికి ⌘-click చేయండి.</string>
		</dict>
	</dict>
	<key>%lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ప్రాజెక్ట్</string>
			<key>other</key>
			<string>%lld ప్రాజెక్టులు</string>
		</dict>
	</dict>
	<key>%lld spaces</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ఖాళీ</string>
			<key>other</key>
			<string>%lld ఖాళీలు</string>
		</dict>
	</dict>
	<key>%lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld పరీక్ష</string>
			<key>other</key>
			<string>%lld పరీక్షలు</string>
		</dict>
	</dict>
	<key>%lld warnings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld హెచ్చరిక</string>
			<key>other</key>
			<string>%lld హెచ్చరికలు</string>
		</dict>
	</dict>
	<key>Closes all %lld tabs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ట్యాబ్‌ను మూసివేస్తుంది.</string>
			<key>other</key>
			<string>అన్ని %lld ట్యాబ్‌లను మూసివేస్తుంది.</string>
		</dict>
	</dict>
	<key>Filter %lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>వడపోత %lld పరికరం</string>
			<key>other</key>
			<string>వడపోత %lld పరికరాలు</string>
		</dict>
	</dict>
	<key>Filter %lld schemes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>వడపోత %lld స్కీమ్</string>
			<key>other</key>
			<string>వడపోత %lld స్కీమ్‌లు</string>
		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ప్రాజెక్ట్‌లో కనుగొనులో %1$@ను ఉపయోగించే %2$lld స్థానాన్ని జాబితా చేస్తుంది.</string>
			<key>other</key>
			<string>ప్రాజెక్ట్‌లో కనుగొనులో %1$@ను ఉపయోగించే %2$lld స్థానాలను జాబితా చేస్తుంది.</string>
		</dict>
	</dict>
</dict>
</plist>
