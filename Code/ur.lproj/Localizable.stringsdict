	<key>Closes all %lld tabs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ٹیب بند کرتا ہے۔</string>
			<key>other</key>
			<string>تمام %lld ٹیبز بند کرتا ہے۔</string>
		</dict>
	</dict>
	<key>Filter %lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>فلٹر %lld ڈیوائس</string>
			<key>other</key>
			<string>فلٹر %lld ڈیوائسز</string>
		</dict>
	</dict>
	<key>Filter %lld schemes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>فلٹر %lld اسکیم</string>
			<key>other</key>
			<string>فلٹر %lld اسکیمز</string>
		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>پروجیکٹ میں تلاش کریں میں %1$@ استعمال کرنے والی %2$lld جگہ کی فہرست دیتا ہے۔</string>
			<key>other</key>
			<string>پروجیکٹ میں تلاش کریں میں %1$@ استعمال کرنے والی %2$lld جگہوں کی فہرست دیتا ہے۔</string>
		</dict>
	</dict>
</dict>
</plist>
