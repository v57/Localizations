		</dict>
	</dict>
	<key>%lld matches</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld मिलान</string>
			<key>other</key>
			<string>%lld मिलानहरू</string>
		</dict>
	</dict>
	<key>%lld more places: ⌘-click to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>थप %lld स्थान: यसलाई हेर्न ⌘-click गर्नुहोस्।</string>
			<key>other</key>
			<string>थप %lld स्थानहरू: ती सबै हेर्न ⌘-click गर्नुहोस्।</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld प्याकेज</string>
			<key>other</key>
			<string>%lld प्याकेजहरू</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld स्थानले `%@` घोषणा गर्छ: जम्प गर्नुको सट्टा ⌘-click ले यो मेनु देखाउँछ।</string>
			<key>other</key>
			<string>%lld स्थानहरूले `%@` घोषणा गर्छन्: जम्प गर्नुको सट्टा ⌘-click ले यो मेनु देखाउँछ।</string>
		</dict>
	</dict>
	<key>%lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld परियोजना</string>
			<key>other</key>
			<string>%lld परियोजनाहरू</string>
		</dict>
	</dict>
