	<key>%lld hidden files also match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld ملفات مخفية مطابقة أيضًا</string>
			<key>many</key>
			<string>%lld ملف مخفي مطابق أيضًا</string>
			<key>one</key>
			<string>ملف مخفي واحد مطابق أيضًا</string>
			<key>other</key>
			<string>%lld ملف مخفي مطابق أيضًا</string>
			<key>two</key>
			<string>ملفان مخفيان مطابقان أيضًا</string>
			<key>zero</key>
			<string>لا ملفات مخفية مطابقة أيضًا</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld عناصر</string>
			<key>many</key>
			<string>%lld عنصر</string>
			<key>one</key>
			<string>عنصر واحد</string>
			<key>other</key>
			<string>%lld عنصر</string>
			<key>two</key>
			<string>عنصران</string>
