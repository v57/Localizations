			<key>other</key>
			<string>%lld سطر</string>
			<key>two</key>
			<string>سطران</string>
			<key>zero</key>
			<string>لا سطور</string>
		</dict>
	</dict>
	<key>%lld matches</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld مطابقات</string>
			<key>many</key>
			<string>%lld مطابقة</string>
			<key>one</key>
			<string>مطابقة واحدة</string>
			<key>other</key>
			<string>%lld مطابقة</string>
			<key>two</key>
			<string>مطابقتان</string>
			<key>zero</key>
			<string>لا مطابقات</string>
		</dict>
	</dict>
	<key>%lld more places: ⌘-click to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld مواضع أخرى: ⌘-click لرؤيتها كلها.</string>
			<key>many</key>
			<string>%lld موضعًا آخر: ⌘-click لرؤيتها كلها.</string>
			<key>one</key>
			<string>موضع واحد آخر: ⌘-click لرؤيته.</string>
			<key>other</key>
			<string>%lld موضع آخر: ⌘-click لرؤيتها كلها.</string>
			<key>two</key>
			<string>موضعان آخران: ⌘-click لرؤيتهما.</string>
			<key>zero</key>
			<string>لا مواضع أخرى: ⌘-click لرؤيتها.</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld حزم</string>
			<key>many</key>
			<string>%lld حزمة</string>
			<key>one</key>
			<string>حزمة واحدة</string>
			<key>other</key>
			<string>%lld حزمة</string>
			<key>two</key>
			<string>حزمتان</string>
			<key>zero</key>
			<string>لا حزم</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld مواضع تعرّف `%@`: ⌘-click يعرض هذه القائمة بدل الانتقال.</string>
			<key>many</key>
			<string>%lld موضعًا يعرّف `%@`: ⌘-click يعرض هذه القائمة بدل الانتقال.</string>
			<key>one</key>
			<string>موضع واحد يعرّف `%@`: ⌘-click يعرض هذه القائمة بدل الانتقال.</string>
			<key>other</key>
			<string>%lld موضع يعرّف `%@`: ⌘-click يعرض هذه القائمة بدل الانتقال.</string>
			<key>two</key>
			<string>موضعان يعرّفان `%@`: ⌘-click يعرض هذه القائمة بدل الانتقال.</string>
			<key>zero</key>
			<string>لا مواضع تعرّف `%@`: ⌘-click يعرض هذه القائمة بدل الانتقال.</string>
		</dict>
	</dict>
