<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ / %lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ / %2$lld ޓެސްޓް</string>
			<key>other</key>
			<string>%1$@ / %2$lld ޓެސްޓްތައް</string>
		</dict>
	</dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ކެރެކްޓަރ</string>
			<key>other</key>
			<string>%lld ކެރެކްޓަރތައް</string>
		</dict>
	</dict>
	<key>%lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ޑިވައިސް</string>
			<key>other</key>
			<string>%lld ޑިވައިސްތައް</string>
		</dict>
	</dict>
	<key>%lld errors</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld އެރަރ</string>
			<key>other</key>
			<string>%lld އެރަރތައް</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ފައިލް</string>
			<key>other</key>
			<string>%lld ފައިލްތައް</string>
		</dict>
	</dict>
	<key>%lld hidden files also match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ފޮރުވާފައިވާ ފައިލްވެސް މެޗްވޭ</string>
			<key>other</key>
			<string>%lld ފޮރުވާފައިވާ ފައިލްތަކަށްވެސް މެޗްވޭ</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld އައިޓަމް</string>
			<key>other</key>
			<string>%lld އައިޓަމްތައް</string>
		</dict>
	</dict>
	<key>%lld lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ލައިން</string>
			<key>other</key>
			<string>%lld ލައިންތައް</string>
		</dict>
	</dict>
	<key>%lld matches</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld މެޗް</string>
			<key>other</key>
			<string>%lld މެޗްތައް</string>
		</dict>
	</dict>
	<key>%lld more places: ⌘-click to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld އިތުރު ތަން: ދެކެލުމަށް ⌘-click ކުރާ.</string>
			<key>other</key>
			<string>%lld އިތުރު ތަންތަން: ހުރިހާ ދެކެލުމަށް ⌘-click ކުރާ.</string>
		</dict>
	</dict>
	<key>%lld packages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ޕެކޭޖް</string>
			<key>other</key>
			<string>%lld ޕެކޭޖްތައް</string>
		</dict>
	</dict>
	<key>%lld places declare `%@`: ⌘-click shows this menu instead of jumping.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ތަން `%@` ޑިކްލެއަރކުރާ: ޖަމްޕްކުރުމުގެ ބަދަލުގައި މި މެނޫ ދައްކަން ⌘-click ކުރާ.</string>
			<key>other</key>
			<string>%lld ތަންތަން `%@` ޑިކްލެއަރކުރާ: ޖަމްޕްކުރުމުގެ ބަދަލުގައި މި މެނޫ ދައްކަން ⌘-click ކުރާ.</string>
		</dict>
	</dict>
	<key>%lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ޕްރޮޖެކްޓް</string>
			<key>other</key>
			<string>%lld ޕްރޮޖެކްޓްތައް</string>
		</dict>
	</dict>
	<key>%lld spaces</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ސްޕޭސް</string>
			<key>other</key>
			<string>%lld ސްޕޭސް</string>
		</dict>
	</dict>
	<key>%lld tests</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ޓެސްޓް</string>
			<key>other</key>
			<string>%lld ޓެސްޓްތައް</string>
		</dict>
	</dict>
	<key>%lld warnings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ވޯނިންގ</string>
			<key>other</key>
			<string>%lld ވޯނިންގތައް</string>
		</dict>
	</dict>
	<key>Closes all %lld tabs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ޓެބް ބަންދުކުރާ.</string>
			<key>other</key>
			<string>ހުރިހާ %lld ޓެބް ބަންދުކުރާ.</string>
		</dict>
	</dict>
	<key>Filter %lld devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ފިލްޓަރ %lld ޑިވައިސް</string>
			<key>other</key>
			<string>ފިލްޓަރ %lld ޑިވައިސްތައް</string>
		</dict>
	</dict>
	<key>Filter %lld schemes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ފިލްޓަރ %lld ސްކީމް</string>
			<key>other</key>
			<string>ފިލްޓަރ %lld ސްކީމްތައް</string>
		</dict>
	</dict>
	<key>Lists the %lld places that use %@ in Find in Project.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ޕްރޮޖެކްޓުގައި ހޯދާ ގައި %1$@ ބޭނުންކުރާ %2$lld ތަން ލިސްޓްކުރާ.</string>
			<key>other</key>
			<string>ޕްރޮޖެކްޓުގައި ހޯދާ ގައި %1$@ ބޭނުންކުރާ %2$lld ތަންތަން ލިސްޓްކުރާ.</string>
		</dict>
	</dict>
</dict>
</plist>
