			<string>%lld箇所で`%@`が宣言されています。⌘クリックするとジャンプする代わりにこのメニューが表示されます。</string>
		</dict>
	</dict>
	<key>%lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
