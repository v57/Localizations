<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Cancel</key>
	<string>ரத்துசெய்</string>
	<key>Continue on GitHub</key>
	<string>GitHub இல் தொடரவும்</string>
	<key>Copy Code</key>
	<string>குறியீட்டை நகலெடுக</string>
	<key>Couldn’t sign in</key>
	<string>உள்நுழைய முடியவில்லை</string>
	<key>Done</key>
	<string>முடிந்தது</string>
	<key>Expires in %lld:%@</key>
	<string>%lld:%@ இல் காலாவதியாகிறது</string>
	<key>GitHub granted less than %@ asked for</key>
	<string>%@ கேட்டதை விட GitHub குறைவாக வழங்கியது</string>
	<key>List your organizations and publish repositories to them.</key>
	<string>உங்கள் நிறுவனங்களைப் பட்டியலிட்டு அவற்றில் களஞ்சியங்களை வெளியிடுக.</string>
	<key>Not granted: %@. %@ asks again when something needs it.</key>
	<string>வழங்கப்படவில்லை: %@. ஏதாவது தேவைப்படும்போது %@ மீண்டும் கேட்கும்.</string>
	<key>Open GitHub Again</key>
	<string>GitHub ஐ மீண்டும் திறக்கவும்</string>
	<key>Organizations</key>
	<string>நிறுவனங்கள்</string>
	<key>Private repositories</key>
	<string>தனிப்பட்ட களஞ்சியங்கள்</string>
	<key>Push changes to GitHub Actions files in .github/workflows.</key>
	<string>.github/workflows இல் GitHub Actions கோப்புகளுக்கு மாற்றங்களைப் பதிவேற்றுக.</string>
	<key>Read and write every repository you can access.</key>
	<string>நீங்கள் அணுகக்கூடிய ஒவ்வொரு களஞ்சியத்தையும் படித்து எழுதுக.</string>
	<key>Requests </key>
	<string>கோரிக்கைகள் </string>
	<key>Sign-in was declined</key>
	<string>உள்நுழைவு நிராகரிக்கப்பட்டது</string>
	<key>Signed in on %@</key>
	<string>%@ இல் உள்நுழைந்துள்ளது</string>
	<key>Signed in on another account</key>
	<string>வேறு கணக்கில் உள்நுழைந்துள்ளது</string>
	<key>The code expired</key>
	<string>குறியீடு காலாவதானது</string>
	<key>Try Again</key>
	<string>மீண்டும் முயல்க</string>
	<key>Use</key>
	<string>பயன்படுத்துக</string>
	<key>Waiting for you to approve %@ on GitHub…</key>
	<string>GitHub இல் %@ ஐ அங்கீகரிக்க உங்களுக்காகக் காத்திருக்கிறது…</string>
	<key>Workflows</key>
	<string>பணிப்பாய்வுகள்</string>
